#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;


void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 20;

	message m;
	m.p_target = self;
	m.message_id = EM_NOTIFY;
	m.lparam =  1;
	scene.PostMessage(m);	

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param == 1)
	{
	lastanimation = self->CreateSkeletonAnimation("cb2_a_prelud.EZA", 1);
	nextanimation = 1;
	
	WriteLog("Create OK");

	}
	else if(param == 2)
	{
	lastanimation = self->CreateSkeletonAnimation("cb2_a_postlud.EZA", 1);
	nextanimation = 3;
	
	WriteLog("Create OK");

	}
	else
	{
		if(nextanimation == 1)
		{
			//разговор с волшебницей
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);
			
			p_obj = CreateGameObject(1,"magic_bar_dialog.scv", position, size);
			
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);
			
			scene.Add(p_obj, 2);
			nextanimation = 2;
			return;
		}

	}


}
