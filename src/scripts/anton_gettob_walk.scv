#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;

bool zhizh = false;
int mush = 1;

STREAM * p_stream = NULL;


void ON_DESTROY()
{
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 3;

	//у нас всего одна анимация на вход антона в локацию	
	lastanimation = self->CreateSkeletonAnimation("gb_a_idle.EZA", 1);
	nextanimation = 1;


	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{

	


	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{
	
		if(queststate.typepr != 0)
		{
			if(queststate.typepr == 16 && param == 110)
			{
				//берем грибы
				queststate.item_nuclear_mushrooms = 1;
				GAME_OBJECT * p_item = NULL;
				p_item = scene.FindObjectByName("grib");
				if(p_item != NULL)
				{ 		
				scene.DeleteObject(p_item);
				}
				queststate.typepr = 0;
				scene.SetCursorType(0);
				
				//хвост от крысы уже взят
				if(queststate.item_rat_tail != 0)
					queststate.item_serp = -1;
					
				//скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
		
				queststate.typepr = 0;
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);

				p_obj = CreateGameObject(1,"scetch_grib.scv", position, size);	
				scene.Add(p_obj, 2);
					
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_cat_1.ogg");
				p_stream->Play(false);	
				return;
			}
			if(queststate.typepr != 16 && param == 110)
			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				
				switch (mush)
				{
				case 1:
						p_stream = CreateStream("comment_anton_2.ogg");
						mush = 2;
						break;
				case 2:
						p_stream = CreateStream("comment_anton_4.ogg");
						mush = 3;
						break;
				case 3:
						p_stream = CreateStream("comment_anton_11.ogg");
						mush = 4;
						break;
				case 4:
						p_stream = CreateStream("comment_anton_3.ogg");
						mush = 1;
						break;
				}
				p_stream->Play(false);
				return;
			}			

			if(queststate.typepr == 5 && param == 111)
			{
				queststate.item_piece_of_shit = 2;

									
				//скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
		
				queststate.typepr = 0;
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);

				p_obj = CreateGameObject(1,"scetch_nuclear_shit.scv", position, size);	
				scene.Add(p_obj, 2);

				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_cat_2.ogg");
				p_stream->Play(false);	
				
				return;		
			}
			 
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);
			return;

		}


		//получили предписание пойти

		if(nextanimation < 0)
			return;

		WriteLog("Notify");
		
		if(param == 101)
		{
			nextanimation = -1;
		}
		if(param == 103)
		{
//			WriteLog("going to luk");	
			
			//идем в реактор
			scene.Delete(3);
			scene.Load("reactor02.XML");
			
//			nextanimation = 3;
		}
		if(param == 105)
		{
//			WriteLog("going to gr");
			nextanimation = 5;
		}
		if(param == 109)
		{
//			WriteLog("going to gc");
			nextanimation = -9;
		}
	
		if(param == 111 || param == 110)
		{

		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		
		}
			if(zhizh)
			{
				zhizh = false;
				p_stream = CreateStream("comment_anton_23.ogg");
			}
			else
			{
				zhizh = true;
				p_stream = CreateStream("comment_anton_22.ogg");
			}
			p_stream->Play(false);	
			

		}	
	}
	else
	{
	//	WriteLog("animation finished");
		if(nextanimation == -1)
		{
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"bomj_dialog.scv", position, size);

			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);
			nextanimation = 1;
			return; 
		}
		if(nextanimation == 5)
		{
			lastanimation = self->CreateSkeletonAnimation("gb_a_gb_gr.EZA", 1);
			nextanimation = -5;
			return; 
		}

		if(nextanimation == -5)
		{
			scene.Delete(3);
			scene.Load("getto_rappers.XML");
		}
		if(nextanimation == -9)
		{
			scene.Delete(3);
			scene.Load("getto_center.XML");
		}

		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("gb_a_idle.EZA", 1);
		}

	}

}
