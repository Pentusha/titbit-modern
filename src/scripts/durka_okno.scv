#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{

	
}

void ON_SETFOCUS()
{
	
	scene.SetCursorType(1);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{	

	if(queststate.typepr == 68)	//открываем окно ручкой
	{
		queststate.typepr = 0;
		scene.SetCursorType(0);		
		queststate.item_ruchka = 0;


		vec3_t position, size;	
		GAME_OBJECT * p_skt;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_skt = CreateGameObject(1,"scetch_oknodurka.scv", position, size);		
			
		scene.Add(p_skt, 2);
	}
	
}
