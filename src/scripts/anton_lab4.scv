#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;



void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
}



void ON_CREATE()
{
	//фоновая музыка
	GAME_OBJECT * p_obj;
	
	p_obj = scene.FindObjectByName("sound_back");	
	
	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 18070;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 41;
	
	
	lastanimation = self->CreateSkeletonAnimation("lab4_anton_talk.EZA", 1);
	nextanimation = 1;

	scene.SetCursorType(0);

	Dialog("lab04_dialog.scv");


}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

//		WriteLog("noty");
//		WriteLog(param);
		if(param == 102) // если нажали идти к выходу
		{

//			if(nextanimation == 1)
//			{
				scene.Delete(3);
				scene.Load("Lab02.XML");
//			}
		}
	}
	else
	{

		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("lab4_anton_talk.EZA", 1);
		}

	}
}
