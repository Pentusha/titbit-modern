#include scener
#include queststate

export ON_CREATE;
export ON_TIME;

vec3_t rot;
vec3_t rot2;

int nextanimation;
int lastanimation;

void ON_CREATE()
{
	self->CreateTimer(1, -1);	 
	
	self->GetBoneRotation(0, rot);
	rot2 = rot;
	
	rot2.x += 180;

}

void ON_TIME(int timernum)
{	
	
	int dtime;	
//	float delta;

	dtime = scene.GetTime();
	
	dtime = dtime % 750;
	dtime = dtime / 150;

	
	if(dtime == 1)
	{
		self->SetBoneRotation(0, rot);	
	}	
	else
	{
		self->SetBoneRotation(0, rot2);	
	}
		

}

