#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_DESTROY;

int dialognum = 1;



STREAM * p_stream = NULL;

void ON_DESTROY()
{

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
}


void ON_SETFOCUS()
{
	scene.SetCursorType(2);	
		
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{

	if(queststate.typepr !=0)
	{
		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
		p_stream = CreateStream("comment_anton_2.ogg");
		p_stream->Play(false);	
		return;
	}		

	
	vec3_t position, size, uvposition, uvsize;	
	GAME_OBJECT * p_obj;

	position.Assign(0,0, -80);
	size.Assign(1024,768,0);
	uvposition.Assign(0,1,0);
	uvsize.Assign(1,-1,0);
	scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "monitor_mega.jpg", "close.scv");


}

