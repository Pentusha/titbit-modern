#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{

}

void ON_SETFOCUS()
{
	if (queststate.quest_spoil_city == 3)
	{
		scene.SetCursorType(6);
	}
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	if (queststate.quest_spoil_city == 3)
	{
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 101;
		scene.PostMessage(m);
	}
}
