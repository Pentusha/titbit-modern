#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_TIME;



int step = 0;
LINK * p_text = NULL;

void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)
	{	
		p_text->Delete();
		p_text = NULL;
	}	
	
	
	step = step + 1;

if(step == 1) {	p_text = TextWindowCreate("gettocat_cat_11", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(4000,1);

}
if(step == 2) {	p_text = TextWindowCreate("gettocat_anton_12", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(2000,1);

}
if(step == 3) {	p_text = TextWindowCreate("gettocat_cat_13", "font", position,size, 29, 2);				self->Attach(p_text);	
	self->CreateTimer(15000,1);
	}
if(step == 4) {	p_text = TextWindowCreate("gettocat_anton_14", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(2000,1);

}
if(step == 5) {	p_text = TextWindowCreate("gettocat_cat_15", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(3000,1);

}
if(step == 6) {	
p_text = TextWindowCreate("gettocat_anton_16", "font", position,size, 29, 2);			self->Attach(p_text);	
	self->CreateTimer(10000,1);
	
}
if(step == 7) {	p_text = TextWindowCreate("gettocat_cat_17", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(18000,1);

}
if(step == 8) {	p_text = TextWindowCreate("gettocat_anton_18", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(15000,1);

}
if(step == 9) {	p_text = TextWindowCreate("gettocat_cat_19", "font", position,size, 29, 2);				self->Attach(p_text);		
	self->CreateTimer(4500,1);
}
if(step == 10) {	step = -1;	}					
				

	if(step == -1)
	{
		scene.DeleteObject(self); 				
	}					
	
	
}



void ON_TIME(int timernum)
{
	StepDialog();
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	self->CreateTimer(8000,1);


//	StepDialog();	

}


void ON_LBUTTONDOWN()
{
	//StepDialog();		

	scene.DeleteObject(self); 	

	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("anton");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
//		m.lparam = 3010;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

}


