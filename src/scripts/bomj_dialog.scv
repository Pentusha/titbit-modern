#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-51.7,-90,-69.5);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	
	//в зависимости от состояния квеста выбираем какой диалог выводить
	if(queststate.quest_aes_password == 0)
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("gettobomj_bomj_11", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettobomj_bomj_11.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("bomj_rot.EZA", -1);
		}
		if(step == 2)
		{	
			p_text = TextWindowCreate("gettobomj_anton_12", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettobomj_anton_12.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("gettobomj_bomj_13", "font", position,size, 29, 2);
			p_stream = CreateStream("gettobomj_bomj_13.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("bomj_rot.EZA", -1);
		}
		if(step == 4) {	step = -1;	}					
	}
	
	else if(queststate.quest_aes_password == 1)
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("gettobomj_bomj_21", "font", position,size, 29, 2);
			p_stream = CreateStream("gettobomj_bomj_21.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("bomj_rot.EZA", -1);
		}
		if(step == 2)
		{
			p_text = TextWindowCreate("gettobomj_anton_22", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettobomj_anton_22.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	

		}
		if(step == 3)
		{	
			p_text = TextWindowCreate("gettobomj_bomj_23", "font", position,size, 29, 2);
			p_stream = CreateStream("gettobomj_bomj_23.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("bomj_rot.EZA", -1);
		}
		if(step == 4) {	step = -1;	queststate.quest_aes_password = 2;}					
		
	}
	else
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("gettobomj_bomj_11", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettobomj_bomj_11.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("bomj_rot.EZA", -1);
		}
		if(step == 2) {	step = -1;}					
		

	}
	
	
	if(step == -1)
	{
		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign(15.3618,-2.7916,2.9851);
		size.Assign(-79.6684,-8.7858,-1.595);
		camera.PlaceCamera(25, position, size);
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("bomj_idle.EZA", -1);	
		
	}					
	
	
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("bomj");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("bomj_talk.EZA", -1);	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	
	StepDialog();	
	
	
	position.Assign(12.7421,-2.7446,9.8915);
	size.Assign(-83.8048,-22.8081,-2.4095);
	camera.PlaceCamera(10, position, size);	
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

