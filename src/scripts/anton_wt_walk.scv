#include scener
#include queststate

export ON_CREATE;
export ON_DESTROY; 
export ON_NOTIFY; 

int nextanimation;
int lastanimation;


STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;
	queststate.item_plan = -1;
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 14070;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 30;
	
	//спустились от хиппи
	if(queststate.lastlocation == 31 )
	{	
		lastanimation = self->CreateSkeletonAnimation("wt_a_canab_idle.EZA", 1);
		nextanimation = 3;
	}
	//пришли с карты
	else //if(queststate.lastlocation == 34 )
	{	
		lastanimation = self->CreateSkeletonAnimation("wt_a_exit_idle.EZA", 1);
		nextanimation = 1;
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{


	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		if(queststate.typepr != 0)
		{
			if(queststate.typepr == 5 && queststate.item_piece_of_shit == 2 && param == 104)
			{
				GAME_OBJECT * p_item = NULL;

				//используем радиоактивный кусок дерьма на коноплю
				queststate.item_piece_of_shit = -1;
				p_item = scene.FindObjectByName("vodokanal_01Konoplia");	
				message m;
				m.p_target = p_item;
				m.message_id = EM_NOTIFY;
				scene.PostMessage(m); 	

				queststate.typepr = 0;
				scene.SetCursorType(0);		
	
				//кажем скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
	
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);
		
				p_obj = CreateGameObject(1,"scetch_canabis.scv", position, size);	
			
				scene.Add(p_obj, 2);

				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_cat_13.ogg");
				p_stream->Play(false);

										
			}
			else
			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_anton_2.ogg");
				p_stream->Play(false);
				return;
			}
		}

		if(param == 101) // если нажали на выход
		{
			if(nextanimation == 1) nextanimation = -1;	//карта
			if(nextanimation == 3) nextanimation = 4;	//хиппи

		}
		if(param == 102) // если нажали идти на крышу
		{
			if(nextanimation == 1) nextanimation = 2;	//карта
			if(nextanimation == 3) nextanimation = -3;	//хиппи
		}

		if(param == 103) // если разговариваем с Хиппи
		{
			//разговариваем

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"hippi_dialog1.scv", position, size);
	
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);

		}

	
	
	}
	else
	{
		
		//		WriteLog("animation finished");
		
		
		if(nextanimation == -1)
		{
			if(queststate.item_titbit_can == -1)
			{	
				//смотрим что стало с городом
			
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
	
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);
		
				p_obj = CreateGameObject(1,"scetch_lsd_trip.scv", position, size);	
			
				scene.Add(p_obj, 2);
			}
			else
			{
				//выходим на карту
				scene.Delete(3);
				scene.Load("map.XML");
			}
			
		}
		if(nextanimation == -3)
		{	//идем к хиппи			
			scene.Delete(3);
			scene.Load("hippi.XML");
	
		}
				
		
		if(nextanimation ==1)
		{
			lastanimation = self->CreateSkeletonAnimation("wt_a_exit_idle.EZA", 1);
		}
		if(nextanimation ==2)
		{
			lastanimation = self->CreateSkeletonAnimation("wt_a_exit_canab.EZA", 1);
			nextanimation =-3;
		}
		if(nextanimation ==3)
		{
			lastanimation = self->CreateSkeletonAnimation("wt_a_canab_idle.EZA", 1);
		}
		
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("wt_a_canab_exit.EZA", 1);
			nextanimation = -1;
		}
	
	}	
}
