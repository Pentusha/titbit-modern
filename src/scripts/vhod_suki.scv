#include scener

export ON_CREATE;
export ON_TIME;

vec3_t pos;


bool on_off = false;

void ON_CREATE()
{
	//создаем вечный таймер с периодом активации 0 мсек
	self->CreateTimer(0, -1);	
	
	self->GetBoneRotation(0, pos);


}


void ON_TIME(int timernum)
{	

	if(rand() < 6000)
	{
		if(!on_off)
		{
			on_off = true;
			pos.x = pos.x + 180;
			self->SetBoneRotation(0, pos);
			return;
		}
	}
	else
	{
		if(on_off)
		{
			on_off = false;
			pos.x = pos.x - 180;
			self->SetBoneRotation(0, pos);
			return;
		}
	}

		
}

