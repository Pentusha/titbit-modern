#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

export ON_DESTROY; 


STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void ON_CREATE()
{
 	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 5005;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 23;


	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{

	
	if(queststate.typepr == 38 && param == 104)	
	{	//используем монетку на автомате по продаже презервативов

		queststate.item_coin = -1;
		
		queststate.item_condom = 1;
		
		queststate.typepr = 0;
		scene.SetCursorType(0);

		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_get_condom.scv", position, size);	
		scene.Add(p_obj, 2);
	

	
		return;
	}
	else if(queststate.typepr == 45 && param == 105 && queststate.item_tualet_paper == 2)	
	{	//используем бумагу смоченную бензином на горящей свече

		queststate.item_tualet_paper =3;
				
		queststate.typepr = 0;
		scene.SetCursorType(0);

		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_burn_paper.scv", position, size);	
		scene.Add(p_obj, 2);
	

		return;
	}
	else if(queststate.typepr == 100 && queststate.item_coin == 0)	//танцуем перед Янусом
	{
		queststate.item_coin = 1;

		queststate.typepr = 0;
		scene.SetCursorType(0);	

		//показываем скетч танца 			

		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
	
		p_obj = CreateGameObject(1,"scetch_dance_yanus.scv", position, size);	
			
		scene.Add(p_obj, 2);
		return;
		
	}
	else if(queststate.typepr == 52 && param == 106)	//ставим жучок на стол
	{
		queststate.item_listenning_device = -1;

		queststate.typepr = 0;
		scene.SetCursorType(0);	

		//показываем скетч с жучком			

		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
	
		p_obj = CreateGameObject(1,"scetch_zhuchok.scv", position, size);	
			
		scene.Add(p_obj, 2);
		return;

		return;
		
	}	
	//попытались использовать предмет 	
	else if(queststate.typepr != 0)
	{
		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
		p_stream = CreateStream("comment_anton_2.ogg");
		p_stream->Play(false);
		return;
	}

	vec3_t position, size;
	GAME_OBJECT * p_obj;
	GAME_OBJECT * p_marker;

	switch(param)
	{

	case 101:
		//говорим с Янусом
		
		position.Assign(0, 600, -80);
		size.Assign(1024,768,0);
		
		p_obj = CreateGameObject(1,"yanus_dialog.scv", position, size);
		
		position.Assign(512, -216, 0);
		p_obj->SetBoneCenter(0,position);
		scene.Add(p_obj, 2);
		break;

	case 102:
		//выходим 
		scene.Delete(3);
		scene.Load("club_kab01.XML");
		break;
	case 103:
		//берем маркер
		queststate.item_marker = 1;
		p_marker = scene.FindObjectByName("kabinet02marker");
		if(p_marker != 0)
			scene.DeleteObject(p_marker);	

	
		queststate.typepr = 0;
		scene.SetCursorType(0);

		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_marker.scv", position, size);	
		scene.Add(p_obj, 2);
		
		break;

	

	}

}
