#include scener
#include queststate

export ON_CREATE;
export ON_DESTROY; 
export ON_NOTIFY; 


int nextanimation;
int lastanimation;


STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 14100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 31;
	
	
	lastanimation = self->CreateSkeletonAnimation("hip_a_idle2.EZA", 1);
	nextanimation = 1;
	

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{


	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		if(queststate.typepr != 0)
		{

			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_anton_2.ogg");
				p_stream->Play(false);
				return;
			}
		}

		if(param == 101) // если нажали на выход
		{
			if(nextanimation == 1) nextanimation = -1;	//вход
			if(nextanimation == 3) nextanimation = 4;	//хиппи

		}
		if(param == 102) // если нажали идти на Хипппи
		{
			if(nextanimation == 1) nextanimation = 2;	//вход
			if(nextanimation == 3) nextanimation = -3;	//хиппи
		}

	
	}
	else
	{
		
		//		WriteLog("animation finished");
		
		
		if(nextanimation == -1)
		{	//выходим
			scene.Delete(3);
			scene.Load("vodocanal.XML");
		}
		if(nextanimation == -3)
		{	
			//болтаем с Хиппи
			nextanimation = 3;
			//разговариваем

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"hippi_dialog2.scv", position, size);
	
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);

		}
				
		
		if(nextanimation ==1)
		{
			lastanimation = self->CreateSkeletonAnimation("hip_a_idle2.EZA", 1);
		}
		if(nextanimation ==2)
		{
			lastanimation = self->CreateSkeletonAnimation("hip_a_enter.EZA", 1);
			nextanimation =-3;
		}
		if(nextanimation ==3)
		{
			lastanimation = self->CreateSkeletonAnimation("hip_a_idle.EZA", 1);
		}
		
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("hip_a_exit.EZA", 1);
			nextanimation = -1;
		}
	
	}	
}
