#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{


}

void ON_SETFOCUS()
{
	if(queststate.quest_escape_from_durdom == 1)
		scene.SetCursorType(6);
	
}

void ON_KILLFOCUS()
{

	if(queststate.quest_escape_from_durdom == 1)
		scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	if(queststate.quest_escape_from_durdom == 1)
	{	
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;	
		m.lparam = 102;
		scene.PostMessage(m);
	}
}
