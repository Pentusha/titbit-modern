#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_SETFOCUS;
export ON_KILLFOCUS;


void ON_SETFOCUS()
{
	scene.SetCursorType(1);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}


void ON_LBUTTONDOWN()
{
	queststate.typepr = 0;
	scene.SetCursorType(0);
	
	scene.Delete(3);
	scene.Load("gameboom.xml");

}
