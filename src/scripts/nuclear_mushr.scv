#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;



void ON_CREATE()
{
	if(queststate.item_nuclear_mushrooms != 0)
		scene.DeleteObject(self);
}


void ON_SETFOCUS()
{
	scene.SetCursorType(1);	
		
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);	
}

void ON_LBUTTONDOWN()
{
	GAME_OBJECT * p_anton;

	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 110;
	scene.PostMessage(m);

}

