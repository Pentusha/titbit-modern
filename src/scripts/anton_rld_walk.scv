#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

bool usebike = false;

void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
	

}


void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 9;

	nextanimation = 10;
	
	if(queststate.lastlocation == 2) // если пришли из гетто
	{
		lastanimation = self->CreateSkeletonAnimation("rld_a_idle_gc.EZA", 2);
		nextanimation = 10;
	}
	if(queststate.lastlocation == 34) // если приехали на лисапеде
	{
		lastanimation = self->CreateSkeletonAnimation("rld_a_idle_rask.EZA", 2);
		nextanimation = 12;
	}
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		WriteLog("Notify");

		if(param == 110) // если нажали идти в гетто
		{
			if(nextanimation == 10) nextanimation = -10;
			if(nextanimation == 11) nextanimation = 1110;
			if(nextanimation == 12) nextanimation = 1210;
		}	

		if(param == 111) // если нажали идти к Соне
		{
			if(nextanimation == 11) nextanimation = -11;
			if(nextanimation == 10) nextanimation = 1011;
			if(nextanimation == 12) nextanimation = 1211;
		}	

		if(param == 112) // если нажали идти к Раскольникову
		{
			if(nextanimation == 12) nextanimation = -12;
			if(nextanimation == 10) nextanimation = 1012;
			if(nextanimation == 11) nextanimation = 1112;
			usebike = false;
		}
		if(param == 113) // если нажали идти к велосипеду
		{
			if(nextanimation == 12) nextanimation = -12;
			if(nextanimation == 10) nextanimation = 1012;
			if(nextanimation == 11) nextanimation = 1112;
			usebike = true;
		}			
			
	}
	else
	{
		
		WriteLog("animation finished");


		if(nextanimation == -10)
		{
			scene.Delete(3);
			scene.Load("getto_center.XML");
		}
		if(nextanimation == -11)
		{
			// тут приближаем камеру к Соне, мило общаемся		
			Dialog("sonia_dialog1.scv");
			lastanimation = self->CreateSkeletonAnimation("rld_an_sonya_talk.EZA", -1);
			nextanimation = 11;	//помечаем какая анимация должна идти следом за разговором
			return;			
		}
		if(nextanimation == -12)
		{
			if(usebike)
			{
				scene.Delete(3);
				scene.Load("map.XML");

			}
			else
			// тут приближаем камеру к Раскольникову, пиздим о жизни
			{
			Dialog("raskol_dialog.scv");
			}
			self->CreateSkeletonAnimation("rld_a_rask_talk.EZA", 1);
			nextanimation = 12;
			return;
		}

		if(nextanimation == 10) lastanimation = self->CreateSkeletonAnimation("rld_a_idle_gc.EZA", 1);
		if(nextanimation == 11) lastanimation = self->CreateSkeletonAnimation("rld_a_idle_sonia.EZA", 1);
		if(nextanimation == 12) lastanimation = self->CreateSkeletonAnimation("rld_a_idle_rask.EZA", 1);

		if(nextanimation == 1011)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_gc_sonia.EZA", 1);
			nextanimation = -11;
		}
		if(nextanimation == 1012)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_gc_rask.EZA", 1);
			nextanimation = -12;
		}

		if(nextanimation == 1110)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_sonia_gc.EZA", 1);
			nextanimation = -10;
		}
		if(nextanimation == 1112)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_sonia_rask.EZA", 1);
			nextanimation = -12;
		}

		if(nextanimation == 1210)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_rask_gc.EZA", 1);
			nextanimation = -10;
		}
		if(nextanimation == 1211)
		{
			lastanimation = self->CreateSkeletonAnimation("rld_a_rask_sonia.EZA", 1);
			nextanimation = -11;
		}




	}	
}
