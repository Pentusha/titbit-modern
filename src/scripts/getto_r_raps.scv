#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;

LINK * p_obj= NULL;

void ON_CREATE()
{

//	if(queststate.item_money_case == -1)
//		scene.DeleteObject(self);
	
}


void ON_SETFOCUS()
{
	if(queststate.item_money_case == -1)
		return;
	scene.SetCursorType(4);	

}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);	
}

void ON_LBUTTONDOWN()
{
	if(queststate.item_money_case == -1)
		return;

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 114;
	scene.PostMessage(m);

}
