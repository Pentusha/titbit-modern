#include scener

export ON_CREATE;
export ON_NOTIFY;

//фоновая музыка для локаций 

STREAM * p_stream = NULL;

int activesound = 0;

void Play(int newsound)
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
		activesound = 0;
	}
	switch(newsound)
	{
	case 1:
		p_stream = CreateStream("track8-.ogg");
		break;
	case 2:
		p_stream = CreateStream("track1-4sonya.ogg");
		break;
	case 3:
		p_stream = CreateStream("track10-.ogg");
		break;	
	case 4:
		p_stream = CreateStream("track2-.ogg");
		break;	
	case 5:
		p_stream = CreateStream("track17-moe-disco.ogg");
		break;	
	case 6:
		p_stream = CreateStream("track16-.ogg");
		break;	
	case 7:
		p_stream = CreateStream("track20-minus.ogg");
		break;	
	case 8:
		p_stream = CreateStream("track27-minus.ogg");
		break;	
	case 9:
		p_stream = CreateStream("track24-minus.ogg");
		break;	
	case 10:
		p_stream = CreateStream("track5-.ogg");
		break;	
	case 11:
		p_stream = CreateStream("track13-.ogg");
		break;	
	case 12:
		p_stream = CreateStream("track14-.ogg");
		break;	
	case 13:
		p_stream = CreateStream("track11-.ogg");
		break;	
	case 14:
		p_stream = CreateStream("track26-minus.ogg");
		break;	
	case 15:
		p_stream = CreateStream("track_heaven.ogg");
		break;	
	case 16:
		p_stream = CreateStream("track3-psix.ogg");
		break;	
	case 17: 
		p_stream = CreateStream("alert.ogg");
		break;	
	case 18: 
		p_stream = CreateStream("track4-drive.ogg");
		break;	
	case 29: 
		p_stream = CreateStream("track29.ogg");
		break;	
	
	}
	if(p_stream != NULL)
	{
		p_stream->Play(true);
		activesound = newsound;

	}
}


void ON_CREATE()
{
//	Play(1);
}

void ON_NOTIFY(int param)
{	
	int sndnum = param / 1000;
	int vol = param % 1000;

	
	if(sndnum != 0 && sndnum != activesound)
	{
		Play(sndnum);
	}
	if(p_stream != 0)
		p_stream->SetVolume(vol);

}


