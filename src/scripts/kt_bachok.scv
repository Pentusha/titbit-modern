#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_DESTROY;

STREAM * p_stream = NULL;

void ON_CREATE()
{


}

void ON_DESTROY()
{
}

void ON_SETFOCUS()
{
	if(queststate.quest_check_bachok != 1)
		scene.SetCursorType(2);
	
}

void ON_KILLFOCUS()
{

	if(queststate.quest_check_bachok != 1)
		scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	if(queststate.quest_escape_from_durdom != 0 && queststate.quest_check_bachok != 1)
	{
		queststate.quest_check_bachok  =  1;
	
		queststate.typepr = 0;
		scene.SetCursorType(0);	

		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_bachok.scv", position, size);	
		scene.Add(p_obj, 2);
	}
}
