#include scener


export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;


void ON_CREATE()
{ 


}

void ON_NOTIFY(int param)
{
	if(param == 1)
	{
	lastanimation = self->CreateSkeletonAnimation("cb2_buller_prelud.EZA", 1);
	nextanimation = 2;
	}
	else
	{
		if(nextanimation == 2)
		{
			//разговор с буллером
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);
			
			p_obj = CreateGameObject(1,"buller_bar_dialog.scv", position, size);
			
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);
			
			scene.Add(p_obj, 2);
			nextanimation = 3;
		}
	}

}
