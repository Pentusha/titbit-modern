#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void StepDialog()
{
	vec3_t position, size;
	bool t_def = true;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	
	if(queststate.quest_talk_magic == 0)
	{

		t_def = false;
	
		if(step == 1) {	p_text = TextWindowCreate("sexpodval_anton_11", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_11.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 2) {	p_text = TextWindowCreate("sexpodval_magic_12", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_12.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 3) {	p_text = TextWindowCreate("sexpodval_anton_13", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_13.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 4) {	p_text = TextWindowCreate("sexpodval_magic_14", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_14.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 5) {	p_text = TextWindowCreate("sexpodval_anton_15", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_15.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 6) {	p_text = TextWindowCreate("sexpodval_magic_16", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_16.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 7) {	p_text = TextWindowCreate("sexpodval_anton_17", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_17.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 8) {	step = -1; queststate.quest_talk_magic = 1;}					
	}
	if(queststate.quest_talk_magic == 10 )
	{
		t_def = false;
		if(step == 1) {	p_text = TextWindowCreate("sexpodval_magic_21", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_21.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 2) {	step = -1; queststate.quest_talk_magic = 1;}					

	}

	if(queststate.quest_talk_magic == 1 &&  queststate.item_photocam == 1 && queststate.quest_bring_erotic_fotos == 1)
	{
		t_def = false;	
		if(step == 1) {	p_text = TextWindowCreate("sexpodval_magic_31", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_31.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 2) {	p_text = TextWindowCreate("sexpodval_anton_32", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_32.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 3) {	p_text = TextWindowCreate("sexpodval_magic_33", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_33.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 4) {	p_text = TextWindowCreate("sexpodval_anton_34", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_34.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 5) {	step = -1; queststate.quest_talk_magic = 2; }					
		
	}
	if(queststate.quest_talk_magic == 2 &&  queststate.item_rag_and_gutaline == 1 && queststate.item_leather_cap == 1)
	{

		t_def = false;
		if(step == 1) {	p_text = TextWindowCreate("sexpodval_magic_41", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_41.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 2) {	p_text = TextWindowCreate("sexpodval_anton_42", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_42.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		//кажем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_obj = CreateGameObject(1,"scetch_fetishes.scv", position, size);	
			
		scene.Add(p_obj, 2);
		}	
		if(step == 3) {	p_text = TextWindowCreate("sexpodval_magic_43", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_43.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 4) 
{	step = -1; queststate.quest_talk_magic = 3;

		//кажем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_obj = CreateGameObject(1,"scetch_erotic_fotos.scv", position, size);	
			
		scene.Add(p_obj, 2);
	
		queststate.item_rag_and_gutaline = -1;
		queststate.item_leather_cap = -1;
		queststate.item_photocam = -1;
		}					

	}	
	
	if(queststate.quest_aes_password == 3 && queststate.item_gun == 2)
	{	t_def = false;
	if(step == 1) {	p_text = TextWindowCreate("sexpodval_anton_51", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_51.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
	if(step == 2) {	p_text = TextWindowCreate("sexpodval_magic_52", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_52.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
	if(step == 3) {	p_text = TextWindowCreate("sexpodval_anton_53", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_anton_53.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);	

		//кажем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_obj = CreateGameObject(1,"scetch_mortal_combat.scv", position, size);	
			
		scene.Add(p_obj, 2);

		//задаем анимацию на булера и волшебницу
		GAME_OBJECT * p_npers;
		LINK * p_lobj;
		ANILINK* p_ani;
		
		p_lobj = scene.FindObjectByName("buller");
		p_ani = p_lobj->GetAniLink();
		p_npers =  p_lobj;
		if(p_ani != NULL)
		p_ani->Delete();
		p_npers->CreateSkeletonAnimation("buller_lay.EZA", -1);	

	}
	if(step == 4) {	step = -1; queststate.quest_aes_password = 4; queststate.item_gun = 1; }					
	}

	if(t_def)
	{

		if(step == 1) {	p_text = TextWindowCreate("sexpodval_magic_31", "font", position,size, 29, 2);	p_stream = CreateStream("sexpodval_magic_31.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("vol_podval_rot.EZA", -1);	
}
		if(step == 2) {	step = -1;	}			
	}
	


	if(step == -1)
	{
		//фоновая музыка
		GAME_OBJECT * p_snd;
	 
		p_snd = scene.FindObjectByName("sound_back");	
	
		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}


		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		
		position.Assign(0.3052,-0.8819,-3.0505);
		size.Assign(-87.4575,10.4899,0.4632);
		camera.PlaceCamera(41.6, position, size);

		
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		if(queststate.quest_aes_password < 4)
			p_pers->CreateSkeletonAnimation("vol_podval_idle.EZA", -1);
		else
			p_pers->CreateSkeletonAnimation("magic_lay.EZA", -1);	
			
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	

	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 20;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("magic");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("vol_podval_talk.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	

	StepDialog();	
	
	position.Assign(0.158,-1.5696,-1.81);
	size.Assign(-76.1973,11.9064,2.9016);
	camera.PlaceCamera(16, position, size);

	
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

