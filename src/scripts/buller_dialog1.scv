#include scener

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;


void StepDialog()
{
	vec3_t position, size;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	if(p_text != NULL)	
		p_text->Delete();

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

		
	step = step + 1;



if(step == 1) {	p_text = TextWindowCreate("clubbar_buller_21", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_buller_21.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 2) {	p_text = TextWindowCreate("clubbar_anton_22", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_anton_22.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 3) {	p_text = TextWindowCreate("clubbar_buller_23", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_buller_23.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 4) {	p_text = TextWindowCreate("clubbar_anton_24", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_anton_24.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 5) {	p_text = TextWindowCreate("clubbar_buller_25", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_buller_25.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 6) {	p_text = TextWindowCreate("clubbar_anton_26", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_anton_26.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 7) {	p_text = TextWindowCreate("clubbar_anton_27", "font", position,size, 29, 2);	p_stream = CreateStream("clubbar_anton_27.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 8) {	scene.DeleteObject(self);	}					
				
				
				
				
					



}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);

	

	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);

	StepDialog();	

}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

