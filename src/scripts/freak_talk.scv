#include scener
#include queststate


export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;
export ON_TIME;

STREAM * p_stream = NULL;

void ON_TIME(int timernum)
{
	p_stream->Play(false);
	p_stream->SetSync(0, self); 
	self->CreateSkeletonAnimation("freak_talk.eza", -1);
//	self->CreateSkeletonAnimation("freak_rot.eza", -1);

	vec3_t position, size;	
	GAME_OBJECT * p_obj;
	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,"psix_dialog.scv", position, size);
	
	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);

	

}
void ON_DESTROY()
{
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

	//фоновая музыка
	GAME_OBJECT * p_snd;
	
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 100;
		m.p_target = p_snd;
		scene.PostMessage(m);
		
	}

}


void ON_NOTIFY(int param)
{
	scene.DeleteObject(self);
	GAME_OBJECT * p_nurse;


	p_nurse = scene.FindObjectByName("nurse");
	message m;
	m.p_target = p_nurse;
	m.message_id = EM_NOTIFY;
	scene.PostMessage(m);

}

void ON_CREATE()
{
	//фоновая музыка
	GAME_OBJECT * p_snd;
	
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 16015;
		m.p_target = p_snd;
		scene.PostMessage(m);
		
	}

	p_stream = CreateStream("psix.ogg");	


	self->CreateTimer(0, 1);

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 16;



}
