#include scener

export ON_CREATE;
export ON_DESTROY;


STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_CREATE()
{
	
	p_stream = CreateStream("track8-.ogg");
	if(p_stream != NULL)
		p_stream->Play(true);
	
}

