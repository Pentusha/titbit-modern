#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 1;
	
	if(queststate.lastlocation == 6) // если пришли из подъезда
	{
		lastanimation = self->CreateSkeletonAnimation("gr_an_idle_pod.EZA", 2);
		nextanimation = 15;
	}
	if(queststate.lastlocation == 2) // если пришли из гетто-центра
	{
		lastanimation = self->CreateSkeletonAnimation("gr_an_idle_gc.EZA", 2);
		nextanimation = 13;
	}
	if(queststate.lastlocation == 3) // если пришли от бомжа
	{
		lastanimation = self->CreateSkeletonAnimation("gr_an_idle_gb.EZA", 2);
		nextanimation = 16;
	}
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		WriteLog("Notify");

		if(param == 116) // если нажали идти к бомжу
		{
			if(nextanimation == 16) nextanimation = -16;
			if(nextanimation == 13) nextanimation = 1316;
			if(nextanimation == 14) nextanimation = 1416;
			if(nextanimation == 15) nextanimation = 1516;
		}
		if(param == 113) // если нажали идти в геттоцентр
		{
		       	if(nextanimation == 13) nextanimation = -13;
			if(nextanimation == 14) nextanimation = 1413;
			if(nextanimation == 15) nextanimation = 1513;
			if(nextanimation == 16) nextanimation = 1613;
		}
		if(param == 115) // если нажали идти в подъезд
		{
		       	if(nextanimation == 15) nextanimation = -15;
			if(nextanimation == 13) nextanimation = 1315;
			if(nextanimation == 14) nextanimation = 1415;
			if(nextanimation == 16) nextanimation = 1615;
		}
		if(param == 114) // если нажали идти к реперам
		{
		       	if(nextanimation == 14) nextanimation = -14;
			if(nextanimation == 13) nextanimation = 1314;
			if(nextanimation == 15) nextanimation = 1514;
			if(nextanimation == 16) nextanimation = 1614;
		}
	}
	else
	{
		
		WriteLog("animation finished");


		if(nextanimation == -16)
		{
			scene.Delete(3);
			scene.Load("getto_bomj_n.XML");
		}
		if(nextanimation == -13)
		{
			scene.Delete(3);
			scene.Load("getto_center_n.XML");
		}
		if(nextanimation == -15)
		{
			scene.Delete(3);
			scene.Load("podjezd_n.XML");
		}
		if(nextanimation == -14)
		{
			// общаемся с реперами
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);
			
			p_obj = CreateGameObject(1,"rapper_dialog.scv", position, size);
			
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);
			scene.Add(p_obj, 2);
	
			nextanimation = 14;			
//			return;
		}

		if(nextanimation == 13) lastanimation = self->CreateSkeletonAnimation("gr_an_idle_gc.EZA", 1);
		if(nextanimation == 14) lastanimation = self->CreateSkeletonAnimation("gr_an_idle_rap.EZA", 1);
		if(nextanimation == 15) lastanimation = self->CreateSkeletonAnimation("gr_an_idle_pod.EZA", 1);
		if(nextanimation == 16) lastanimation = self->CreateSkeletonAnimation("gr_an_idle_gb.EZA", 1);

		////////////////////////////////
		if(nextanimation == 1314)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gc_rap.EZA", 1);
			nextanimation = -14;
		}
		if(nextanimation == 1315)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gc_pod.EZA", 1);
			nextanimation = -15;
		}
		if(nextanimation == 1316)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gc_gb.EZA", 1);
			nextanimation = -16;
		}

		////////////////////////////////
		if(nextanimation == 1413)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_rap_gc.EZA", 1);
			nextanimation = -13;
		}
		if(nextanimation == 1415)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_rap_pod.EZA", 1);
			nextanimation = -15;
		}
		if(nextanimation == 1416)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_rap_gb.EZA", 1);
			nextanimation = -16;
		}

		////////////////////////////////
		if(nextanimation == 1513)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_pod_gc.EZA", 1);
			nextanimation = -13;
		}
		if(nextanimation == 1514)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_pod_rap.EZA", 1);
			nextanimation = -14;
		}
		if(nextanimation == 1516)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_pod_gb.EZA", 1);
			nextanimation = -16;
		}

		////////////////////////////////

		if(nextanimation == 1613)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gb_gc.EZA", 1);
			nextanimation = -13;
		}
		if(nextanimation == 1614)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gb_rap.EZA", 1);
			nextanimation = -14;
		}
		if(nextanimation == 1615)
		{
			lastanimation = self->CreateSkeletonAnimation("gr_an_gb_pod.EZA", 1);
			nextanimation = -15;
		}

	}	
}
