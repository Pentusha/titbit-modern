#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	
	if(queststate.quest_get_wear == false)	//до тех пор пока не получил одежду
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("gettoraps_rapper_11", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettoraps_rapper_11.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);	
	
		}
		if(step == 2) {	step = -1;	}			
		
	}
	else if(queststate.quest_reppers_frend == 1)	//после того как Антон станцевал перед репперами 
	{
		
		if(step == 1)
		{
			p_text = TextWindowCreate("gettoraps_rapper_21", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettoraps_rapper_21.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);		
		}
		if(step == 2) 
		{
			queststate.quest_reppers_frend = 2;	//Антон вошел в доверие к репперам
			step = -1;	
		}					
		

	}

	else if(queststate.quest_aes_password < 2 && queststate.quest_get_wear == true)
	{
		if(step == 1)
		{
			p_text = TextWindowCreate("gettoraps_rapper_31", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_31.ogg");	p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 2) {	p_text = TextWindowCreate("gettoraps_anton_32", "font", position,size, 29, 2);	p_stream = CreateStream("gettoraps_anton_32.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 3)
		{
			p_text = TextWindowCreate("gettoraps_rapper_33", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_33.ogg");	p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 4) {	p_text = TextWindowCreate("gettoraps_anton_34", "font", position,size, 29, 2);	p_stream = CreateStream("gettoraps_anton_34.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 5)
		{
			p_text = TextWindowCreate("gettoraps_rapper_35", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_35.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 6) {	step = -1;	}					
		
	}

	else if(queststate.quest_aes_password >= 2 && queststate.quest_reppers_frend == 2 && queststate.item_money_case == 0)//был разговор с бомжом
	{
		if(step == 1)
		{
			p_text = TextWindowCreate("gettoraps_rapper_41", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_41.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 2) {	p_text = TextWindowCreate("gettoraps_anton_42", "font", position,size, 29, 2);	p_stream = CreateStream("gettoraps_anton_42.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 3)
		{
			p_text = TextWindowCreate("gettoraps_rapper_43", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_43.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 4) {	step = -1; 
		if(queststate.quest_aes_password < 3) 
			queststate.quest_aes_password = 3;	


}					
	}
	else if(queststate.quest_aes_password == 4 && queststate.item_money_case == 1)	//есть деньги
	{	
		if(step == 1)
		{
			p_text = TextWindowCreate("gettoraps_rapper_51", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_51.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 2) {	
			p_text = TextWindowCreate("gettoraps_anton_52", "font", position,size, 29, 2);	
			p_stream = CreateStream("gettoraps_anton_52.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 3)
		{
			p_text = TextWindowCreate("gettoraps_rapper_53", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_53.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
		if(step == 4) {	
			p_text = TextWindowCreate("gettoraps_anton_54", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_anton_54.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 5)
		{
			p_text = TextWindowCreate("gettoraps_rapper_55", "font", position,size, 29, 2);
			p_stream = CreateStream("gettoraps_rapper_55.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
		}
	if(step == 6) 
	{	p_text = TextWindowCreate("gettoraps_anton_56", "font", position,size, 29, 2);	
	p_stream = CreateStream("gettoraps_anton_56.ogg");	
	p_stream->Play(false);	
	p_stream->SetSync(0, self);	
	self->Attach(p_text);		

		//кажем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_obj = CreateGameObject(1,"scetch_open_luk.scv", position, size);	
			
		scene.Add(p_obj, 2);
	}
	if(step == 7) {	
		step = -1;	
	}					
	}
	else
	{	
	if(step == 1)
	{
		p_text = TextWindowCreate("gettoraps_rapper_51", "font", position,size, 29, 2);
		p_stream = CreateStream("gettoraps_rapper_51.ogg");
		p_stream->Play(false);
		p_stream->SetSync(0, self);
		self->Attach(p_text);
		p_guba = p_pers->CreateSkeletonAnimation("rapper_glavar_rot.EZA", -1);
	}
	if(step == 2) {	step = -1;	}					
	

	}


	
	if(step == -1)
	{
		scene.DeleteObject(self); 

		//фоновая музыка
		GAME_OBJECT * p_snd;
	 
		p_snd = scene.FindObjectByName("sound_back");	
		
		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}


		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		
		position.Assign(9.9251,-1.2471,0.0217);
		size.Assign(-85.8032,-1.0561,-0.0775);
		camera.PlaceCamera(41.2, position, size);
		
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("rapper_glavar_idle.EZA", -1);
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 20;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("glavar");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("rapper_glavar_talk.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	//	queststate.quest_broke_window = true;
	//	queststate.quest_check_bachok = true;
	//	queststate.quest_get_shiva = false;
	
	
	
	StepDialog();	
	
	position.Assign(11.1742,-0.9295,-1.5077);
	size.Assign(-103.2108,28.7878,-6.4497);
	camera.PlaceCamera(20, position, size);
	
	
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

