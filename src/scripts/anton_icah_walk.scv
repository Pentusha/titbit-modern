#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;

STREAM * p_stream = NULL;

void ON_DESTROY()
{

	GAME_OBJECT * p_tape;
	p_tape = scene.FindObjectByName("flash");
	if(p_tape != NULL)
	{ 
		scene.DeleteObject(p_tape);
	}


	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
}

void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
	

}


void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		if(queststate.quest_cut_electric_wire == 1)
		m.lparam = 17100;
		else
		m.lparam = 1060;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}


	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 26;

	nextanimation = 1;
	lastanimation = self->CreateSkeletonAnimation("icah_a_enter.EZA", 1);

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation)
	{
		if (nextanimation < 0) return;

		if(queststate.typepr !=0)
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);	
			return;
		}


		WriteLog("Notify");

		if( param == 101 ) // если нажали на ресивер
		{
			if(nextanimation == 1)
			{
				if(queststate.quest_cut_electric_wire == 1)
				{
				 nextanimation = 2;
				}
				else
				{
					queststate.quest_talk_magic = 10;	
					Dialog("hacker_dialog.scv");
				}
			}
		}
		if( param == 100 ) // нажали на выход
		{
			nextanimation = -1;
		}
		if( param == 102 ) // нажали на Хакера
		{
			nextanimation = -3;
		}
		if( param == 103 ) // нажали на Мегакиллу
		{
			nextanimation = -4;
		}


	}
	else
	{
		if(nextanimation == 1) lastanimation = self->CreateSkeletonAnimation("icah_a_idle.EZA", 1);
		if(nextanimation == 2)
		{	
			lastanimation = self->CreateSkeletonAnimation("icah_a_hacker.EZA", 1);
			nextanimation = -2;
			return;			
		}

		if(nextanimation == -1)
		{
			scene.Delete(3);//удаляем все не интерфейсные объекты
			scene.Load("icafe_admin.XML");
		}
		if(nextanimation == -2)
		{
			// тут берем ресивер.
			// {
				GAME_OBJECT * p_rec;

				p_rec = scene.FindObjectByName("reciver");
				queststate.item_listenning_device = 1;
				queststate.item_reciver = 1;
				scene.DeleteObject(p_rec);

			// }
		
			queststate.typepr = 0;
			scene.SetCursorType(0);
			
			//показываем скетч			

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);
	
			p_obj = CreateGameObject(1,"scetch_reciver.scv", position, size);	
			
			scene.Add(p_obj, 2);
			

			lastanimation = self->CreateSkeletonAnimation("icah_a_idle.EZA", 1);
			nextanimation = 1;	
		}

		if(nextanimation == -3)
		{
			//разговариваем с хакером
			Dialog("hacker_dialog.scv");
			nextanimation = 1;
			lastanimation = self->CreateSkeletonAnimation("icah_a_idle.EZA", 1);	
		}
		if(nextanimation == -4)
		{
			//разговариваем с мегакиллой
			Dialog("mega_dialog.scv");
			nextanimation = 1;
			lastanimation = self->CreateSkeletonAnimation("icah_a_idle.EZA", 1);	
			
		}


	}
}
