#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;



STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 6015;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 8;

	if(queststate.lastlocation == 6)	
		self->CreateSkeletonAnimation("p_pod_a_idle.EZA", -1);

	if(queststate.lastlocation == 10)	
		self->CreateSkeletonAnimation("p_pod_a_idle2.EZA", -1);

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	GAME_OBJECT * p_item = NULL;

	
	switch(param)
	{
	case 101:
		//пытаемся попасть в подвал
		
		scene.Delete(3);//удаляем все не интерфейсные объекты
		scene.Load("sex_podval.XML");
		break;

	case 102:
		//выходим на лестницу

		scene.Delete(3);//удаляем все не интерфейсные объекты
		scene.Load("podjezd.XML");
		break;
	case 103:
		//клей
		queststate.item_clue = 1;
		p_item = scene.FindObjectByName("podezd_klei");


		break;	
	case 104:
		//дерьмо
		queststate.item_piece_of_shit = 1;
		p_item = scene.FindObjectByName("podezd_kal");

		break;

	case 105:
		//перчатка
		queststate.item_rubber_glove = 1;
		p_item = scene.FindObjectByName("podezd_perhatka");
		
		break;
	
	}	
	
	if(p_item != NULL)
	{

		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		if(param == 103)
			p_obj = CreateGameObject(1,"scetch_klei.scv", position, size);	
		if(param == 104)
			p_obj = CreateGameObject(1,"scetch_shit.scv", position, size);	
		if(param == 105)
			p_obj = CreateGameObject(1,"scetch_gloves.scv", position, size);	


		scene.Add(p_obj, 2);
	

		queststate.typepr=0;
		scene.SetCursorType(0); 
		scene.DeleteObject(p_item);
	}

}
