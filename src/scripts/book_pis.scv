#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{
	
}

void ON_SETFOCUS()
{
	scene.SetCursorType(2);
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	//показываем картинку с текстом книги
	vec3_t position, size, uvposition, uvsize;	

	position.Assign(0, 0, -80);
	size.Assign(1024,768,0);		
	uvposition.Assign(0,1,0);
	uvsize.Assign(1,-0.75,0);


	scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "basis_shpions.jpg", "close.scv"); 


}
