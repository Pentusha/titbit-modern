#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)
	{	
		p_text->Delete();
		p_text = NULL;
	}	

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;

	
	if(queststate.item_full_disk == 0 || queststate.quest_talk_dj == 0)
	{	
		if(step == 1) 
		{	
			p_text = TextWindowCreate("clubdancepol_anton_11", "font", position,size, 29, 2);
			p_stream = CreateStream("clubdancepol_anton_11.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 2) 
		{
			p_text = TextWindowCreate("clubdancepol_dj_12", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_dj_12.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("dj_rot.EZA", -1);
		}
		if(step == 3) 
		{
			p_text = TextWindowCreate("clubdancepol_anton_13", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_anton_13.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);
		}
		if(step == 4) 
		{
			p_text = TextWindowCreate("clubdancepol_dj_14", "font", position,size, 29, 2);
			p_stream = CreateStream("clubdancepol_dj_14.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("dj_rot.EZA", -1);
		}
		if(step == 5) 
		{
			p_text = TextWindowCreate("clubdancepol_anton_15", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_anton_15.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 6) 
		{
			p_text = TextWindowCreate("clubdancepol_dj_16", "font", position,size, 29, 2);
			p_stream = CreateStream("clubdancepol_dj_16.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("dj_rot.EZA", -1);
		}
		if(step == 7) {	step = -1; queststate.quest_talk_dj = 1;}					
		
	}	
	else 
	{

		if(step == 1) 
		{
			p_text = TextWindowCreate("clubdancepol_anton_21", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_anton_21.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);		
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("clubdancepol_dj_22_1", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_dj_22_1.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("dj_rot.EZA", -1);
		}
		if(step == 3) 
		{	
		
			//фоновая музыка
			GAME_OBJECT * p_snd;
 
			p_snd = scene.FindObjectByName("sound_back");	

			if(p_snd != NULL)	
			{
				message m;	
				m.message_id = EM_NOTIFY;
				m.lparam = 0;
				m.p_target = p_snd;
				scene.PostMessage(m);
			}


			p_stream = CreateStream("oblaka.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
				
		}
		if(step == 4) 
		{	
			//фоновая музыка
			GAME_OBJECT * p_snd;
 
			p_snd = scene.FindObjectByName("sound_back");	

			if(p_snd != NULL)	
			{
				message m;	
				m.message_id = EM_NOTIFY;
				m.lparam = 25;
				m.p_target = p_snd;
				scene.PostMessage(m);
			}

			p_text = TextWindowCreate("clubdancepol_dj_22", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubdancepol_dj_22.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("dj_rot.EZA", -1);

			//показываем скетч
//			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_plastic_piece.scv", position, size);	
			scene.Add(p_obj, 2);

	
		}
		if(step == 5) {	step = -1; 	queststate.item_plastic = 1;
			queststate.item_full_disk = -1;
		}					

	}
	
	
	
	
	if(step == -1)
	{
		scene.DeleteObject(self); 
		
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 100;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}



		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		
		position.Assign(-3.1536,-1.9691,-1.3455);
		size.Assign(-78.4023,9.2812,1.8958);
		camera.PlaceCamera(41.82, position, size);
		
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("dj_idle.EZA", -1);
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	scene.SetCursorType(0);
	queststate.typepr = 0;

	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	if(queststate.item_plastic != 0)
	{
		scene.DeleteObject(self); 	
		return;
	}
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("dj");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("dj_talk.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	

	
	StepDialog();	
	
	position.Assign(-3.0217,-1.8934,-0.6328);
	size.Assign(-92.6724,16.9537,-0.7798);
	camera.PlaceCamera(8, position, size);
	
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

