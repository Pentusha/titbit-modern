#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	
	if(queststate.item_kruzhka != 31 && queststate.item_id_card == 0 || queststate.quest_talk_nachal == 0)	//пока не приготовили антипохмельный коктель
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("clubwc_anton_11", "font", position,size, 29, 2);
			p_stream = CreateStream("clubwc_anton_11.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
		}
		if(step == 2)
		{	
			p_text = TextWindowCreate("clubwc_nachalnik_12", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_nachalnik_12.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		
		if(step == 3) 
		{	
			p_text = TextWindowCreate("clubwc_anton_13", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_anton_13.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 4) 
		{	
			p_text = TextWindowCreate("clubwc_nachalnik_14", "font", position,size, 29, 2);
			p_stream = CreateStream("clubwc_nachalnik_14.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		if(step == 5) {	step = -1;	queststate.quest_talk_nachal = 1;	}					
		
	}
	if(queststate.item_kruzhka == 31 && queststate.quest_talk_nachal == 1)
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("clubwc_anton_21", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_anton_21.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("clubwc_nachalnik_22", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_nachalnik_22.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("clubwc_anton_23", "font", position,size, 29, 2);
			p_stream = CreateStream("clubwc_anton_23.ogg");	p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
		}
		if(step == 4) 
		{
			p_text = TextWindowCreate("clubwc_nachalnik_24", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_nachalnik_24.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		if(step == 5) {
			p_text = TextWindowCreate("clubwc_anton_25", "font", position,size, 29, 2);	
			p_stream = CreateStream("clubwc_anton_25.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
		}
		if(step == 6) 
		{
			p_text = 
				TextWindowCreate("clubwc_nachalnik_26", "font", position,size, 29, 2);
			p_stream = CreateStream("clubwc_nachalnik_26.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		if(step == 7) {	
			step = -1; 
			queststate.item_kruzhka = -1; //используем кружку 
			queststate.item_id_card =1;	//получаем карту для прохода в офис
		}					
		
	}
	if(queststate.item_kruzhka == -1 && queststate.item_id_card != 0)
	{	

	if(step == 1) 
		{	
			p_text = TextWindowCreate("clubwc_nachalnik_14", "font", position,size, 29, 2);
			p_stream = CreateStream("clubwc_nachalnik_14.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("nach_rot.EZA", -1);	
		}
		if(step == 2) {	step = -1;	}	
	}

	if(step == -1)
	{
		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		
		position.Assign(0.259,-1.1501,-3.5373);
		size.Assign(-91.3037,10.2434,-0.2319);
		camera.PlaceCamera(40.1, position, size);

		
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("nach_idle.EZA", -1);
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("nachalnik");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("nach_talk.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	//	queststate.quest_broke_window = true;
	//	queststate.quest_check_bachok = true;
	//	queststate.quest_get_shiva = false;
	
	
	
	StepDialog();	
	
	position.Assign(0.041,-0.3139,-4.2768);
	size.Assign(-94.6025,9.9644,-0.7981);
	camera.PlaceCamera(6, position, size);	
	

	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

