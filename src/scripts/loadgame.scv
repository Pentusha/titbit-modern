#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS; 
export ON_LBUTTONDOWN;

IFPlane * p_pl;

void ON_CREATE()
{

	LINK * lnk;
	lnk = self;
	p_pl = lnk->GetChild();
	p_pl->transparency = 0;

}



void ON_SETFOCUS()
{
	
	p_pl->transparency = 1;
}

void ON_KILLFOCUS()
{
	p_pl->transparency = 0;

}


void ON_LBUTTONDOWN()
{
	vec3_t position, size, uvposition, uvsize;

//	if (queststate.activelocation==0) return;

/*
	message m;
	m.p_target = scene.FindObjectByName("mainmenu");
	m.message_id = EM_NOTIFY;
	m.lparam = 0;
	scene.PostMessage(m);
*/
	position.Assign(0,0,-204);
	size.Assign(1024,768,0);
	uvposition.Assign(0.613,0.85,0);
	uvsize.Assign(0.382,-0.354,0);
	scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "inter_face.tga", "loaddlg.scv");

}
