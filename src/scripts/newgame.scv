#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS; 
export ON_LBUTTONDOWN;

vec3_t objpos;
IFPlane * p_pl;

void ON_CREATE()
{

	
	self->GetBonePosition(0, objpos);
	LINK * lnk;
	lnk = self;
	p_pl = lnk->GetChild();
	p_pl->transparency = 0;

}



void ON_SETFOCUS()
{
	
	p_pl->transparency = 1;
}

void ON_KILLFOCUS()
{
	p_pl->transparency = 0;

}

void ON_LBUTTONDOWN()
{
	GAME_OBJECT * p_obj;
	vec3_t	pos;
	vec3_t  size;


	scene.Delete(7);//удаляем все объекты

	message m;

	m.p_target = scene.FindObjectByName("mainmenu");
	m.message_id = EM_NOTIFY;
	m.lparam = 0;
	scene.PostMessage(m);
	
	m.p_target = self;
	m.message_id = EM_KILLFOCUS;
	scene.PostMessage(m);
	
	
	if(scene.FindObjectByName("actionmenu") == NULL)
	{

		pos.Assign(-63,10, 0);
		size.Assign(70,630,0);//66
		p_obj = CreateGameObject(1, "items.scv", pos, size);
		scene.Add(p_obj, 2);
	}	


	
	queststate.NewGame();
	queststate.typepr=0;
	scene.SetCursorType(0);

	queststate.activelocation = 9;	



//	scene.Load("sumerki_entrance.XML");

	scene.Load("intro2.XML");


	
}



