#include scener


export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;


void ON_CREATE()
{ 

	message m;
	m.p_target = self;
	m.message_id = EM_NOTIFY;
	m.lparam =  1;
	scene.PostMessage(m);	


}

void ON_NOTIFY(int param)
{
	if(param == 1)
	{
	lastanimation = self->CreateSkeletonAnimation("cb2_magic_prelud.EZA", 1);
	nextanimation = 1;
	}


}
