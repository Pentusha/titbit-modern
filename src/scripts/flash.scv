#include scener

export ON_CREATE;
export ON_TIME;

IFPlane * p_plane;
int start = 0;
int last = 0;

void ON_CREATE()
{
	LINK * p_lnk; 
	//создаем вечный таймер с периодом активации 0 мсек
	self->CreateTimer(0, -1);	
	
	//
	p_lnk = self;

	p_plane = p_lnk->GetChild();	

}


void ON_TIME(int timernum)
{	
	int dtime;	
	float delta;

	dtime = scene.GetTime();
	dtime = dtime - start;
	if(dtime < 500)
	{
	
	delta = dtime;
	delta = 0.4*sin(delta*3.14/500);
	p_plane->transparency = delta;
	
	}
	else
	{
		p_plane->transparency = 0;
		if((rand() < 400))
		{
			start = start + dtime;
			last = last +1;	
			dtime = last%16;
			switch(dtime%4)
			{
			  case 1:
				p_plane->uvorigin.x = 0.25;
				break;
			  case 2:
				p_plane->uvorigin.x = 0.5;
				break;
			  case 3:
				p_plane->uvorigin.x = 0.75;
				break;
			  case 4:
				p_plane->uvorigin.x = 1;
				break;								
			}
			dtime = dtime/4;
			switch(dtime)
			{
			  case 1:
				p_plane->uvorigin.y = 0.25;
				break;
			  case 2:
				p_plane->uvorigin.y = 0.5;
				break;
			  case 3:
				p_plane->uvorigin.y = 0.75;
				break;
			  case 4:
				p_plane->uvorigin.y = 1;
				break;								
			}
									
		}

	}
		
}

