#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

STREAM * p_stream = NULL;

void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
}



void ON_CREATE()
{
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 18060;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 39;
	
	
	lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
	nextanimation = 1;


	if (queststate.item_saw_circul != 0)
	{
			LINK * p_lobj;
			p_lobj = scene.FindObjectByName("gigahertz");
			LINK* p_lnk = p_lobj->GetChild();
			p_lnk->Delete();
	}

	scene.SetCursorType(0);

}

void ON_NOTIFY(int param)
{
	vec3_t position, size;
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{
		if (nextanimation < 0) return;

		if(param == 102) // берем отвертку
		{
			lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
			nextanimation = -2;
		}
		if(param == 103) // берем ножницы
		{
			lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
			nextanimation = -3;
		}
		if(param == 104) // уходим к чемоданчику
		{
			//попытались использовать предмет 	
			if((queststate.quest_atom_chem == 0) && (queststate.typepr != 60))
			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_anton_2.ogg");
				p_stream->Play(false);
				return;
			}
			else
			{
				if ((queststate.quest_atom_chem == 0) && (queststate.typepr == 60)) // пилим чемодан
				{
					queststate.quest_atom_chem = 1;
					queststate.item_saw_circul = -1;
					queststate.typepr = 0;
					scene.SetCursorType(0);
					p_stream = CreateStream("comment_cat_4.ogg");
					p_stream->Play(false);

					//показываем скетч
					GAME_OBJECT * p_objs1;
					queststate.typepr = 0;
					position.Assign(0, 0, -80);	
					size.Assign(1024,768,0);
					p_objs1 = CreateGameObject(1,"scetch_chem_saw.scv", position, size);	
					scene.Add(p_objs1, 2);

					return;
				}
				if ((queststate.quest_atom_chem == 1) && (queststate.typepr == 58)) // вскрываем чемодан
				{
					queststate.quest_atom_chem = 2;
					queststate.item_skrewdriver = -1;
					queststate.typepr = 0;
					scene.SetCursorType(0);

					//показываем скетч
					GAME_OBJECT * p_objs2;
					queststate.typepr = 0;
					position.Assign(0, 0, -80);	
					size.Assign(1024,768,0);
					p_objs2 = CreateGameObject(1,"scetch_chem_skr.scv", position, size);	
					scene.Add(p_objs2, 2);

					return;
				}
				if ((queststate.quest_atom_chem == 2) && (queststate.typepr == 59))
				{
					queststate.quest_atom_chem = 3;
					queststate.typepr = 0;
					scene.SetCursorType(0);
					lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
					nextanimation = 4;
					return;
				}

				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_anton_2.ogg");
				p_stream->Play(false);
				return;

			}
		}
		if(param == 105) // берем пилу
		{
			lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
			nextanimation = -5;
		}
	}
	else
	{
		if(nextanimation == -1)
		{
			scene.Delete(3);
			scene.Load("chemodan.XML");
		}
		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("anton_lab02_idle.EZA", 1);
		}
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("anton_lab02_walk.EZA", 1);
			nextanimation = -1;

					//показываем скетч
					GAME_OBJECT * p_objs3;
					queststate.typepr = 0;
					position.Assign(0, 0, -80);	
					size.Assign(1024,768,0);
					p_objs3 = CreateGameObject(1,"scetch_chem_get.scv", position, size);	
					scene.Add(p_objs3, 2);
		}
	
		if(nextanimation == -2)
		{
			//берем отвертку
			nextanimation = 1;
			queststate.item_skrewdriver = 1;

			GAME_OBJECT * p_plast;
			p_plast = scene.FindObjectByName("lab_02Otvertka");
			scene.DeleteObject(p_plast);	
		
			queststate.typepr = 0;
			scene.SetCursorType(0);	

			//показываем скетч


			GAME_OBJECT * p_objr;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_objr = CreateGameObject(1,"scetch_skrewdriver.scv", position, size);	
			scene.Add(p_objr, 2);
		}

		if(nextanimation == -3)
		{
			//берем ножницы
			nextanimation = 1;
			queststate.item_scissors = 1;	

			GAME_OBJECT * p_plast;
			p_plast = scene.FindObjectByName("lab_02Nognici");
			scene.DeleteObject(p_plast);	
		
			queststate.typepr = 0;
			scene.SetCursorType(0);	

			//показываем скетч

			GAME_OBJECT * p_objn;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_objn = CreateGameObject(1,"scetch_scissor.scv", position, size);	
			scene.Add(p_objn, 2);
		}

		if(nextanimation == -5)
		{
			//берем пилу
			nextanimation = 1;
			queststate.item_saw_circul = 1;	

			LINK * p_lobj;
			p_lobj = scene.FindObjectByName("gigahertz");
	
			LINK* p_lnk = p_lobj->GetChild();
			p_lnk->Delete();
//			p_lnk = p_lobj->GetChild();
//			p_lnk->Delete();


			queststate.typepr = 0;
			scene.SetCursorType(0);	

			//показываем скетч

			GAME_OBJECT * p_objc;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_objc = CreateGameObject(1,"scetch_saw_circul.scv", position, size);	
			scene.Add(p_objc, 2);
		}
	}
}
