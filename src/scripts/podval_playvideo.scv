#include scener
#include queststate

export ON_CREATE;
export ON_TIME;
export ON_LBUTTONDOWN;


int step = 0;


void ON_TIME(int timernum)
{	

	vec3_t position, size;
	scene.DeleteObject(self);

	position.Assign(0.3052,-0.8819,-3.0505);
	size.Assign(-87.4575,10.4899,0.4632);
	camera.PlaceCamera(41.6, position, size);


}

void ON_CREATE()
{

	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	LINK * p_avi;

	position.Assign(420,220,0);
	size.Assign(348,285,0);
	uvposition.Assign(0,1,0);
	uvsize.Assign(1,-1,0);

	if(queststate.item_dance_video != -1)
		p_avi = CreateAVIPlane(position, size, uvposition, uvsize, false, "porno.avi");
	else
		p_avi = CreateAVIPlane(position, size, uvposition, uvsize, false, "dans.avi");

	self->Attach(p_avi);
	position.Assign(0,0,-1);
	size.Assign(1024,768,0);
	uvposition.Assign(0.665,1,0);
	uvsize.Assign(0.334,-0.237,0);

	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "podval_sex.tga", 1);
	self->Attach(p_obj);
	
	self->CreateTimer(7100, -1);

	position.Assign(2000.34,-1.1706,0.6632);
	size.Assign(94.0596,11.8791,-0.8371);
	camera.PlaceCamera(41.2, position, size);
	
}


void ON_LBUTTONDOWN()
{
	ON_TIME(0);

}
