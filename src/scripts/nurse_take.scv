#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 36;	

	//фоновая музыка
	GAME_OBJECT * p_snd;
	
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 16080;
		m.p_target = p_snd;
		scene.PostMessage(m);
		
	}

}

void ON_SETFOCUS()
{
	if(queststate.item_keydurka == 0)
		scene.SetCursorType(3);
	
}

void ON_KILLFOCUS()
{

	if(queststate.item_keydurka == 0)
		scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{	

	if(queststate.item_keydurka == 0)
	{

		queststate.item_keydurka = 1;

		queststate.typepr = 0;
		scene.SetCursorType(0);	

		vec3_t position, size;	
		GAME_OBJECT * p_skt;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		p_skt = CreateGameObject(1,"scetch_keydurka.scv", position, size);		
			
		scene.Add(p_skt, 2);

	}

	
}
