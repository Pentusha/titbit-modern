void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				


	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	position.Assign(0,0,-1);
	size.Assign(1024,400,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("danya");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("danya_talk_02.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	

	
	StepDialog();	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

