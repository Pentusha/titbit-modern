#include scener

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_MOUSEOVER;
LINK * p_link = NULL;

IFPlane * p_pl1;
IFPlane * p_pl2;

void ON_CREATE()
{


	vec3_t position, size, uvposition, uvsize;

	position.Assign(256,288,0);
	size.Assign(512,192,0);
		
	uvposition.Assign(0,0.18755,0);
	uvsize.Assign(0.5,-0.1875,0);
	p_link = CreateIFPlane(position,size,uvposition, uvsize, "inter_face.tga",1);

	self->Attach(p_link);

	position.Assign(256,387.84,0);
	size.Assign(256,92.16,0);

	uvposition.Assign(0.5,0.09,0);
	uvsize.Assign(0.25,-0.09,0);
	p_link = CreateIFPlane(position,size,uvposition, uvsize, "inter_face.tga",1);

	self->Attach(p_link);
	p_pl1 = p_link;

	position.Assign(512,387.84,0);
	size.Assign(256,92.16,0);

	uvposition.Assign(0.75, 0.09, 0);
	uvsize.Assign(0.25,-0.09,0);
	p_link = CreateIFPlane(position,size,uvposition, uvsize, "inter_face.tga",1);

	self->Attach(p_link);
	p_pl2 = p_link;

}

void ON_MOUSEOVER(vec3_t mousepos)
{
	p_pl1->transparency = 0;
	p_pl2->transparency = 0;

	if(mousepos.x > 768 || mousepos.x < 256 || mousepos.y > 480 ||  mousepos.y < 387)
	{
		return;
	}
	else
	{
		if(mousepos.x < 512)
			p_pl1->transparency = 1;
		else
			p_pl2->transparency = 1;
	}

}

void ON_LBUTTONDOWN()
{
	if(p_pl1->transparency == 1)
		CloseApp();
	if(p_pl2->transparency == 1)
		scene.DeleteObject(self);
}


