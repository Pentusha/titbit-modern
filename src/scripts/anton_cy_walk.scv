#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY; 


int nextanimation;
int lastanimation;

bool	takecal = false;



STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_CREATE()
{ 

	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 5005;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 22;
	
	if(queststate.lastlocation == 23)
	{	
		lastanimation = self->CreateSkeletonAnimation("cy_a_table_idle.EZA", 2);
		nextanimation = 5;
	}
	else
	{
		lastanimation = self->CreateSkeletonAnimation("cy_a_exit_idle.EZA", 2);
		nextanimation = 1;	
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{




	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		//попытались использовать предмет 	
		if(queststate.typepr != 0 && queststate.typepr != 45 && queststate.item_tualet_paper != 3)
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);
			return;
		}


		if (nextanimation < 0) return;

		if(param == 101) // если нажали на выход
		{
			if(nextanimation == 1) nextanimation = -1;	//выход
			if(nextanimation == 5) nextanimation = 2;	//стол
			if(nextanimation == 9) nextanimation = 3;	//ящики

		}
		if(param == 102) // если нажали идти на стол
		{
			if(nextanimation == 1) nextanimation = 4;	//выход
			if(nextanimation == 5) nextanimation = -5;	//стол
			if(nextanimation == 9) nextanimation = 6;	//ящики

		}
		if(param == 103)// если нажали идти на ящики
		{	
			//нам это интересно если в руках рулон горящей туалетной бумаги
			if(queststate.typepr == 45 && queststate.item_tualet_paper == 3)
			{
				takecal = false;
				if(nextanimation == 1) nextanimation = -9;//7;	//выход
				if(nextanimation == 5) nextanimation = -9;//8;	//стол
				if(nextanimation == 9) nextanimation = -9;	//ящики
			}

		}
		
		if(param == 104)// если нажали идти на календарик
		{
			takecal = true;
			if(nextanimation == 1) nextanimation = 7;	//выход
			if(nextanimation == 5) nextanimation = 8;	//стол
			if(nextanimation == 9) nextanimation = -9;	//ящики

		}

	}
	else
	{
		
		
		if(nextanimation == -1)
		{	//выходим из кабинета
			scene.Delete(3);
			scene.Load("club_bar02.XML");

		}
		if(nextanimation == -5)
		{	//идем к столу
			scene.Delete(3);
			scene.Load("club_kab02.XML");
		}
		if(nextanimation == -9)
		{	//идем к ящикам
			//либо берем календарик 
			if(takecal)
			{
				GAME_OBJECT * p_cal;

				queststate.item_kalendarik = 1;
				p_cal = scene.FindObjectByName("kabinet01kalendar");
				if(p_cal != 0)
				scene.DeleteObject(p_cal);	
			
				//показываем скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
			

				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);

				p_obj = CreateGameObject(1,"scetch_kalendarik.scv", position, size);	
				scene.Add(p_obj, 2);

				scene.SetCursorType(0);
				queststate.typepr = 0;
	
	
			}
			//либо поджигаем ткань 
			else
			{
					//показываем скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
	
				queststate.typepr = 0;
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);

				p_obj = CreateGameObject(1,"scetch_burn_club.scv", position, size);	
				scene.Add(p_obj, 2);
			}
			
			nextanimation = 9;
		}
		
		
		if(nextanimation ==1)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_exit_idle.EZA", 1);
		}
		if(nextanimation ==2)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_table_exit.EZA", 1);
			nextanimation =-1;
		}
		if(nextanimation ==3)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_box_exit.EZA", 1);
			nextanimation =-1;
		}
		
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_exit_table.EZA", 1);
			nextanimation = -5;
		}
		if(nextanimation == 5)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_table_idle.EZA", 1);
		}
		if(nextanimation ==6)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_box_table.EZA", 1);
			nextanimation = -5;
		}
		if(nextanimation ==7)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_exit_box.EZA", 1);
			nextanimation = -9;
		}
		if(nextanimation ==8)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_table_box.EZA", 1);
			nextanimation = -9;
		}
		if(nextanimation == 9)
		{
			lastanimation = self->CreateSkeletonAnimation("cy_a_box_idle.EZA", 1);
		}
		


	}	
}
