#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{

	if(queststate.item_kruzhka != 0)
		scene.DeleteObject(self);
	
}

void ON_SETFOCUS()
{
	if(queststate.quest_get_wear)
	scene.SetCursorType(3);
	
}

void ON_KILLFOCUS()
{

	if(queststate.quest_get_wear)
	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	if(queststate.quest_get_wear)
	{
		//берем кружку
		queststate.item_kruzhka = 1;
		scene.DeleteObject(self);
		//показываем скетч

		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_kruzhka.scv", position, size);	
		scene.Add(p_obj, 2);
		scene.SetCursorType(0);
		queststate.typepr = 0;
	}

	
}
