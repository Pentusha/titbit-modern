#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;

int dialognum = 1;

void ON_CREATE()
{
	if(queststate.quest_talk_dost_axe == 2)
		scene.DeleteObject(self);

}


void ON_SETFOCUS()
{
	scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);	


}

