#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;


void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
}



void ON_CREATE()
{ 

	//фоновая музыка
	GAME_OBJECT * p_obj;
	p_obj = scene.FindObjectByName("sound_back");

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 29100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}


//	queststate.quest_freeze_giga = 3;

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 28;
	
	
	lastanimation = self->CreateSkeletonAnimation("pow_a_luk2_idle.EZA", 1);
	nextanimation = 1;

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{
		if (nextanimation < 0) return;

		if(param == 101) // если нажали идти к выходу
		{
			if(nextanimation == 1) nextanimation = -1;	//переход к reactor01
			if(nextanimation == 10) nextanimation = 100; //переход к reactor01
		}
		if(param == 104) // если нажали идти к канистре
		{
			if(nextanimation == 1) nextanimation = 13;// идем брать канистру
		}
		if(param == 121) // если нажали идти к люку
		{
			if(nextanimation == 1) nextanimation = -2;
			if(nextanimation == 10) nextanimation = 101;
		}
	}
	else
	{
		if(nextanimation == -1)
		{
			scene.Delete(3);
			scene.Load("reactor01.XML");
		}

		if(nextanimation == -2)
		{
			scene.Delete(3);
			scene.Load("getto_bomj.XML");
		}


		if(nextanimation == 100)
		{
			lastanimation = self->CreateSkeletonAnimation("pow_a_can_luk.EZA", 1);
			nextanimation = -1;
		}

		if(nextanimation == 101)
		{
			lastanimation = self->CreateSkeletonAnimation("pow_a_can_luk.EZA", 1);
			nextanimation = -2;
		}

		if(nextanimation == 1)	lastanimation = self->CreateSkeletonAnimation("pow_a_luk2_idle.EZA", 1);


		if(nextanimation == -10)
		{
			//берем канистру
			nextanimation = 10;
			queststate.item_titbit_can = 1; 


			GAME_OBJECT * p_plast;
			p_plast = scene.FindObjectByName("reaktor_02Kanistra");
			scene.DeleteObject(p_plast);	
		
			queststate.typepr = 0;
			scene.SetCursorType(0);	

			//показываем скетч

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_can.scv", position, size);	
			scene.Add(p_obj, 2);
		}

		if(nextanimation == 13)
		{
			lastanimation = self->CreateSkeletonAnimation("pow_a_luk_can.EZA", 1);
			nextanimation = -10;
		}


		if(nextanimation == 10) lastanimation = self->CreateSkeletonAnimation("pow_a_can_idle.EZA", 1);

	}
}
