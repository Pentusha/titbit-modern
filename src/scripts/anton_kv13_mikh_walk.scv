#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 15;

	lastanimation = self->CreateSkeletonAnimation("kmk_a_enter.EZA", 1);

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param == lastanimation)
	{
		lastanimation = self->CreateSkeletonAnimation("kmk_a_idle.EZA", 1);
		nextanimation = 3;
	}
}
