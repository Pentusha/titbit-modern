#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_SETFOCUS()
{

	if(queststate.item_piece_of_shit != -1)
		scene.SetCursorType(1);	
		
}

void ON_KILLFOCUS()
{

	if(queststate.item_piece_of_shit != -1)
		scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{


	if(queststate.item_piece_of_shit == -1)
		return;

	GAME_OBJECT * p_anton;


	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 104;
	scene.PostMessage(m);

}

