#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

bool idle;
int nextanimation;
int lastanimation;
STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

//перемещения для голого Антона

void ON_CREATE()
{
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 3020;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}
	
	//запоманаем номер предыдущей локации
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 4;

	if(queststate.lastlocation == 5)
	{
		lastanimation = self->CreateSkeletonAnimation("gsk_an_idle_left.EZA", 1);
		nextanimation = 3;
	
		p_stream = CreateStream("comment_anton_9.ogg");	
		p_stream->Play(false);	

	}
	else
	{
		lastanimation = self->CreateSkeletonAnimation("gsk_an_gc_gsk.EZA", 1);
		nextanimation = 0;	//задаем анимацию которая будет проигрываться после входа
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	GAME_OBJECT * p_item; 
	
	//выходим из локации
	if(param == 100 && nextanimation != -1)
	{
//		WriteLog("Message in");
		//есть два цикла стояния в локации
		if(nextanimation == 0)
			nextanimation = 100;	
	
		if(nextanimation == 3)
			nextanimation = 103; //от пластинки

	}


	if(queststate.typepr != 0 || param == 101)
	{
		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);	
		return;
	}


	//цикл анимации закончился
	if(param == lastanimation)
	{

		if(nextanimation == -1)
		{
			scene.Delete(3);//удаляем все не интерфейсные объекты
			scene.Load("getto_center_n.XML");	
				
		}
		
		if(nextanimation == 3)
		{
			lastanimation = self->CreateSkeletonAnimation("gsk_an_idle_left.EZA", 1);

		}
	
		if(nextanimation == 0)
		{
			lastanimation = self->CreateSkeletonAnimation("gsk_an_idle_right.EZA", 1);
		}
		
		if(nextanimation == 100)
		{
			lastanimation = self->CreateSkeletonAnimation("gsk_an_out1.EZA", 1);
			nextanimation = -1;
		}

			

		if(nextanimation == 103)
		{
			lastanimation = self->CreateSkeletonAnimation("gsk_an_out2.EZA", 1);
			nextanimation = -1;
		}

	}


}


