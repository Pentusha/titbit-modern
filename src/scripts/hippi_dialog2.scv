#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)
	{	
		p_text->Delete();
		p_text = NULL;
	}	

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;

	if(queststate.item_titbit_can == 0 || queststate.item_titbit_can == 1 )
	{
	if(step == 1) {	p_text = TextWindowCreate("vodokanal_anton_21", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_anton_21.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
}
	if(step == 2) {	p_text = TextWindowCreate("vodokanal_hippi_22", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_22.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);

}
	if(step == 3) {	p_text = TextWindowCreate("vodokanal_anton_23", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_anton_23.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
	if(step == 4) {	p_text = TextWindowCreate("vodokanal_hippi_24", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_24.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
	if(step == 5) {	p_text = TextWindowCreate("vodokanal_anton_25", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_anton_25.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
}
	if(step == 6) {	p_text = TextWindowCreate("vodokanal_hippi_26", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_26.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
	if(step == 7) {	p_text = TextWindowCreate("vodokanal_anton_27", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_anton_27.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
	if(step == 8) {	p_text = TextWindowCreate("vodokanal_hippi_28", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_28.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
	if(step == 9) {	step = -1;	queststate.quest_spoil_city = 2;	}					
	}							
	else if(queststate.item_titbit_can == 2)
	{
	if(step == 1) {	p_text = TextWindowCreate("vodokanal_hippi_31", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_31.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
	if(step == 2) {	p_text = TextWindowCreate("vodokanal_anton_32", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_anton_32.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
	if(step == 3) {	p_text = TextWindowCreate("vodokanal_hippi_33", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_33.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);

		//показываем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_spoil_vodocan.scv", position, size);	
		scene.Add(p_obj, 2);

}
	if(step == 4) {	p_text = TextWindowCreate("vodokanal_hippi_34", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_34.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
	if(step == 5) {	step = -1; queststate.quest_spoil_city = 3; queststate.item_titbit_can = -1;}					
	}
	else
	{
if(step == 1) {	p_text = TextWindowCreate("vodokanal_hippi_34", "font", position,size, 29, 2);	p_stream = CreateStream("vodokanal_hippi_34.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("hippi_rot.EZA", -1);
}
if(step == 2) {	step = -1;	}					


	}

	if(step == -1)
	{
		scene.DeleteObject(self); 
		
		//фоновая музыка
		GAME_OBJECT * p_snd;
 
		p_snd = scene.FindObjectByName("sound_back");	
	
		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}



		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign(2.0823,-9.1697,-5.9934);
		size.Assign(86.5951,24.7913,178.5709);
		camera.PlaceCamera(34.5, position, size);

		
				
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("hippi");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();


	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);

	position.Assign(0.33,-5.7587,4.6824);
	size.Assign(117.5825,16.1381,-171.7382);
	camera.PlaceCamera(8, position, size);


	StepDialog();	



}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}


