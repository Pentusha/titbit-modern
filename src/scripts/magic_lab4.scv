#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;



void ON_CREATE()
{ 
	lastanimation = self->CreateSkeletonAnimation("magic_lab_talk.EZA", 1);
	nextanimation = 1;

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{
		if (nextanimation < 0) return;

		if(param == 101) // если нажали идти к выходу
		{
			if(nextanimation == 1) nextanimation = -1;	//включаем диалог

		}
	}
	else
	{
		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("magic_lab_talk.EZA", 1);
		}

	}
}
