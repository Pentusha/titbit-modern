#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	step = step + 1;
	
if(step == 1) {	p_text = TextWindowCreate("clubyanus_yanus_61", "font", position,size, 29, 2);	p_stream = CreateStream("clubyanus_yanus_61.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
							
if(step == 2) {	p_text = TextWindowCreate("clubyanus_yanus_62", "font", position,size, 29, 2);	p_stream = CreateStream("clubyanus_yanus_62.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
							
if(step == 3) {	p_text = TextWindowCreate("clubyanus_yanus_63", "font", position,size, 29, 2);	p_stream = CreateStream("clubyanus_yanus_63.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
if(step == 4) {	step = -1;	}					

	
	if(step == -1)
	{
	//фоновая музыка
	GAME_OBJECT * p_snd;
	message m;	
	
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{

		m.message_id = EM_NOTIFY;
		m.lparam = 100;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	p_snd = scene.FindObjectByName("scetch_compr_tape");	

	if(p_snd != NULL)
	{
		scene.DeleteObject(p_snd);		

	}

	
		scene.DeleteObject(self); 
		
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	queststate.typepr = 0;
	scene.SetCursorType(0);

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	
	StepDialog();	
	

	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

