#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;


STREAM * p_stream = NULL;


void ON_DESTROY()
{

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

	WriteLog("Destroyed");

}


void ON_CREATE()
{

	//фонова€ музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 5010;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 19;
 

	if(queststate.lastlocation == 17) // если пришли с улицы
	{
		lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_idle.EZA", 2);
		nextanimation = 1;
	}
	if(queststate.lastlocation == 20) // если пришли от барной стойки
	{
		lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_idle.EZA", 2);
		nextanimation = 5;
	}
	if(queststate.lastlocation == 21) // если пришли из туалета
	{
		lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_idle.EZA", 2);
		nextanimation = 4;
	}
	if(queststate.lastlocation == 24) // если пришли с танцпола
	{

		lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_idle.EZA", 2);
		nextanimation = 3;
	}
 
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation)
	{
		if (nextanimation < 0) return;

	//попытались использовать предмет 	
		if(queststate.typepr != 0)
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);
			return;
		}



		WriteLog("Notify");

		if(param == 101) // если нажали идти на выход
		{
			if(nextanimation == 1) nextanimation = -1;

			if(nextanimation == 2) nextanimation = 21;
			if(nextanimation == 3) nextanimation = 31;
			if(nextanimation == 4) nextanimation = 41;
			if(nextanimation == 5) nextanimation = 51;
		}	

		if(param == 102) // если нажали идти к ћагниту
		{
			if(nextanimation == 2) nextanimation = -2;

			if(nextanimation == 1) nextanimation = 12;
			if(nextanimation == 3) nextanimation = 32;
			if(nextanimation == 4) nextanimation = 42;
			if(nextanimation == 5) nextanimation = 52;
		}	

		if(param == 103) // если нажали идти на танцпол
		{
			if(nextanimation == 3) nextanimation = -3;

			if(nextanimation == 1) nextanimation = 13;
			if(nextanimation == 2) nextanimation = 23;
			if(nextanimation == 4) nextanimation = 43;
			if(nextanimation == 5) nextanimation = 53;
		}

		if(param == 104) // если нажали идти в туалет
		{
			if(nextanimation == 4) nextanimation = -4;

			if(nextanimation == 1) nextanimation = 14;
			if(nextanimation == 2) nextanimation = 24;
			if(nextanimation == 3) nextanimation = 34;
			if(nextanimation == 5) nextanimation = 54;
		}
		
		if(param == 105) // если нажали идти к барной стойке
		{
			if(nextanimation == 5) nextanimation = -5;

			if(nextanimation == 1) nextanimation = 15;
			if(nextanimation == 2) nextanimation = 25;
			if(nextanimation == 3) nextanimation = 35;
			if(nextanimation == 4) nextanimation = 45;
		}
		
	}
	else
	{		


		// уходим в другие локации
		if ( (nextanimation>=-5)&&(nextanimation<=-1)&&(nextanimation!=-2) ) scene.Delete(3);
		if(nextanimation == -1) scene.Load("sumerki_entrance.XML");
		if(nextanimation == -3) scene.Load("club_disko01.XML");
		if(nextanimation == -4) scene.Load("club_wc.XML");
		if(nextanimation == -5) scene.Load("club_bar02.XML");
		
		if(nextanimation == -2)
		{
	
			//разговариваем с ћагнитом
			vec3_t position, size;	
			GAME_OBJECT * p_obj;

			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"magnit_dialog.scv", position, size);

			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);

			nextanimation = 2;

		}		

		// если заканчиваетс€ анимаци€ "idle" создаем ее заново
		if(nextanimation == 1) lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_idle.EZA", 1);
		if(nextanimation == 2) lastanimation = self->CreateSkeletonAnimation("cb1_a_magnit_idle.EZA", 1);
		if(nextanimation == 3) lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_idle.EZA", 1);
		if(nextanimation == 4) lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_idle.EZA", 1);
		if(nextanimation == 5) lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_idle.EZA", 1);




		if(nextanimation == 12)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_magnit.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 13)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_dance.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 14)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_wc.EZA", 1);
			nextanimation = -4;
		}
		if(nextanimation == 15)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_exit_bar.EZA", 1);
			nextanimation = -5;
		}
		
		//////////////

		if(nextanimation == 21)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_magnit_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 23)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_magnit_dance.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 24)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_magnit_wc.EZA", 1);
			nextanimation = -4;
		}
		if(nextanimation == 25)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_magnit_bar.EZA", 1);
			nextanimation = -5;
		}
		
		//////////////

		if(nextanimation == 31)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 32)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_magnit.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 34)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_wc.EZA", 1);
			nextanimation = -4;
		}
		if(nextanimation == 35)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_dance_bar.EZA", 1);
			nextanimation = -5;
		}
		
		//////////////

		if(nextanimation == 41)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 42)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_magnit.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 43)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_dance.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 45)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_wc_bar.EZA", 1);
			nextanimation = -5;
		}

		//////////////

		if(nextanimation == 51)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 52)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_magnit.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 53)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_dance.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 54)
		{
			lastanimation = self->CreateSkeletonAnimation("cb1_a_bar_wc.EZA", 1);
			nextanimation = -4;
		}





	}	
}
