#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

void ON_CREATE()
{ 
	scene.SetCursorType(0);
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 15;

	if(queststate.activelocation == 15)
	{
		lastanimation = self->CreateSkeletonAnimation("kmk_an_idle.EZA", 1);
	}
	else
	{	
		lastanimation = self->CreateSkeletonAnimation("kmk_an_enter.EZA", 1);
	}

}

void ON_NOTIFY(int param)
{
	if(param == lastanimation)
	{
		lastanimation = self->CreateSkeletonAnimation("kmk_an_idle.EZA", 1);
		nextanimation = 3;
	}
	else
	{



	}
}
