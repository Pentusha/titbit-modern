#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{

}

void ON_SETFOCUS()
{
	if (queststate.item_titbit_can != 0)
						scene.SetCursorType(6);
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}

void ON_LBUTTONDOWN()
{
	if (queststate.item_titbit_can != 0)
	{
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 121;
		scene.PostMessage(m);
	}
}
