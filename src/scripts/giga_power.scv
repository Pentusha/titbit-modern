#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_SETFOCUS;
export ON_KILLFOCUS;


int nextanimation;
int lastanimation;


void ON_SETFOCUS()
{
	scene.SetCursorType(4);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}


void ON_CREATE()
{

	if(queststate.quest_freeze_giga > 0)
	{
		//WriteLog("create idle");
		lastanimation = self->CreateSkeletonAnimation("gigahertz_out.EZA", 1);
		nextanimation = 2;
	}
	else if (queststate.quest_freeze_giga == -1)
	{
		scene.DeleteObject(self);
	}
	else
	{
		//WriteLog("create power");
		lastanimation = self->CreateSkeletonAnimation("giga_power.EZA", 1);
		nextanimation = 1;
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		if(param == 101)
		{
			if((nextanimation == 1) || (nextanimation == 3))
			{
				nextanimation = 2;
			}
			else
			{
				nextanimation = 1;
			}
		}
		if (param == 103)
		{
			lastanimation = self->CreateSkeletonAnimation("giga_attack.EZA", 1);
			nextanimation = 3;
		}


	}
	else
	{
		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("giga_power.EZA", 1);
		}
		if(nextanimation == 2)
		{
			lastanimation = self->CreateSkeletonAnimation("gigahertz_out.EZA", 1);
		}
		if(nextanimation == 3)
		{
			if (queststate.quest_freeze_giga == -1)
				return;
			queststate.quest_freeze_giga = -2;
			//показываем скетч
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_kill.scv", position, size);	
			scene.Add(p_obj, 2);

			/// game over !!!!
			scene.Delete(3);
			scene.Load("gameover.XML");

			//lastanimation = self->CreateSkeletonAnimation("gigahertz_out.EZA", 1);
			//nextanimation = 2;
		}
	}
}
