#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;


LINK * p_obj= NULL;

void ON_CREATE()
{
	if( queststate.item_belomor != 0)
	{
		scene.DeleteObject(self);	
	}
	
}

void ON_SETFOCUS()
{
	scene.SetCursorType(3);
	
		
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}


void ON_LBUTTONDOWN()
{
	GAME_OBJECT * p_anton;
	ON_KILLFOCUS();

	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 103;
	scene.PostMessage(m);

 
}


