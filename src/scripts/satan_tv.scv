#include scener
#include queststate

export ON_CREATE;
export ON_TIME;
export ON_LBUTTONDOWN;


int step = 0;


void ON_TIME(int timernum)
{	

	vec3_t position, size;
	scene.DeleteObject(self);

	message m;
	m.p_target = scene.FindObjectByName("dost_dialog");
	m.message_id = EM_NOTIFY;
	m.lparam = 0;
	scene.PostMessage(m);

	position.Assign(2.34,-1.1706,0.6632);
	size.Assign(-94.0596,11.8791,-0.8371);
	camera.PlaceCamera(41.2, position, size);


}

void ON_CREATE()
{

	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	LINK * p_avi;

	position.Assign(200,125,0);
	size.Assign(600,450,0);
	uvposition.Assign(0,1,0);
	uvsize.Assign(1,-1,0);

	p_avi = CreateAVIPlane(position, size, uvposition, uvsize, false, "dost.avi");


	self->Attach(p_avi);
	position.Assign(0,0,-1);
	size.Assign(1024,768,0);
	uvposition.Assign(0.64,1,0);
	uvsize.Assign(0.36,-0.25,0);

	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "Kvartira_satana.tga", 1);
	self->Attach(p_obj);
	
	self->CreateTimer(23440, -1);

	position.Assign(2000.34,-1.1706,0.6632);
	size.Assign(94.0596,11.8791,-0.8371);
	camera.PlaceCamera(41.2, position, size);
	
}


void ON_LBUTTONDOWN()
{
	ON_TIME(0);

}
