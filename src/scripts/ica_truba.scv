#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

GAME_OBJECT * p_celaya = NULL;
GAME_OBJECT * p_loman = NULL;
GAME_OBJECT * p_remont = NULL;

STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_CREATE()
{
	p_celaya = scene.FindObjectByName("cafe_truba_cel");
	p_loman = scene.FindObjectByName("cafe_truba_lom");
	p_remont = scene.FindObjectByName("cafe_truba_rem");
	
	if(queststate.quest_cut_electric_wire == 0)
	{
		vec3_t pos;
		p_loman->GetBonePosition(0, pos);
		pos.x += 1000;
		p_loman->SetBonePosition(0, pos);

		p_remont->GetBonePosition(0, pos);
		pos.x += 1000;
		p_remont->SetBonePosition(0, pos);
	}
	if(queststate.quest_cut_electric_wire == 1)
	{
		vec3_t pos;
		scene.DeleteObject(p_celaya);

		p_remont->GetBonePosition(0, pos);
		pos.x += 1000;
		p_remont->SetBonePosition(0, pos);
	}
	if(queststate.quest_cut_electric_wire == 2)
	{
		scene.DeleteObject(p_celaya);
		scene.DeleteObject(p_loman);		
	}


}

void ON_SETFOCUS()
{
if(queststate.quest_cut_electric_wire == 0 && queststate.item_compromat_fotos == -1)
	scene.SetCursorType(1);		
}

void ON_KILLFOCUS()
{
if(queststate.quest_cut_electric_wire == 0 && queststate.item_compromat_fotos == -1)
	scene.SetCursorType(0);	
}

void ON_LBUTTONDOWN()
{

	//пытаемся использовать пилу на кабель - хорошая идея
	if(queststate.quest_cut_electric_wire == 0 && queststate.item_compromat_fotos == -1)
	{
		if(queststate.typepr == 35) 
		{
			//показываем скетч			
			
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);
			p_obj = CreateGameObject(1,"scetch_truba.scv", position, size);	
			scene.Add(p_obj, 2);

			queststate.quest_cut_electric_wire = 1;
			queststate.item_saw_benzo = -1;	
	
			queststate.typepr = 0;
			scene.SetCursorType(0);	
		}
		else
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
	
			p_stream = CreateStream("comment_anton_8.ogg");	
			p_stream->Play(false);	

		}
	}


}
