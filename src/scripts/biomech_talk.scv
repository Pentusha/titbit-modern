#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;



void ON_CREATE()
{
	LINK * p_obj;	

	p_obj = self;
	LINK* p_lnk = p_obj->GetChild();
	

	if(queststate.item_rubber_glove == -1)
	{
		self->CreateSkeletonAnimation("biomech_lay.EZA", -1);
		p_lnk->Delete();		
	}
	else
		self->CreateSkeletonAnimation("biomech_idle.EZA", -1);


	
}




void ON_SETFOCUS()
{
	if(queststate.item_titbit == 0 && queststate.item_plastic != -1)// 
		scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	if(queststate.item_titbit == 0 )//&& queststate.item_plastic != -1
		scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	if(queststate.item_titbit == 0 && queststate.item_plastic != -1)//|| 
	{

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 106;
	scene.PostMessage(m);

	}


}

