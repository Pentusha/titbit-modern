#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS; 
export ON_LBUTTONDOWN;
export ON_TIME;
export ON_NOTIFY;
export ON_DESTROY;


bool idle;
int nextanimation;
int lastanimation;

STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void ON_CREATE()
{
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 3020;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	//запоманаем номер предыдущей локации
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 4;

	lastanimation = self->CreateSkeletonAnimation("gsc_anton_in.EZA", 1);
	nextanimation = 0;	//задаем анимацию которая будет проигрываться после входа
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	GAME_OBJECT * p_item; 
		
	if(param != lastanimation)
	{
		if(queststate.typepr != 0)
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
				p_stream = CreateStream("comment_anton_2.ogg");
				p_stream->Play(false);
			return;	
		}

	}
	//выходим из локации
	if(param == 100 && nextanimation != -1)
	{
		//есть два цикла стояния в локации
		if(nextanimation == 0)
			nextanimation = 100;
		else
			nextanimation = 103;
		param = lastanimation;
	}

	if(param == 101 && nextanimation != 102)
	{


		nextanimation = 101;
		param = lastanimation;
	}


	//цикл анимации закончился
	if(param == lastanimation)
	{

		if(nextanimation == -1)
		{
			scene.Delete(3);//удаляем все не интерфейсные объекты
			scene.Load("getto_center.XML");	
				
		}
		
		if(nextanimation == 1)
		{
			lastanimation = self->CreateSkeletonAnimation("gsc_anton_in.EZA", 1);
			nextanimation = 0;
		}
	
		if(nextanimation == 0)
		{
			lastanimation = self->CreateSkeletonAnimation("gsc_anton_idle_right.EZA", 1);
		}
		
		if(nextanimation == 100)
		{
			lastanimation = self->CreateSkeletonAnimation("gsc_anton_out.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == -102)
		{
			nextanimation = 102;
			//берем пластинку
			queststate.item_disk_piece = (queststate.item_disk_piece | 2);
			p_item= scene.FindObjectByName("plast_02");
			message m;
			m.p_target = p_item;
			m.message_id = EM_DESTROY;
			scene.PostMessage(m);


			//показываем скетч
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);
			
			p_obj = CreateGameObject(1,"scetch_plast.scv", position, size);	
	
			scene.Add(p_obj, 2);
	
			queststate.typepr=0;
			scene.SetCursorType(0); 
		}
		if(nextanimation == 102)
		{

		

			lastanimation = self->CreateSkeletonAnimation("gsc_anton_idle_left.EZA", 1);
		
		}
		
		if(nextanimation == 101)
		{
			lastanimation = self->CreateSkeletonAnimation("gsc_anton_pick.EZA", 1);
			nextanimation = -102;

		
		}

		if(nextanimation == 103)
		{
			lastanimation = self->CreateSkeletonAnimation("gsc_anton_out2.EZA", 1);
			nextanimation = -1;
		}

	}


}


