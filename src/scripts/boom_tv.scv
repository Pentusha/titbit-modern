#include scener
#include queststate

export ON_CREATE;
export ON_TIME;
//export ON_LBUTTONDOWN;

STREAM * p_stream = NULL;
LINK * p_obj;				
LINK * p_avi;

int step = 0;
int timer = 0;
int timer2 = 0;

void ON_TIME(int timernum)
{	

	if(timernum == timer)
	{
		queststate.item_tualet_paper = -1;
//		queststate.item_petrolium_can = -1;
		queststate.item_note = 1;

		self->Selectable(false);		
		timer = 0;

		timer2 = self->CreateTimer(12000, 1);
//		queststate.activelocation = 18;

		scene.Load("sumerki_entrance2.XML");


	}
	else if(timernum == timer2)
	{

		if(p_stream != NULL)
		{	
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
		scene.DeleteObject(self);
	
	}
	else
	{

		p_stream = CreateStream("club_boom.ogg");
		p_stream->Play(false);

	}
	
}


void ON_CREATE()
{

	vec3_t position, size, uvposition, uvsize;	
	

	position.Assign(0,0,0);
	size.Assign(1024,768,0);
	uvposition.Assign(0,1,0);
	uvsize.Assign(1,-1,0);

	p_avi = CreateAVIPlane(position, size, uvposition, uvsize, false, "buh.avi");


	self->Attach(p_avi);
	
	timer = self->CreateTimer(3000, 1);

	position.Assign(20000.34,-1.1706,0.6632);
	size.Assign(94.0596,11.8791,-0.8371);
	camera.PlaceCamera(41.2, position, size);
	
	self->CreateTimer(500, 1);

	
}


void ON_LBUTTONDOWN()
{
	ON_TIME(0);

}
