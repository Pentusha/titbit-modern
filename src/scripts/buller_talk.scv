#include scener

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;



void ON_SETFOCUS()
{
	scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,"buller_dialog1.scv", position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);


}

