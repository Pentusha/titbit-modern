#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_TIME;




int step = 0;
LINK * p_text = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-4.2138,-89.9999,-93.9261);
		p_pers->SetBoneRotation(15, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		vec3_t rot;
		rot.Assign(-4.2138,-89.9999,-93.9261);
		p_anton->SetBoneRotation(7, rot);
	}
	
	
	step = step + 1;
	
	if(step == 1) {
		p_text = TextWindowCreate("mentalhospital_freak_11", "font", position,size, 29, 2);				self->Attach(p_text);	
		self->CreateTimer(16000,1);
		p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	

	}
	if(step == 2) {	
		p_text = TextWindowCreate("mentalhospital_anton_15", "font", position,size, 29, 2);	
		self->Attach(p_text);		
		self->CreateTimer(4500,1);
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 3) {	
		p_text = TextWindowCreate("mentalhospital_freak_21", "font", position,size, 29, 2);	
		self->Attach(p_text);	
		self->CreateTimer(2500,1);
		p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 4) {
		p_text = TextWindowCreate("mentalhospital_anton_22", "font", position,size, 29, 2);				
		self->Attach(p_text);		
		self->CreateTimer(8500,1);
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 5) {	
		p_text = TextWindowCreate("mentalhospital_freak_23", "font", position,size, 29, 2);				
		self->Attach(p_text);		
		self->CreateTimer(3000,1);
		p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 6) {	
		p_text = TextWindowCreate("mentalhospital_anton_24", "font", position,size, 29, 2);	
		self->Attach(p_text);	
		self->CreateTimer(3000,1);	
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 7) {
		p_text = TextWindowCreate("mentalhospital_freak_25", "font", position,size, 29, 2);
		self->Attach(p_text);
		self->CreateTimer(22000,1);	
	p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 8) {
		p_text = TextWindowCreate("mentalhospital_anton_26", "font", position,size, 29, 2);	
		self->Attach(p_text);	
		self->CreateTimer(3000,1);	
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 9) {
		p_text = TextWindowCreate("mentalhospital_freak_27", "font", position,size, 29, 2);	
		self->Attach(p_text);	
		self->CreateTimer(3000,1);
	p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 10) {
		p_text = TextWindowCreate("mentalhospital_anton_28", "font", position,size, 29, 2);				self->Attach(p_text);	
		self->CreateTimer(4000,1);
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 11) {
		p_text = TextWindowCreate("mentalhospital_freak_29", "font", position,size, 29, 2);				self->Attach(p_text);		
			self->CreateTimer(7000,1);
	p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 12) {
		p_text = TextWindowCreate("mentalhospital_anton_210", "font", position,size, 29, 2);			
		self->Attach(p_text);		
		self->CreateTimer(8000,1);
		p_antguba = p_anton->CreateSkeletonAnimation("an_rot.EZA", -1);
	}
	if(step == 13) {	
		p_text = TextWindowCreate("mentalhospital_freak_211", "font", position,size, 29, 2);				self->Attach(p_text);	
		self->CreateTimer(20000,1);
	p_guba = p_pers->CreateSkeletonAnimation("freak_rot.EZA", -1);	
	}
	if(step == 14) {
		step = -1;	}					
	
	
	
	if(step == -1)
	{
		scene.DeleteObject(self); 
			
	}					
	
	
}
void ON_TIME(int timernum)
{
	StepDialog();
}


void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				

	
	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("freak");
	p_pers = p_obj;
	
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	p_obj = scene.FindObjectByName("anton_psix");
	p_anton = p_obj;


	StepDialog();	
	
	
	
}


