#include scener

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
ANILINK * p_guba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	if(p_text != NULL)
	{	
		p_text->Delete();	
		p_text = NULL;
	}
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	
	
	
	step = step + 1;
	
	if(step == 1) 
	{
		p_text = TextWindowCreate("icafe_megakilla_81", "font", position,size, 29, 2);	
		p_stream = CreateStream("icafe_megakilla_81.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);	
		self->Attach(p_text);	
		p_guba = p_pers->CreateSkeletonAnimation("megakilla_rot.EZA", -1);

	}

	if(step == 2) 	
	{	
		p_text = TextWindowCreate("icafe_anton_82", "font", position,size, 29, 2);
		p_stream = CreateStream("icafe_anton_82.ogg");
		p_stream->Play(false);	
		p_stream->SetSync(0, self);
		self->Attach(p_text);	
	}

	if(step == 3) 
	{
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 60;
		m.p_target = p_snd;
		scene.PostMessage(m);
	
	}	
		scene.DeleteObject(self);
		position.Assign(5.2054,-0.8018,-3.6637);
		size.Assign(-66.9944,-31.6875,-12.573);
		camera.PlaceCamera(34.1, position, size);

		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("megakilla_idle.EZA", -1);	

	}					
	
	
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 15;
		m.p_target = p_snd;
		scene.PostMessage(m);
	
	}	

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	p_obj = scene.FindObjectByName("megakilla");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("megakilla_talk.EZA", -1);	

	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	StepDialog();	
	
	position.Assign(4.6007,-1.3271,-0.0796);
	size.Assign(-83.673,-26.2088,-2.8035);
	camera.PlaceCamera(21.6, position, size);

	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

