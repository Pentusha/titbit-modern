#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{

	if(queststate.item_pioners_tie != 0)
		scene.DeleteObject(self);
	
}

void ON_SETFOCUS()
{
	scene.SetCursorType(3);
	
}

void ON_KILLFOCUS()
{

if(queststate.quest_get_wear)
	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{	


		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 107;
		scene.PostMessage(m);

	
}
