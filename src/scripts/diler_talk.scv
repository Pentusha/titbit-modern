#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;

void ON_CREATE()
{
	if(queststate.item_mount == -1)
		self->CreateSkeletonAnimation("diler_lay.EZA", -1);
	else
		self->CreateSkeletonAnimation("diler_idle.EZA", -1);

}



void ON_SETFOCUS()
{
	if(queststate.item_mount != -1)
	if(queststate.typepr == 34)
	  scene.SetCursorType(1);			
	else
	  scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	if(queststate.item_mount != -1)
   	   scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	
	if(queststate.item_mount != -1)
	{
		GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 103;
	scene.PostMessage(m);
}

}

