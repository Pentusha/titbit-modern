#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_MOUSEOVER;
export ON_LBUTTONDOWN;

vec3_t campos, camrot;
float camfov;
int selloc = 0;


void ON_MOUSEOVER(vec3_t mousepos)
{
	vec3_t dpos;	
	

	//сумерки 	
	dpos.x = mousepos.x - 483;
	dpos.y = mousepos.y - 544;

	if(dpos.x*dpos.x + dpos.y*dpos.y < 1600)
	{
		scene.SetCursorType(6);
		selloc = 1;
		return;
	}
	
	//гетто 	
	dpos.x = mousepos.x - 806;
	dpos.y = mousepos.y - 157;

	if(dpos.x*dpos.x + dpos.y*dpos.y < 1600)
	{
		scene.SetCursorType(6);
		selloc = 2;
		return;
	}

	if(queststate.item_kalendarik != 0)
	{

		//кафе 	
		dpos.x = mousepos.x - 562;
		dpos.y = mousepos.y - 497;

		if(dpos.x*dpos.x + dpos.y*dpos.y < 1600)
		{
			scene.SetCursorType(6);
			selloc = 3;
			return;
		}
	}

	if(queststate.quest_spoil_city > 0)
	{

		//водоканал	
		dpos.x = mousepos.x - 212;
		dpos.y = mousepos.y - 363;

		if(dpos.x*dpos.x + dpos.y*dpos.y < 1600)
		{
			scene.SetCursorType(6);
			selloc = 4;
			return;
		}
	}		
	selloc = 0;

	scene.SetCursorType(0);

}

void ON_NOTIFY(int param)
{

}



void ON_CREATE()
{
	
	LINK * p_link;
	IFPlane * p_plane;
	vec3_t center;
 	vec3_t position, size, uvposition, uvsize;
	queststate.activelocation = 34;

	position.Assign(0,0,0);	 
	uvposition.Assign(0,0.75,0);
	size.Assign(1024,768,0);
	uvsize.Assign(1, -0.75, 0);
	center.Assign(0,0,0);	

	p_link = CreateIFPlane(position, size, uvposition, uvsize, "map.tga");
	self->Attach(p_link);


	position.Assign(330,401,-1);	 
	uvposition.Assign(0,1,0);
	
	size.Assign(209,180,0);
	uvsize.Assign(0.2041015625, -0.17578125, 0);
	center.Assign(0,0,0);	

	p_link = CreateIFPlane(position, size, uvposition, uvsize, "map.tga");
	self->Attach(p_link);

	if(queststate.item_kalendarik != 0)
	{

		//и-кафе
		position.Assign(514,352,-1);	 
		uvposition.Assign(0.5,1,0);
		
		size.Assign(246,167,0);
		uvsize.Assign(0.240234375, -0.1630859375, 0);
		center.Assign(0,0,0);	

		p_link = CreateIFPlane(position, size, uvposition, uvsize, "map.tga");
		self->Attach(p_link);
	}

	//гетто
	position.Assign(639,12,-1);	 
	uvposition.Assign(0.25,1,0);
	
	size.Assign(204,155,0);
	uvsize.Assign(0.19921875, -0.1513671875, 0);
	center.Assign(0,0,0);	

	p_link = CreateIFPlane(position, size, uvposition, uvsize, "map.tga");
	self->Attach(p_link);

	if(queststate.quest_spoil_city > 0)
	{
		//водоканал
		position.Assign(54,217,-1);	 
		uvposition.Assign(0.75,1,0);
		
		size.Assign(187,157,0);
		uvsize.Assign(0.19921875, -0.1513671875, 0);
		center.Assign(0,0,0);	

		p_link = CreateIFPlane(position, size, uvposition, uvsize, "map.tga");
		self->Attach(p_link);
	}



}

void ON_LBUTTONDOWN()
{
	switch(selloc)
	{
	case 1: 	
		scene.DeleteObject(self);
		if(queststate.item_tualet_paper != -1)
		{
			scene.Load("sumerki_entrance.XML");
		}
		else
		{
			scene.Load("sumerki_entrance2.XML");
		}
		break;
	case 2: 	
		scene.DeleteObject(self);
		scene.Load("red_light_distr.XML");
		break;
	case 3: 	
		scene.DeleteObject(self);
		scene.Load("icafe_admin.XML");
		break;
	case 4: 	
		scene.DeleteObject(self);
		scene.Load("vodocanal.XML");
		break;
	}

}


