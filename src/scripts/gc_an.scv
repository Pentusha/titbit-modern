#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_TIME;
export ON_DESTROY;



int step = 0;
STREAM * p_stream = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size, uvpos, uvsize;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	

	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	
	step = step + 1;
	if(step == 1) 
	{
		self->CreateSkeletonAnimation("gcat_a_wakeup.EZA", 1);
	}
	
	if(step == 2) 
	{
		GAME_OBJECT * p_obj;
		LINK * p_avi;
		
		
		p_obj = scene.FindObjectByName("getto_cat_cat");
		position.Assign(0, 0, 0);
		size.Assign(24, 18, 0);
		uvpos.Assign(0, 1, 0);
		uvsize.Assign(1, -1, 0);
	
		p_avi = CreateAVIPlane(position, size, uvpos, uvsize, true, "cat_1.avi");
		p_obj->Attach(p_avi);

		p_stream = CreateStream("cat_01.ogg");
		p_stream->Play(false);	
		p_stream->SetSync(0, self);
		self->CreateSkeletonAnimation("gcat_a_idle.EZA",-1); 

		//разговариваем
//		vec3_t position, size;	
//			GAME_OBJECT * p_obj;
		position.Assign(0, 600, -80);
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"cat_rolik_dailog.scv", position, size);
	
		position.Assign(512, -216, 0);
		p_obj->SetBoneCenter(0,position);

		scene.Add(p_obj, 2);

	}
	if(step == 3) {	step = -1;}					
	
	
	if(step == -1)
	{
//		scene.DeleteObject(self); 
		
		scene.Delete(3);//удаляем все не интерфейсные объекты
		scene.Load("getto_skamejka_n.XML");
	
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}


void ON_TIME(int timernum)
{
	step = -2;
	StepDialog();
	
}

void ON_CREATE()
{

	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 3010;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}


	queststate.activelocation = 5;
	StepDialog();	
	
	//сторожевой таймер
	self->CreateTimer(150000, 1);	

	
}

