void ON_LBUTTONDOWN()
{
		
	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 106;
	scene.PostMessage(m);	
}
