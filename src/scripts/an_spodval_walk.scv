#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int nextanimation;
int lastanimation;




STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_NOTIFY(int param)
{
	GAME_OBJECT * p_item = NULL;
	

	//если в руках балончик с газом и есть противогаз
	if(queststate.typepr == 15)
	{
		if(queststate.item_respirator == 1)
		{
			queststate.item_gas_ballon = -1;
			//задаем анимацию на булера и волшебницу
			GAME_OBJECT * p_pers;
			LINK * p_obj;
			ANILINK* p_ani;
		
			p_obj = scene.FindObjectByName("magic");
			p_ani = p_obj->GetAniLink();
			p_pers =  p_obj;
			if(p_ani != NULL)
			p_ani->Delete();
			p_pers->CreateSkeletonAnimation("magic_lay.EZA", -1);	
		
			p_obj = scene.FindObjectByName("buller");
			p_ani = p_obj->GetAniLink();
			p_pers =  p_obj;
			if(p_ani != NULL)
			p_ani->Delete();
			p_pers->CreateSkeletonAnimation("buller_lay.EZA", -1);	
		
			queststate.typepr = 0;
			scene.SetCursorType(0);	
			
			vec3_t position, size;	
			GAME_OBJECT * p_skt;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);
		
			p_skt = CreateGameObject(1,"scetch_use_gas.scv", position, size);		
			
			scene.Add(p_skt, 2);
			return;		
		}
		else
		{
		
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
				p_stream = CreateStream("comment_anton_3.ogg");
				p_stream->Play(false);	
			return;
		}
	}
	else
	{
		if(param == 108 && queststate.typepr == 7 && queststate.item_pioners_tie == 1)
		// ткнулись в лужу спермы 
		{	
				queststate.item_pioners_tie = 2;
				queststate.typepr = 0;
				scene.SetCursorType(0);	
				//кажем скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
	
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);
		
				p_obj = CreateGameObject(1,"scetch_sperma.scv", position, size);	
			
				scene.Add(p_obj, 2);

				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
				p_stream = CreateStream("comment_cat_6.ogg");
				p_stream->Play(false);	


				return;	
		}
	
		if(param == 106 && queststate.typepr == 42)
		{
			//используем видекасету на телевизоре
			queststate.item_dance_video = -1;
			queststate.typepr = 0;
			scene.SetCursorType(0);	

		}


		if(queststate.typepr != 0)
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);
			return;	
		}
		
	}
		
	
	


	if(param == 101) // если нажали на одежду
	{
		if(queststate.item_gas_ballon == -1 )
		{

			scene.Delete(3);
			scene.Load("sex_podval.XML");		
			queststate.item_gas_ballon = -2;
			queststate.quest_get_wear = 1;
			queststate.item_respirator = -1;
			queststate.item_bullets = 1;

 		}
		//волшебница не позволяет взять 
		else
		{
			queststate.quest_talk_magic = 10;
			param = 105;
		}			

	}

	if(param == 102)// если нажали на член
	{	
		if(queststate.quest_get_wear)
		{
			//берем член	
			queststate.item_tri_fallos = 1;
			p_item = scene.FindObjectByName("sex_pod_chlen");
		}
		else
		{
		
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
	
			p_stream = CreateStream("comment_anton_3.ogg");
			p_stream->Play(false);
			return;	
		}
				
	}
	if(param == 103)// если нажали на противогаз
	{	
		//берем противогаз	
		queststate.item_respirator = 1;
		p_item = scene.FindObjectByName("sex_pod_protiv");
				
	}
	if(param == 104)// если нажали на бюстгалтер
	{	
		if(queststate.quest_get_wear)
		{
		
		//берем бюстгалтер	
		queststate.item_pants = 1;
		queststate.typepr = 0;
		scene.SetCursorType(0);	
		p_item = scene.FindObjectByName("sex_pod_lif");
		}
		else
		{
		
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
	
			p_stream = CreateStream("comment_anton_4.ogg");
			p_stream->Play(false);
			return;	
		}



		
	}
	if(param == 105)// если нажали на волшебницу
	{	
		WriteLog("magic");
		if(queststate.item_gas_ballon != -1)
		{
			//разговариваем

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"magic_dialog.scv", position, size);
	
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);
		}
			
	}
/////////////////////////////////////
	if(param == 106) // если нажали на телевизор
	{
		vec3_t posv, sizv;
		GAME_OBJECT * p_video;

		posv.Assign(0, 0, -90);
		sizv.Assign(1024,768,0);

		p_video = CreateGameObject(1,"podval_playvideo.scv", posv, sizv);
		scene.Add(p_video, 2);	
	}
/////////////////////////////////////

	if(param == 107)// берем галстук
	{	
			
		
		if(queststate.quest_get_wear)
		{
			queststate.item_pioners_tie = 1;
			p_item = scene.FindObjectByName("sex_pod_galstuk");	

			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_cat_5.ogg");
			p_stream->Play(false);	
		}
		else
		{
		
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
	
			p_stream = CreateStream("comment_anton_11.ogg");
			p_stream->Play(false);
			return;	
		}

			
	}
	if(param == 108)// лужа спермы
	{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);
	}

	if(param == 109)//выходим из локации
	{	
		scene.Delete(3);
		if(queststate.quest_get_wear == 1)
		{
			scene.Load("podjezd_podval.XML"); 
		}
		else
		{
			scene.Load("podjezd_podval_n.XML"); 
		}
		
	}
	if(param == 110)//смотрим на диван
	{
	
		if( queststate.quest_aes_password >= 4)
		{
			scene.Delete(3);
			scene.Load("sex_podval_divan.XML");
		}
	}	


	if(p_item != NULL)
	{

		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
		
		if(param == 102)
			p_obj = CreateGameObject(1,"scetch_trexchlen.scv", position, size);	
		if(param == 103)
			p_obj = CreateGameObject(1,"scetch_respirator.scv", position, size);	
		if(param == 104)
			p_obj = CreateGameObject(1,"scetch_lifchik.scv", position, size);	
		if(param == 107)
			p_obj = CreateGameObject(1,"scetch_galstuk.scv", position, size);	


		scene.Add(p_obj, 2);
	

		queststate.typepr=0;
		scene.SetCursorType(0); 
		scene.DeleteObject(p_item);
	}


}


void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 6100;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 10;
	
	if(queststate.quest_get_wear == 1)
		lastanimation = self->CreateSkeletonAnimation("podval_a_idle.EZA", -1);
	else
		lastanimation = self->CreateSkeletonAnimation("podval_an_idle.EZA", -1);

	
	if(queststate.quest_talk_magic == 0)
		ON_NOTIFY(105);

	if(queststate.item_gas_ballon == -1 || queststate.item_gas_ballon == -2 || queststate.quest_aes_password > 3) 
	{
		if(queststate.item_gas_ballon == -2) 
			queststate.item_gas_ballon = -3;
	
		//задаем анимацию на булера и волшебницу
		GAME_OBJECT * p_pers;
		LINK * p_obj;
		ANILINK* p_ani;
		
		p_obj = scene.FindObjectByName("magic");
		p_ani = p_obj->GetAniLink();
		p_pers =  p_obj;
		if(p_ani != NULL)
		p_ani->Delete();
		p_pers->CreateSkeletonAnimation("magic_lay.EZA", -1);	
	
		p_obj = scene.FindObjectByName("buller");
		p_ani = p_obj->GetAniLink();
		p_pers =  p_obj;
		if(p_ani != NULL)
		p_ani->Delete();
		p_pers->CreateSkeletonAnimation("buller_lay.EZA", -1);	
		
		if(queststate.item_gas_ballon == -2)
		{
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);
		
			p_obj = CreateGameObject(1,"scetch_odezhda.scv", position, size);		
			
			scene.Add(p_obj, 2);
		}
					
	}


	scene.SetCursorType(0);
}

