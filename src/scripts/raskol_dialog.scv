#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);

	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;

	}

	
	step = step + 1;
	
	//в зависимости от состояния квеста выбираем какой диалог выводить
	if(!queststate.quest_get_wear)	//пока не одет 
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("redlightdistr_raskolnikov_11", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_raskolnikov_11.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("raskol_rot.EZA", -1);	
		}
		if(step == 2) {	step = -1;}					
		
	}
	if(queststate.quest_get_wear && !(queststate.item_axe == 1))	//уже оделись, но топора еще нет
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("redlightdistr_anton_21", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_anton_21.ogg");	
			p_stream->Play(false);	p_stream->SetSync(0, self);	
			self->Attach(p_text);
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("redlightdistr_raskolnikov_22", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_raskolnikov_22.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("raskol_rot.EZA", -1);		
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("redlightdistr_anton_23", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_anton_23.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);		

		}
		if(step == 4) {
			p_text = TextWindowCreate("redlightdistr_raskolnikov_24", "font", position,size, 29, 2);
			p_stream = CreateStream("redlightdistr_raskolnikov_24.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);		
			p_guba = p_pers->CreateSkeletonAnimation("raskol_rot.EZA", -1);	
		}
		if(step == 5) {
			p_text = TextWindowCreate("redlightdistr_anton_25", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_anton_25.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 6) {	
			p_text = TextWindowCreate("redlightdistr_raskolnikov_26", "font", position,size, 29, 2);
			p_stream = CreateStream("redlightdistr_raskolnikov_26.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("raskol_rot.EZA", -1);	
		}
		if(step == 7) {	
			p_text = TextWindowCreate("redlightdistr_anton_27", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_anton_27.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 8) {	step = -1;	queststate.quest_talk_rask_axe = 1;		}					
		
	}
	if(queststate.item_axe == 1)	//принесли топор
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("redlightdistr_anton_31", "font", position,size, 29, 2);	
			p_stream = CreateStream("redlightdistr_anton_31.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	

//			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_rask_axe.scv", position, size);	
			scene.Add(p_obj, 2);
			

		}
		if(step == 2) {	step = -1;	
		//отдаем топор 
		queststate.item_axe = -1;			
		queststate.quest_get_bicycle = true;}					
		
	}
	
	
	if(step == -1)
	{
		//фоновая музыка
		GAME_OBJECT * p_snd;
	 
		p_snd = scene.FindObjectByName("sound_back");	
	
		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}

		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");

		LINK * p_obj = p_anton;	
		ANILINK* p_ani = p_obj->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();	//убиваем анимацию разговора, если она была

		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign( -3.2395, -2.1594,-22.6686);
		size.Assign( 70.6313,-80.9204,-160.8562);
		camera.PlaceCamera(36.6, position, size);
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		if(queststate.quest_get_bicycle)
		{
//			p_pers->CreateSkeletonAnimation("raskol_runaway.EZA", -1);		
			
			scene.DeleteObject(p_pers);
		}
		else
			p_pers->CreateSkeletonAnimation("raskol_idle.EZA", -1);	
		
	}					
	
	
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 20;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("raskolnikov");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("raskol_talk.EZA", -1);	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;

	p_ani = p_obj->GetAniLink();

	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);


	StepDialog();	
	
			
	position.Assign(-4.8255,-2.6313,-11.3651);
	size.Assign(131.1575,-79.3275,139.3373);
	camera.PlaceCamera(25, position, size);


	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

