void DRAW_MUZHIK()
{
	int scold;
	ANILINK * p_lnk;
	int newtime;

	SET_TRANP(p_link42, 0);
	SET_TRANP(p_link43, 0);
	SET_TRANP(p_link44, 0);
	SET_TRANP(p_link45, 0);
	SET_TRANP(p_link46, 0);
	SET_TRANP(p_link47, 0);
	
	if (muzhik==0) SET_TRANP(p_link42, 1);
	else if (muzhik==1) SET_TRANP(p_link43, 1);
	else if (muzhik==2) SET_TRANP(p_link44, 1);
	else if (muzhik==3) SET_TRANP(p_link45, 1);
	else if (muzhik==4) SET_TRANP(p_link46, 1);
	else if (muzhik==5) SET_TRANP(p_link47, 1);

	scold = score;	
	if (canabis1[5]==true) if (muzhik==0) {score+=1; canabis1[5]=false;}
	if (canabis2[4]==true) if (muzhik==1) {score+=1; canabis2[4]=false;}
	if (canabis3[3]==true) if (muzhik==2) {score+=1; canabis3[3]=false;}

	if (canabis4[5]==true) if (muzhik==5) {score+=1; canabis4[5]=false;}
	if (canabis5[4]==true) if (muzhik==4) {score+=1; canabis5[4]=false;}
	if (canabis6[3]==true) if (muzhik==3) {score+=1; canabis6[3]=false;}
	
	if (score!=scold)
	{
		if (score!=100) p_soundpoimal->Play(false);
		else
		{	 
			p_sound100->Play(false);
			//проходим игру
			queststate.quest_get_shiva = 1;
		}

		p_lnk = (ANILINK *)timer1;
		p_lnk->Delete();
		newtime = 100-score+50;
		if (newtime<40) newtime=40;
		timer1 = self->CreateTimer(newtime, -1);
		
		if ( score%6==1 ) 
		{
			throw_canabis-=1;
			if (throw_canabis<6) throw_canabis=6;
		}
	}


}


void DO_LIFE_LOSE()
{
	lives--;
	DRAW_LIFES();

	p_soundupal->Play(false);


}

void DRAW_LIFES()
{

	SET_TRANP(p_link54, 0);
	SET_TRANP(p_link55, 0);
	SET_TRANP(p_link56, 0);
	if (lives<=2) SET_TRANP(p_link54, 1);
	if (lives<=1) SET_TRANP(p_link55, 1);
	if (lives<=0) SET_TRANP(p_link56, 1);
}

void DRAW_LIFE_LOSE(int numhand)
{
	if (numhand==0) SET_TRANP(p_link48, 1);
	if (numhand==1) SET_TRANP(p_link49, 1);
	if (numhand==2) SET_TRANP(p_link50, 1);
	if (numhand==5) SET_TRANP(p_link51, 1);
	if (numhand==4) SET_TRANP(p_link52, 1);
	if (numhand==3) SET_TRANP(p_link53, 1);

/*
	canabis1[0]=canabis1[1]=canabis1[2]=canabis1[3]=canabis1[4]=canabis1[5]=false;
	canabis2[0]=canabis2[1]=canabis2[2]=canabis2[3]=canabis2[4]=false;
	canabis3[0]=canabis3[1]=canabis3[2]=canabis3[3]=false;
	canabis4[0]=canabis4[1]=canabis4[2]=canabis4[3]=canabis4[4]=canabis4[5]=false;
	canabis5[0]=canabis5[1]=canabis5[2]=canabis5[3]=canabis5[4]=false;
	canabis6[0]=canabis6[1]=canabis6[2]=canabis6[3]=false;
*/
}

void DO_FLY_CANABIS(int numhand)
{
	int f;
	int numcan1 = 0;
	int numcan2 = 0;
	int numcan3 = 0;
	int numcan4 = 0;
	int numcan5 = 0;
	int numcan6 = 0;
	for (f=5; f>=0; f--) numcan1+=canabis1[f];
	for (f=4; f>=0; f--) numcan2+=canabis2[f];
	for (f=3; f>=0; f--) numcan3+=canabis3[f];
	for (f=5; f>=0; f--) numcan4+=canabis4[f];
	for (f=4; f>=0; f--) numcan5+=canabis5[f];
	for (f=3; f>=0; f--) numcan6+=canabis6[f];


	bool b_lifelose = false;

	if (pause==0)
	{

	if (numhand==0)
	{
		if (canabis1[5]==true) b_lifelose = true;
		for (f=5; f>0; f--) canabis1[f]=canabis1[f-1];
		canabis1[0]=false;
		if (numcan1!=0) p_soundtick2->Play(false);
	}

	else if (numhand==1)
	{
		if (canabis2[4]==true) b_lifelose = true;
		for (f=4; f>0; f--) canabis2[f]=canabis2[f-1];		
		canabis2[0]=false;
		if (numcan2!=0) p_soundtick2->Play(false);
	}
	else if (numhand==2)
	{
		if (canabis3[3]==true) b_lifelose = true;
		for (f=3; f>0; f--) canabis3[f]=canabis3[f-1];		
		canabis3[0]=false;
		if (numcan3!=0) p_soundtick2->Play(false);
	}
	else if (numhand==3)
	{
		if (canabis4[5]==true) b_lifelose = true;
		for (f=5; f>0; f--) canabis4[f]=canabis4[f-1];		
		canabis4[0]=false;
		if (numcan4!=0) p_soundtick2->Play(false);
	}
	else if (numhand==4)
	{
		if (canabis5[4]==true) b_lifelose = true;
		for (f=4; f>0; f--) canabis5[f]=canabis5[f-1];
		canabis5[0]=false;
		if (numcan5!=0) p_soundtick2->Play(false);
	}
	else if (numhand==5)
	{
		if (canabis6[3]==true) b_lifelose = true;
		for (f=3; f>0; f--) canabis6[f]=canabis6[f-1];		
		canabis6[0]=false;
		if (numcan6!=0) p_soundtick2->Play(false);
	}

	}

	if (b_lifelose)
	{
		pause=15;
		DRAW_LIFE_LOSE(numhand);
		DO_LIFE_LOSE();
	}

}

void THROW_CANABIS(int numhand) // numhand : 0-5
{
	int nh, f, numcan, koef;

	numcan = 0;
	for (f=5; f>=0; f--) numcan+=canabis1[f];
	for (f=4; f>=0; f--) numcan+=canabis2[f];
	for (f=3; f>=0; f--) numcan+=canabis3[f];
	for (f=5; f>=0; f--) numcan+=canabis4[f];
	for (f=4; f>=0; f--) numcan+=canabis5[f];
	for (f=3; f>=0; f--) numcan+=canabis6[f];

	if ( (rand()%throw_canabis == 0)||(numcan==0) ) 
	{
		koef = 1;
		if(score>3) koef=2;
		if(score>20) koef=3;
		if(score>67) koef=4;
		if(score>86) koef=5;

		if (numcan<koef)
		{		
			if( (numhand==0)&&(canabis1[1]==false) ) { canabis1[0]=true; SET_HAND(numhand); }
			else if( (numhand==1)&&(canabis2[1]==false) ) { canabis2[0]=true; SET_HAND(numhand); }
			else if( (numhand==2)&&(canabis3[1]==false) ) { canabis3[0]=true; SET_HAND(numhand); }
			else if( (numhand==3)&&(canabis4[1]==false) ) { canabis4[0]=true; SET_HAND(numhand); }
			else if( (numhand==4)&&(canabis5[1]==false) ) { canabis5[0]=true; SET_HAND(numhand); }
			else if( (numhand==5)&&(canabis6[1]==false)&&(canabis1[0]==false) ) { canabis6[0]=true; SET_HAND(numhand); }
		}	
		DRAW_CANABIS();
	}

	nh = numhand+1;
	if(nh==6) nh=0;
	RESET_HAND(nh);

	
	

}

void ON_CREATE()
{

	p_soundtick1 = CreateStream("sound1.ogg");
	p_soundtick2 = CreateStream("sound1.ogg");
	p_soundpoimal= CreateStream("sound3.ogg");
	p_soundupal  = CreateStream("sound2.ogg");
	p_sound100   = CreateStream("sound4.ogg");

	CREATE_ITEMS();
	START_GAME();

	//создаем вечный таймер с периодом активации 0 мсек
//	timer1 = self->CreateTimer(150, -1);
	timer2 = self->CreateTimer(0, -1);
}


void ON_DESTROY()
{

	DeleteStream(p_soundtick1);	p_soundtick1=NULL;
	DeleteStream(p_soundtick2);	p_soundtick2=NULL;
	DeleteStream(p_soundpoimal);	p_soundpoimal=NULL;
	DeleteStream(p_soundupal);	p_soundupal=NULL;
	DeleteStream(p_sound100);	p_sound100=NULL;

}

void ON_TIME(int timernum)
{
	static bool keyy=false;
	static int sshet=4;

	if (keys[DIK_V]&&keys[DIK_Z]&&keys[DIK_L]&&keys[DIK_O])
	{
		score=99;
	}


	if (timernum==timer2)
	{
		if (keys[DIK_LEFT])
		{
			if (!keyy)
			{
				if (muzhik>0) {muzhik--;}
				SET_TRANP(p_button2, 1);
			}
			keyy = true;
		}
		else if (keys[DIK_RIGHT])
		{
			if (!keyy)
			{
				if (muzhik<5) {muzhik++;}
				SET_TRANP(p_button1, 1);
				
			}
			keyy = true;
		}
		else 
		{
			keyy=false;
			SET_TRANP(p_button1, 0);
			SET_TRANP(p_button2, 0);
		}
		DRAW_MUZHIK();
	}

	if (timernum==timer1)
	{	
		if (pause!=0) 
		{
			pause--;
			if (pause==0)
			{
				SET_TRANP(p_link48, 0);
				SET_TRANP(p_link49, 0);
				SET_TRANP(p_link50, 0);
				SET_TRANP(p_link51, 0);
				SET_TRANP(p_link52, 0);
				SET_TRANP(p_link53, 0);

				if (lives==0)
				{
					b_zastavka=true;
					START_GAME();
				}

			}
			return;
		}
		
		if (!b_zastavka)
		{
			thrownum++;
			if (thrownum==6) thrownum=0;
		
			DO_FLY_CANABIS(thrownum);
			THROW_CANABIS (thrownum);
			DRAW_CANABIS();
			DRAW_SCORE();
		}
		else
		{
			sshet--; if (sshet<0) sshet=10;
			
			if ( (sshet==6)||(sshet==1) )
			{
				SET_TRANP(p_link30, sshet%2);
				SET_TRANP(p_link31, (sshet+1)%2);
			
				SET_TRANP(p_link32, (sshet+1)%2);
				SET_TRANP(p_link33, sshet%2);

				SET_TRANP(p_link34, sshet%2);
				SET_TRANP(p_link35, (sshet+1)%2);

				SET_TRANP(p_link36, (sshet+1)%2);
				SET_TRANP(p_link37, sshet%2);

				SET_TRANP(p_link38, sshet%2);
				SET_TRANP(p_link39, (sshet+1)%2);

				SET_TRANP(p_link40, (sshet+1)%2);
				SET_TRANP(p_link41, sshet%2);
			}
		}
	}
}

void ON_NOTIFY(int param)
{
}

void ON_MOUSEOVER(vec3_t mousepos)
{
	vec3_t localpos;
	
	self->GetBonePosition(0,localpos);
	
	localpos.x = mousepos.x - localpos.x;
	localpos.y = mousepos.y - localpos.y;

	if( localpos.x > 750 && localpos.x <= 787 && localpos.y > 220 && localpos.y <= 240 )
	{
		SET_TRANP(p_button3, 0);
		b_startgame = true;
	}
	else
	{
		SET_TRANP(p_button3, 1);
		b_startgame = false;
	}

	if( localpos.x > 750 && localpos.x <= 787 && localpos.y > 275 && localpos.y <= 295 )
	{
		SET_TRANP(p_button4, 0);
		b_exitgame = true;
	}
	else
	{
		SET_TRANP(p_button4, 1);
		b_exitgame = false;
	}
}

void ON_LBUTTONDOWN()
{
	if (b_startgame) 
	{
		START_GAME(); 
		b_zastavka=false;
		SET_TRANP(p_link30, 1);
		SET_TRANP(p_link31, 0);
		SET_TRANP(p_link32, 1);
		SET_TRANP(p_link33, 0);
		SET_TRANP(p_link34, 1);
		SET_TRANP(p_link35, 0);
		SET_TRANP(p_link36, 1);
		SET_TRANP(p_link37, 0);
		SET_TRANP(p_link38, 1);
		SET_TRANP(p_link39, 0);
		SET_TRANP(p_link40, 1);
		SET_TRANP(p_link41, 0);
	}


	if (b_exitgame)// START_GAME(); // вместо START_GAME - функцию выхода из игры.
	{
		scene.DeleteObject(self);


	}


	b_startgame = false;
	b_exitgame = false;
}

