	if (canabis4[1]) SET_TRANP(p_link16, 1); else SET_TRANP(p_link16, 0);
	if (canabis4[2]) SET_TRANP(p_link17, 1); else SET_TRANP(p_link17, 0);
	if (canabis4[3]) SET_TRANP(p_link18, 1); else SET_TRANP(p_link18, 0);
	if (canabis4[4]) SET_TRANP(p_link19, 1); else SET_TRANP(p_link19, 0);
	if (canabis4[5]) SET_TRANP(p_link20, 1); else SET_TRANP(p_link20, 0);

