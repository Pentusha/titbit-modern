void DRAW_SCORE()
{
	int ch1,ch2,ch3;
	vec3_t pos;
	vec3_t size;
	vec3_t uvpos;
	vec3_t uvsize;
	

	if (p_score1!=NULL)  {p_score1->Delete(); p_score1=NULL;}
	if (p_score2!=NULL)  {p_score2->Delete(); p_score2=NULL;}
	if (p_score3!=NULL)  {p_score3->Delete(); p_score3=NULL;}
	
	ch1 = (score/100)%10;
	ch2 = (score/10)%10;
	ch3 = score%10;

	size.Assign(48,48,0);
	uvsize.Assign(0.0625,-0.0625,0);

	pos.Assign(340,268,0);
	uvpos.Assign(0.0625*ch1,0.75,0);
	p_score1 = CreateIFPlane(pos,size,uvpos,uvsize, "shiva.tga");
	self->Attach(p_score1);

	pos.Assign(354,268,0);
	uvpos.Assign(0.0625*ch2,0.75,0);
	p_score2 = CreateIFPlane(pos,size,uvpos,uvsize, "shiva.tga");
	self->Attach(p_score2);

	pos.Assign(368,268,0);
	uvpos.Assign(0.0625*ch3,0.75,0);
	p_score3 = CreateIFPlane(pos,size,uvpos,uvsize, "shiva.tga");
	self->Attach(p_score3);

}

void SET_TRANP(LINK * p_link, float tr)
{
	IFPlane * p_ipl = NULL;
	if( p_link != NULL )
	{
		p_ipl = (IFPlane *)p_link;
		p_ipl->transparency = tr;
	}
}

void START_GAME()
{
	score = 0;
	pause = 0;
	lives = 3;
	throw_canabis=29;

	canabis1[0]=canabis1[1]=canabis1[2]=canabis1[3]=canabis1[4]=canabis1[5]=false;
	canabis2[0]=canabis2[1]=canabis2[2]=canabis2[3]=canabis2[4]=false;
	canabis3[0]=canabis3[1]=canabis3[2]=canabis3[3]=false;
	canabis4[0]=canabis4[1]=canabis4[2]=canabis4[3]=canabis4[4]=canabis4[5]=false;
	canabis5[0]=canabis5[1]=canabis5[2]=canabis5[3]=canabis5[4]=false;
	canabis6[0]=canabis6[1]=canabis6[2]=canabis6[3]=false;

	DRAW_CANABIS();	
	DRAW_MUZHIK();
	DRAW_LIFES();

	SET_TRANP(p_link31, 0);
	SET_TRANP(p_link33, 0);
	SET_TRANP(p_link35, 0);
	SET_TRANP(p_link37, 0);
	SET_TRANP(p_link39, 0);
	SET_TRANP(p_link41, 0);

	SET_TRANP(p_link48, 0);
	SET_TRANP(p_link49, 0);
	SET_TRANP(p_link50, 0);
	SET_TRANP(p_link51, 0);
	SET_TRANP(p_link52, 0);
	SET_TRANP(p_link53, 0);

	SET_TRANP(p_button1, 0);

	ANILINK * p_lnk;
	if (timer1!=NULL)
	{
		p_lnk = (ANILINK *)timer1;
		p_lnk->Delete();
	}
	timer1 = self->CreateTimer(150, -1);
	
}

void SET_HAND(int numhand)
{
	if (numhand==0) { SET_TRANP(p_link30, 0); SET_TRANP(p_link31, 1);}
	if (numhand==1) { SET_TRANP(p_link32, 0); SET_TRANP(p_link33, 1);}
	if (numhand==2) { SET_TRANP(p_link34, 0); SET_TRANP(p_link35, 1);}
	if (numhand==3) { SET_TRANP(p_link36, 0); SET_TRANP(p_link37, 1);}
	if (numhand==4) { SET_TRANP(p_link38, 0); SET_TRANP(p_link39, 1);}
	if (numhand==5) { SET_TRANP(p_link40, 0); SET_TRANP(p_link41, 1);}
}
void RESET_HAND(int numhand)
{
	if (numhand==0) { SET_TRANP(p_link30, 1); SET_TRANP(p_link31, 0);}
	if (numhand==1) { SET_TRANP(p_link32, 1); SET_TRANP(p_link33, 0);}
	if (numhand==2) { SET_TRANP(p_link34, 1); SET_TRANP(p_link35, 0);}
	if (numhand==3) { SET_TRANP(p_link36, 1); SET_TRANP(p_link37, 0);}
	if (numhand==4) { SET_TRANP(p_link38, 1); SET_TRANP(p_link39, 0);}
	if (numhand==5) { SET_TRANP(p_link40, 1); SET_TRANP(p_link41, 0);}
}

void DRAW_CANABIS()
{

	if (canabis1[0]) SET_TRANP(p_link0, 1); else SET_TRANP(p_link0, 0);
	if (canabis1[1]) SET_TRANP(p_link1, 1); else SET_TRANP(p_link1, 0);
	if (canabis1[2]) SET_TRANP(p_link2, 1); else SET_TRANP(p_link2, 0);
	if (canabis1[3]) SET_TRANP(p_link3, 1); else SET_TRANP(p_link3, 0);
	if (canabis1[4]) SET_TRANP(p_link4, 1); else SET_TRANP(p_link4, 0);
	if (canabis1[5]) SET_TRANP(p_link5, 1); else SET_TRANP(p_link5, 0);

	if (canabis2[0]) SET_TRANP(p_link6, 1); else SET_TRANP(p_link6, 0);
	if (canabis2[1]) SET_TRANP(p_link7, 1); else SET_TRANP(p_link7, 0);
	if (canabis2[2]) SET_TRANP(p_link8, 1); else SET_TRANP(p_link8, 0);
	if (canabis2[3]) SET_TRANP(p_link9, 1); else SET_TRANP(p_link9, 0);
	if (canabis2[4]) SET_TRANP(p_link10, 1); else SET_TRANP(p_link10, 0);

	if (canabis3[0]) SET_TRANP(p_link11, 1); else SET_TRANP(p_link11, 0);
