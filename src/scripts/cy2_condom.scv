#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;


void ON_CREATE()
{
	
}

void ON_SETFOCUS()
{
	if (queststate.item_condom != 0)
		return;

	scene.SetCursorType(1);
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}

void ON_LBUTTONDOWN()
{
	if (queststate.item_condom != 0)
		return;
				
	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 104;
	scene.PostMessage(m);	
}
