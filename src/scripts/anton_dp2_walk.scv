#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_TIME;
export ON_DESTROY;

int nextanimation;
int lastanimation;

bool	talkutug = false;

void ON_DESTROY()
{
	GAME_OBJECT * p_tape;
	p_tape = scene.FindObjectByName("flash");
	if(p_tape != NULL)
	{ 
		scene.DeleteObject(p_tape);
	}
}

void ON_TIME(int timernum)
{
	GAME_OBJECT * p_tape;
	p_tape = scene.FindObjectByName("disko02kaseta");
	if(p_tape != NULL)
	{ 
		scene.DeleteObject(p_tape);


		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		scene.SetCursorType(0);
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_dance_tape.scv", position, size);	
		scene.Add(p_obj, 2);
	}
}

void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 5100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 35;
	
	lastanimation = self->CreateSkeletonAnimation("dp2_a_idle.EZA", 1);
	nextanimation = 1;

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		if(param == 101) // если нажали на выход
		{
			 nextanimation = -1;	//выход

		}
		if(param == 102) // если нажали на DJ
		{
			nextanimation = -2;	//dj
		}
		if(param == 103) // если нажали на касету
		{
			nextanimation = 2;	//касета
			queststate.item_dance_video = 1;
		}
	
	}
	else
	{
		
		
		if(nextanimation == -1)
		{	//выходим в на танцпол

			scene.Delete(3);
			scene.Load("club_disko01.XML");

		}
		if(nextanimation == -2)
		{	//говорим dj

			vec3_t position, size;	
			GAME_OBJECT * p_obj;

			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"dj_dialog.scv", position, size);

			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);

			scene.Add(p_obj, 2);

			nextanimation = 1;
		}
				
		
		if(nextanimation ==1)
		{
			lastanimation = self->CreateSkeletonAnimation("dp2_a_idle.EZA", 1);
		}
		if(nextanimation ==2)
		{
			self->CreateTimer(1300, 2);	
			lastanimation = self->CreateSkeletonAnimation("dp2_a_take.EZA", 1);
			nextanimation = 1;
		}	



	}	
}
