#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;


void ON_SETFOCUS()
{
	if(!(queststate.item_gas_ballon == -1 || queststate.item_gas_ballon == -2 || queststate.quest_aes_password > 3))
	{
	if(queststate.typepr == 15)
		scene.SetCursorType(1);	
	else
		scene.SetCursorType(4);	
	

	}
		
}

void ON_KILLFOCUS()
{

	if(!(queststate.item_gas_ballon == -1 || queststate.item_gas_ballon == -2 || queststate.quest_aes_password > 3))
	scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	if((queststate.item_gas_ballon == -1 || queststate.item_gas_ballon == -2 || queststate.quest_aes_password > 3))
		return;

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 105;
	scene.PostMessage(m);





}

