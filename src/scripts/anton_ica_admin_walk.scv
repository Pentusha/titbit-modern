#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int nextanimation;
int lastanimation;


void ON_DESTROY()
{
	GAME_OBJECT * p_tape;
	p_tape = scene.FindObjectByName("flash");
	if(p_tape != NULL)
	{ 
		scene.DeleteObject(p_tape);
	}
}



void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;

	queststate.item_kalendarik = -1;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		
		if(queststate.quest_cut_electric_wire == 1)
		m.lparam = 17100;
		else
		m.lparam = 1100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 25;
		
	if (queststate.lastlocation==26)
	{
		lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_idle.EZA", 1);
		nextanimation = 12;
	}
	if (queststate.lastlocation==27)
	{
		lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_idle.EZA", 1);
		nextanimation = 4;
	}
//	if (queststate.lastlocation==34)
	if (queststate.lastlocation !=27 && queststate.lastlocation !=26)
	{
		lastanimation = self->CreateSkeletonAnimation("ica_a_enter.EZA", 1);
		nextanimation = 1;	
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation &&  param!= 200)	// 200 обозначает окончание диалога
	{
		if (nextanimation < 0) return;

//		WriteLog("Notify");

		if(param == 101) // если нажали идти к Офелии
		{
			if(nextanimation == 2) nextanimation = 204;
			if(nextanimation == 12) nextanimation = 1204;
			if(nextanimation == 4) nextanimation = -4;   // от офелии
		}

		if(param == 102) // если нажали идти к Хакеру и Мегакиле
		{
			if(nextanimation == 2) nextanimation = 212;
			if(nextanimation == 4) nextanimation = 412;
			if(nextanimation == 12) nextanimation = -12; // от хакера
		}

		if(param == 103) // если нажали на беломор
		{
			if(nextanimation == 2) nextanimation = -32;   // от админа
			if(nextanimation == 4) nextanimation = 3402;   // от офелии
			if(nextanimation == 12) nextanimation = 31202; // от хакера
		}
		if(param == 105) // нажали идти к Админу
		{
			if(nextanimation == 4) nextanimation = 402; 	// от офелии
			if(nextanimation == 12) nextanimation = 1202; 	// от хакера
			if(nextanimation == 2) nextanimation = -2;   	// от админа
		}
		
		if(param == 106) // если нажали на выход
		{
			if(nextanimation == 4) nextanimation = 400;
			if(nextanimation == 2) nextanimation =-1000;
			if(nextanimation == 12) nextanimation = 1200;
		}

	
		if(param == 104) // если нажали на журналы
		{
			if(nextanimation == 2) nextanimation = -42;   // от админа
			if(nextanimation == 4) nextanimation = 4402;   // от офелии
			if(nextanimation == 12) nextanimation = 41202; // от хакера
		}
		if(param == 107) // если нажали на журналы
		{
			if(nextanimation == 2) nextanimation = -52;   // от админа
			if(nextanimation == 4) nextanimation = 5402;   // от офелии
			if(nextanimation == 12) nextanimation = 51202; // от хакера
		}		
	}
	else
	{		
	

		if(nextanimation == 1) 
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = 2;
		}
		if(nextanimation == 2 || nextanimation == 200) lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
		if(nextanimation == 4) lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_idle.EZA", 1);
		if(nextanimation ==12) lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_idle.EZA", 1);

		if(nextanimation == -4)
		{
			// Здесь загрузка сцены с Офелией
			scene.Delete(3);//удаляем все не интерфейсные объекты
			scene.Load("icafe_ofelia.XML");
		}

		if(nextanimation == -2)
		{
			//разговор с админом
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0, 600, -80);
			size.Assign(1024,768,0);
			
			p_obj = CreateGameObject(1,"admin_dialog.scv", position, size);
			
			position.Assign(512, -216, 0);
			p_obj->SetBoneCenter(0,position);
			
			scene.Add(p_obj, 2);

			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = 2;
		}

		if(nextanimation == -12)
		{
			// Здесь загрузка сцены хакер/мегакила
			// {
				scene.Delete(3);//удаляем все не интерфейсные объекты
				scene.Load("icafe_hacker.XML");

			// }

		}

		if(nextanimation == -1000)
		{

			// Здесь выход
			// {
			// }
			
			if(queststate.item_listenning_device != 0)
			{
				//ресивер украли провод можно чинить
				queststate.quest_cut_electric_wire = 2;
			}	

			scene.Delete(3);
			scene.Load("map.XML"); // здесь должны грузить локацию "карта"
			return;
		}

		if(nextanimation == -32)
		{
			// Здесь берем беломор
			

			queststate.item_belomor = 1;
			GAME_OBJECT * p_item = NULL;
			p_item = scene.FindObjectByName("cafe_belamor");
			if(p_item != NULL)
			{ 		
			scene.DeleteObject(p_item);
			}
			queststate.typepr = 0;
			scene.SetCursorType(0);
			
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = 2;
			return;
		}
		if(nextanimation == -42)
		{
			// Здесь смотрим журнал 1
			// {
			vec3_t position, size, uvposition, uvsize;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0,0, -80);
			size.Assign(1024,768,0);
			uvposition.Assign(0,1,0);
			uvsize.Assign(1,-0.75,0);
			scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "xaker.jpg", "close.scv");
			
			// }
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = 2;
		}
		if(nextanimation == -52)
		{
			// Здесь смотрим журнал 2
			// {
			vec3_t position, size, uvposition, uvsize;	
			GAME_OBJECT * p_obj;
			
			position.Assign(0,0, -80);
			size.Assign(1024,768,0);
			uvposition.Assign(0,1,0);
			uvsize.Assign(1,-0.75,0);
			scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "strana_igr.jpg", "close.scv");
			
			// }
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = 2;
		}


		if(nextanimation == 204)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_ofel.EZA", 1);
			nextanimation = -4;
		}

		if(nextanimation == 212)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_hacker.EZA", 1);
			nextanimation = -12;
		}

		if(nextanimation == 1204)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_ofel.EZA", 1);
			nextanimation = -4;
		}

		if(nextanimation == 1202)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_admin.EZA", 1);
			nextanimation = -2;
		}

		if(nextanimation == 402)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_admin.EZA", 1);
			nextanimation = -2;
		}

		if(nextanimation == 412)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_hacker.EZA", 1);
			nextanimation = -12;
		}

		if(nextanimation == 400)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_exit.EZA", 1);
			nextanimation = -1000;
		}
		if(nextanimation == 1200)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_exit.EZA", 1);
			nextanimation = -1000;
		}




		if(nextanimation == 31202)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_admin.EZA", 1);
			nextanimation = -32;
		}
		if(nextanimation == 3402)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_admin.EZA", 1);
			nextanimation = -32;
		}
		if(nextanimation == 3002)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = -32;
		}



		if(nextanimation == 41202)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_admin.EZA", 1);
			nextanimation = -42;
		}
		if(nextanimation == 4402)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_admin.EZA", 1);
			nextanimation = -42;
		}
	



		if(nextanimation == 51202)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_hacker_admin.EZA", 1);
			nextanimation = -52;
		}
		if(nextanimation == 5402)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_ofel_admin.EZA", 1);
			nextanimation = -52;
		}
		if(nextanimation == 5002)
		{
			lastanimation = self->CreateSkeletonAnimation("ica_a_adm_idle.EZA", 1);
			nextanimation = -52;
		}

	}	
}
