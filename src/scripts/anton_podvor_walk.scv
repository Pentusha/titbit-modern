#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;

bool hitdiler = false;
STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void Dialog(char * dialogname)
{
	vec3_t position, size;	
	GAME_OBJECT * p_obj;

	position.Assign(0, 600, -80);
	size.Assign(1024,768,0);

	p_obj = CreateGameObject(1,dialogname, position, size);

	position.Assign(512, -216, 0);
	p_obj->SetBoneCenter(0,position);

	scene.Add(p_obj, 2);
	

}



void ON_CREATE()
{ 

	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 7100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 18;
	
	
	lastanimation = self->CreateSkeletonAnimation("pod_a_exit_idle.EZA", 2);
		nextanimation = 1;
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;
		

		if(queststate.typepr != 0)
		{
			if(queststate.typepr == 34 && param == 103)
			{		
			}
			else if(queststate.typepr == 14 && param == 105)
			{
			}
			else if(queststate.typepr == 39 && queststate.item_condom == 2 && param == 107)
			{
			}
			else
			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
					p_stream = CreateStream("comment_anton_2.ogg");
					p_stream->Play(false);	
				return;
			}
		}


		if(param == 101) // если нажали идти к выходу
		{
			if(nextanimation == 1) nextanimation = -1;	//выход
			if(nextanimation == 2) nextanimation = 9;	//монтировка/биомеханник
			if(nextanimation == 3) nextanimation = 5;	//дилер
			if(nextanimation == 10) nextanimation = 14;	//пластинка/провод
			if(nextanimation == 12) nextanimation = 24;	//гигагерц	

		}
		if(param == 102) // если нажали идти к монтировке
		{
			if(nextanimation == 1) nextanimation = 8;
//			if(nextanimation == 2) nextanimation = -2;	
			if(nextanimation == 3) nextanimation = 6;

		}
		if(param == 103) // если нажали идти к дилеру
		{

			//проверяем, нет ли монтировки в руке 
			if(queststate.typepr == 34)
			{
				hitdiler = true;	//помечаем, что впереди не разговор
			}
		
			if(nextanimation == 1) nextanimation = 4;
			if(nextanimation == 2) nextanimation = 7;
			if(nextanimation == 3) nextanimation = -3;
			
		}
		if(param == 108) // если нажали идти к обойме + 30
		{
			if(nextanimation == 1) nextanimation = 34;
			if(nextanimation == 2) nextanimation = 37;
			if(nextanimation == 3) nextanimation = -33;
		}


		if(param == 104) // если нажали идти к пластинке
		{
			if(nextanimation == 1) nextanimation = 13;
			if(nextanimation == 2) nextanimation = 16;
			if(nextanimation == 10) nextanimation = -10;
			if(nextanimation == 12) nextanimation = 20;			
		}

		if(param == 105) // если нажали идти к проводу +30
		{
			//проверяем одета ли перчатка  и был ли разговор с роботом о титбите
			if(queststate.typepr == 14 && queststate.item_plastic == -1)
			{

				if(nextanimation == 1) nextanimation = 43;
				if(nextanimation == 2) nextanimation = 46;
				if(nextanimation == 10) nextanimation = -40;
				if(nextanimation == 12) nextanimation = 50;		
			}		
			else	//сообщаем, что игрок идиот
			{
				if(p_stream != NULL)
				{
					p_stream->Stop(); 	
					DeleteStream(p_stream);
					p_stream = NULL;
				}
					p_stream = CreateStream("comment_anton_3.ogg");
					p_stream->Play(false);	
//					queststate.typepr = 0;		
			}

		}
		if(param == 106) // если нажали идти к биомеханнику 
		{
			if(queststate.item_titbit == 0)	//можем разговаривать пока не отдал титбит
			{
				if(nextanimation == 1) nextanimation = 21;
				if(nextanimation == 2) nextanimation = -11;
				if(nextanimation == 10) nextanimation = 15;
				if(nextanimation == 12) nextanimation = 18;			
			}
		}

		if(param == 107) // если нажали идти к гигагерцу 
		{
			if(queststate.typepr == 39 && queststate.item_condom == 2)	//в руке презерватив наполненый водой
			{

				if(nextanimation == 1) nextanimation = 23;
				if(nextanimation == 2) nextanimation = 17;
				if(nextanimation == 10) nextanimation = 19;
				if(nextanimation == 12) nextanimation = -12;			

			}
			
		}


	}
	else
	{
		
//		WriteLog("animation finished");


		if(nextanimation == -1)
		{
			scene.Delete(3);

			if(queststate.item_tualet_paper != -1)
			{
				scene.Load("sumerki_entrance.XML");
			}
			else
			{
				scene.Load("sumerki_entrance2.XML");
			}
			return;

//			nextanimation = 1;

		}
		if(nextanimation == -2)
		{
			//берем монтировку
			nextanimation = 2;
			queststate.item_mount = 1;
			
			GAME_OBJECT * p_mont;
			p_mont = scene.FindObjectByName("podvorotniaMontirovka");
			scene.DeleteObject(p_mont);		

			//показываем скетч

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			scene.SetCursorType(0);
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_mount.scv", position, size);	
			scene.Add(p_obj, 2);
	

		}
		if(nextanimation == -3)
		{
			nextanimation = 3;

			if(hitdiler)
			{
				//бъем дилера по голове монтировкой
				queststate.item_mount = -1;
				queststate.typepr = 0;
				scene.SetCursorType(0);

				queststate.item_club_card = 1;		
				queststate.item_bullets = 1;
	
				GAME_OBJECT * p_pers;
				LINK * p_obj;
				p_obj = scene.FindObjectByName("diler");
				p_pers = p_obj;
				ANILINK* p_ani = p_obj->GetAniLink();
	
			
				if(p_ani != NULL)	
					p_ani->Delete();
					p_pers->CreateSkeletonAnimation("diler_lay.EZA", -1);


				//показываем скетч
				vec3_t position, size;	
				GAME_OBJECT * p_obj;
	
				queststate.typepr = 0;
				position.Assign(0, 0, -80);	
				size.Assign(1024,768,0);

				p_obj = CreateGameObject(1,"scetch_kill_diler.scv", position, size);	
				scene.Add(p_obj, 2);

			}
			else
			{
				//общаемся с дилером
				
				Dialog("diler_dialog.scv");
			}


		}
		if(nextanimation == -33)
		{
			//берем обойму
			queststate.item_bullets = 1;

			nextanimation = 3;

		}
		if(nextanimation == -10)
		{
			//берем пластинку
			nextanimation = 10;
			queststate.item_disk_piece = (queststate.item_disk_piece | 1); 


			GAME_OBJECT * p_plast;
			p_plast = scene.FindObjectByName("podvorotniaPlastinka");
			scene.DeleteObject(p_plast);	
		
			queststate.typepr = 0;
			scene.SetCursorType(0);	

			//показываем скетч

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_plast.scv", position, size);	
			scene.Add(p_obj, 2);

		}
		if(nextanimation == -40)
		{
			//берем используем провод
			queststate.item_rubber_glove = -1;

			queststate.item_plastic = -2;	
			
			nextanimation = 10;

			queststate.typepr = 0;
			scene.SetCursorType(0);

			//показываем скетч
			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_kill_bio.scv", position, size);	
			scene.Add(p_obj, 2);

			GAME_OBJECT * p_pers;
			LINK * p_lobj;
			p_lobj = scene.FindObjectByName("biomech");
			p_pers = p_lobj;
			ANILINK* p_ani = p_lobj->GetAniLink();

			
			if(p_ani != NULL)	
				p_ani->Delete();
			p_pers->CreateSkeletonAnimation("biomech_lay.EZA", -1);
	
			LINK* p_lnk = p_lobj->GetChild();
			p_lnk->Delete();

		}
		if(nextanimation == -11)
		{
			//общаемся с биомеханником
			
			Dialog("biomech_dialog.scv");

			nextanimation = 2;

		}
		if(nextanimation == -12)
		{
			//вырубаем гигагерца
			nextanimation = 12;
	
			queststate.item_condom = -1;
			queststate.item_saw_benzo = 1;

			queststate.typepr = 0;
			scene.SetCursorType(0);

			//показываем скетч

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_kill_giga.scv", position, size);	
			scene.Add(p_obj, 2);

			GAME_OBJECT * p_pers;
			LINK * p_lobj;
			p_lobj = scene.FindObjectByName("gigahertz");
			p_pers = p_lobj;
			ANILINK* p_ani = p_lobj->GetAniLink();

			
			if(p_ani != NULL)	
				p_ani->Delete();
			p_pers->CreateSkeletonAnimation("giga_lay.EZA", -1);
	
			LINK* p_lnk = p_lobj->GetChild();
			p_lnk->Delete();
			p_lnk = p_lobj->GetChild();
			p_lnk->Delete();
			

		}


		if(nextanimation == 1) lastanimation = self->CreateSkeletonAnimation("pod_a_exit_idle.EZA", 1);
		if(nextanimation == 2) lastanimation = self->CreateSkeletonAnimation("pod_a_mont_idle.EZA", 1);
		if(nextanimation == 3) lastanimation = self->CreateSkeletonAnimation("pod_a_diler_idle.EZA", 1);
		if(nextanimation == 10) lastanimation = self->CreateSkeletonAnimation("pod_a_plast_idle.EZA", 1);
		if(nextanimation == 12) lastanimation = self->CreateSkeletonAnimation("pod_a_giga_idle.EZA", 1);

		////////////////////////////////
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_diler.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 34)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_diler.EZA", 1);
			nextanimation = -33;
		}
		if(nextanimation == 5)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_diler_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 6)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_diler_mont.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 7)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_mont_diler.EZA", 1);
			nextanimation = -3;
		}
		if(nextanimation == 37)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_mont_diler.EZA", 1);
			nextanimation = -33;
		}

		if(nextanimation == 8)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_mont.EZA", 1);
			nextanimation = -2;
		}
		if(nextanimation == 9)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_mont_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 21)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_mont.EZA", 1);
			nextanimation = -11;
		}
		if(nextanimation == 22)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_mont_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 13)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_plast.EZA", 1);
			nextanimation = -10;
		}

		if(nextanimation == 43)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_plast.EZA", 1);
			nextanimation = -40;
		}

		if(nextanimation == 14)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_plast_exit.EZA", 1);
			nextanimation = -1;
		}
		if(nextanimation == 15)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_plast_bio.EZA", 1);
			nextanimation = -11;
		}
		if(nextanimation == 16)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_bio_plast.EZA", 1);
			nextanimation = -10;
		}		
		if(nextanimation == 46)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_bio_plast.EZA", 1);
			nextanimation = -40;
		}		

		if(nextanimation == 17)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_bio_giga.EZA", 1);
			nextanimation = -12;
		}		
		if(nextanimation == 18)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_giga_bio.EZA", 1);
			nextanimation = -11;
		}		
		if(nextanimation == 19)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_plast_giga.EZA", 1);
			nextanimation = -12;
		}		
		if(nextanimation == 20)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_giga_plast.EZA", 1);
			nextanimation = -10;
		}
		if(nextanimation == 50)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_giga_plast.EZA", 1);
			nextanimation = -40;
		}

		if(nextanimation == 23)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_exit_giga.EZA", 1);
			nextanimation = -12;
		}
		if(nextanimation == 24)
		{
			lastanimation = self->CreateSkeletonAnimation("pod_a_giga_exit.EZA", 1);
			nextanimation = -1;
		}




	}	
}
