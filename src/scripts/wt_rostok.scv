#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_NOTIFY;


void ON_NOTIFY(int param)
{
	vec3_t pos;
	pos.Assign(9.2782,-2.4563,4.8188);
	//возвращаем росток на его законное место
	self->SetBonePosition(0, pos);
	
}

void ON_CREATE()
{
	//переставляем росток, чтобы не мозолил глаза

	vec3_t pos;
	pos.Assign(-10000,0,-10000);

	if(queststate.item_piece_of_shit != -1)
		self->SetBonePosition(0, pos);

}

void ON_SETFOCUS()
{
	if(queststate.item_piece_of_shit == -1)
		scene.SetCursorType(6);
	
}

void ON_KILLFOCUS()
{

	if(queststate.item_piece_of_shit == -1)
		scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	if(queststate.item_piece_of_shit == -1)
	{
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 102;
		scene.PostMessage(m);
	}

}
