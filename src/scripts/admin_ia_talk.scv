#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

int dialognum = 1;

void ON_SETFOCUS()
{

	if(queststate.quest_cut_electric_wire != 1)
	scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	if(queststate.quest_cut_electric_wire != 1)
	scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	if(queststate.quest_cut_electric_wire == 1)
		return;

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 105;
	scene.PostMessage(m);

}

