#include scener
#include queststate


export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_SETFOCUS()
{
	scene.SetCursorType(1);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}


void ON_LBUTTONDOWN()
{
	
	scene.DeleteObject(self);
	
	queststate.quest_atom_chem++;

	if(queststate.quest_atom_chem == 5 )
	{
		//победа
		scene.Delete(3);
		scene.Load("happyend.xml");
	}

}
