#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;


LINK * p_obj= NULL;

void ON_CREATE()
{
	if( queststate.porno_disk)
	{
		scene.DeleteObject(self);	
	}
	
}

void ON_SETFOCUS()
{
	scene.SetCursorType(3);		
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}


void ON_LBUTTONDOWN()
{
	queststate.item_porno_disk = 1;
	scene.DeleteObject(self);

}


