#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{


}

void ON_SETFOCUS()
{
	if(queststate.item_rubber_glove != -1)
		scene.SetCursorType(1);
	
}

void ON_KILLFOCUS()
{

	if(queststate.item_rubber_glove != -1)
		scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{

	if(queststate.item_rubber_glove == -1)
		return;

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 105;
	scene.PostMessage(m);

}
