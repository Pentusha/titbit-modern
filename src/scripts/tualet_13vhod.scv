#include scener
#include queststate


export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;


LINK * p_obj= NULL;

void ON_CREATE()
{ 
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 13;
	scene.SetCursorType(0);
}


void ON_SETFOCUS()
{
	scene.SetCursorType(6);

		
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);



}


void ON_LBUTTONDOWN()
{

	scene.Delete(3);//удаляем все не интерфейсные объекты
	scene.Load("kv13_vhod.XML");

}
