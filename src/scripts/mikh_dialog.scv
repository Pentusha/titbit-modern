#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	if(queststate.item_basement_key != 0)
	{
		step = -1;	//если получен ключ от Михалыча, то говорить больше не о чем
	}
	if(!queststate.quest_broke_window)	
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("flat13mikh_anton_11", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_11.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);		
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_12", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_12.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
		}
		if(step == 3) {	step = -1;	}					
	}
	
	if(queststate.quest_broke_window && !queststate.quest_check_bachok)
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("flat13mikh_anton_21", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_21.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_22", "font", position,size, 29, 2);
			p_stream = CreateStream("flat13mikh_mikhalych_22.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("flat13mikh_anton_23", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_23.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
		}
		if(step == 4) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_24", "font", position,size, 29, 2);
			p_stream = CreateStream("flat13mikh_mikhalych_24.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);			}
		if(step == 5) 
		{
			p_text = TextWindowCreate("flat13mikh_anton_25", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_25.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 6) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_26", "font", position,size, 29, 2);
			p_stream = CreateStream("flat13mikh_mikhalych_26.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
		}
		if(step == 7) {	step = -1; queststate.quest_wake_alien = 1;}					
	}
	
	if(queststate.quest_check_bachok && (queststate.item_merry_shiva == 0))
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("flat13mikh_anton_31", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_31.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_32", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_32.ogg");	p_stream->Play(false);
			p_stream->SetSync(0, self);	self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
		}
		if(step == 3) 
		{
			p_text = TextWindowCreate("flat13mikh_anton_33", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_anton_33.ogg");	p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 4)
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_34", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_34.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	

//			vec3_t position, size;	
			GAME_OBJECT * p_obj;

			position.Assign(0, 0, -80);
			size.Assign(1024,768,0);
			p_obj = CreateGameObject(1,"scetch_shiva1.scv", position, size);
		
			scene.Add(p_obj, 2);


		}
		if(step == 5) {	step = -1;	queststate.item_merry_shiva = 1;}	//михалыч дает игру				
	}	
	if(queststate.item_merry_shiva == 1 && !queststate.quest_get_shiva)	//еще не набрали 100 очков
	{	
		if(step == 1) 
		{
			p_text = TextWindowCreate("flat13mikh_mikhalych_41", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_41.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("flat13mikh_anton_42", "font", position,size, 29, 2);
			p_stream = CreateStream("flat13mikh_anton_42.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_43", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_43.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	

	}
		if(step == 4) {	step = -1;	}								
	}
	
	
	
	if(queststate.item_merry_shiva == 1 && queststate.quest_get_shiva)	//набрали 100 очков
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_51", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_51.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);

			GAME_OBJECT * p_obj;

			position.Assign(0, 0, -80);
			size.Assign(1024,768,0);
			p_obj = CreateGameObject(1,"scetch_shiva2.scv", position, size);
		
			scene.Add(p_obj, 2);	
		}
		if(step == 2) 
		{	
			p_text = TextWindowCreate("flat13mikh_anton_52", "font", position,size, 29, 2);
			p_stream = CreateStream("flat13mikh_anton_52.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 3) 
		{	
			p_text = TextWindowCreate("flat13mikh_mikhalych_53", "font", position,size, 29, 2);	
			p_stream = CreateStream("flat13mikh_mikhalych_53.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("mikhalych_rot.EZA", -1);	
	

			GAME_OBJECT * p_obj;

			position.Assign(0, 0, -80);
			size.Assign(1024,768,0);
			p_obj = CreateGameObject(1,"scetch_basement_key.scv", position, size);
		
			scene.Add(p_obj, 2);	

	}
		if(step == 4) 
		{
			step = -1;	queststate.item_merry_shiva = -1;
			queststate.item_basement_key = 1;
		}					
		
	}		
	
	
	
	if(step == -1)
	{
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 100;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign(-1.791183,-1.173162,-3.321996);
		size.Assign(-90.2003,5.909,-0.0206);
		camera.PlaceCamera(30, position, size);
		
		
		if(queststate.quest_broke_window)
		{
			LINK * p_link = p_pers;
			ANILINK* p_ani = p_link->GetAniLink();
			if(p_ani != NULL)
				p_ani->Delete();
			if(queststate.quest_broke_window)
				p_pers->CreateSkeletonAnimation("mikhalych_idle2.EZA", -1);
		}	
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("mikh");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	if(queststate.quest_broke_window)
	{
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("mikhalych_talk.EZA", -1);	
	}
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	//	queststate.quest_broke_window = true;
	//	queststate.quest_check_bachok = true;
	//	queststate.quest_get_shiva = false;
	
	StepDialog();	
	
	if(queststate.quest_broke_window)
	{
		position.Assign(-1.7912,-1.1732,-3.322);
		size.Assign(-90.2003,5.909,-0.0206);
		camera.PlaceCamera(10, position, size);
		
		
	}
	else
	{
		position.Assign(-1.8342,-0.9365,-2.4122);
		size.Assign(-86.188,4.3993,0.2929);
		camera.PlaceCamera(8, position, size);
		
	}
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

