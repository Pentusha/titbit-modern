void CreateShots()
{
	vec3_t pos;
	vec3_t size;
	vec3_t uvpos;
	vec3_t uvsize;

	qst = queststate;

	size.Assign(128,96,0);

	uvpos.Assign(0,1,0);
	uvsize.Assign(1,-1,0);

	if ( queststate.LoadGame("slot1.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+0,0);
	p_link1 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link1);

	if ( queststate.LoadGame("slot2.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+128,0);
	p_link2 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link2);

	if ( queststate.LoadGame("slot3.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+256,0);
	p_link3 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link3);

	if ( queststate.LoadGame("slot4.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+384,0);
	p_link4 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link4);

	if ( queststate.LoadGame("slot5.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+512,0);
	p_link5 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link5);

	if ( queststate.LoadGame("slot6.sav") ) GetShotName(); else strcpy (shotname, "empty.jpg");
	pos.Assign(800,kfs+640,0);
	p_link6 = CreateIFPlane(pos,size,uvpos,uvsize, shotname);
	self->Attach(p_link6);

	queststate = qst;
}

void ReSizeTexts()
{

	vec3_t scale;

	scale.Assign(sizetxt1,sizetxt1,sizetxt1);
	p_save1->SetBoneScale(0, scale);
	scale.Assign(sizetxt2,sizetxt2,sizetxt2);
	p_save2->SetBoneScale(0, scale);
	scale.Assign(sizetxt3,sizetxt3,sizetxt3);
	p_save3->SetBoneScale(0, scale);
	scale.Assign(sizetxt4,sizetxt4,sizetxt4);
	p_save4->SetBoneScale(0, scale);
	scale.Assign(sizetxt5,sizetxt5,sizetxt5);
	p_save5->SetBoneScale(0, scale);
	scale.Assign(sizetxt6,sizetxt6,sizetxt6);
	p_save6->SetBoneScale(0, scale);


}

void ON_CREATE()
{
	vec3_t pos;
	vec3_t size;
	vec3_t uvpos;
	vec3_t uvsize;

	pos.Assign(0,10,0);
	size.Assign(80,748,0);
	uvpos.Assign(0,0.6875,0);
	uvsize.Assign(0.0625,-0.625,0);
	p_savepic = CreateIFPlane(pos,size,uvpos,uvsize, "items.tga");
	self->Attach(p_savepic);


	CreateSaveMenu();
	qst = queststate;

	if ( queststate.LoadGame("slot1.sav") ) strcpy (fname1, queststate.time);
	else strcpy (fname1, "empty");

	if ( queststate.LoadGame("slot2.sav") ) strcpy (fname2, queststate.time);
	else strcpy (fname2, "empty");

	if ( queststate.LoadGame("slot3.sav") ) strcpy (fname3, queststate.time);
	else strcpy (fname3, "empty");

	if ( queststate.LoadGame("slot4.sav") ) strcpy (fname4, queststate.time);
	else strcpy (fname4, "empty");

	if ( queststate.LoadGame("slot5.sav") ) strcpy (fname5, queststate.time);
	else strcpy (fname5, "empty");

	if ( queststate.LoadGame("slot6.sav") ) strcpy (fname6, queststate.time);
	else strcpy (fname6, "empty");

	queststate = qst;

	if (p_save1==NULL) p_save1 = scene.CreateTextWindow(self, fname1, 200, kf+0, 510, 100, 60, 0, "");
	if (p_save2==NULL) p_save2 = scene.CreateTextWindow(self, fname2, 200, kf+128, 510, 100, 60, 0, "");
	if (p_save3==NULL) p_save3 = scene.CreateTextWindow(self, fname3, 200, kf+256, 510, 100, 60, 0, "");
	if (p_save4==NULL) p_save4 = scene.CreateTextWindow(self, fname4, 200, kf+384, 510, 100, 60, 0, "");
	if (p_save5==NULL) p_save5 = scene.CreateTextWindow(self, fname5, 200, kf+512, 510, 100, 60, 0, "");
	if (p_save6==NULL) p_save6 = scene.CreateTextWindow(self, fname6, 200, kf+640, 510, 100, 60, 0, "");


	ReSizeTexts();

	CreateShots();

}

void ON_MOUSEOVER(vec3_t mousepos)
{
	float speedscale = 0.08;
	float speedscale2 = speedscale*0.5;

	sizetxt1 -= speedscale2; if (sizetxt1<1) sizetxt1=1; SET_TRANP(p_link1,0.5);
	sizetxt2 -= speedscale2; if (sizetxt2<1) sizetxt2=1; SET_TRANP(p_link2,0.5);
	sizetxt3 -= speedscale2; if (sizetxt3<1) sizetxt3=1; SET_TRANP(p_link3,0.5);
	sizetxt4 -= speedscale2; if (sizetxt4<1) sizetxt4=1; SET_TRANP(p_link4,0.5);
	sizetxt5 -= speedscale2; if (sizetxt5<1) sizetxt5=1; SET_TRANP(p_link5,0.5);
	sizetxt6 -= speedscale2; if (sizetxt6<1) sizetxt6=1; SET_TRANP(p_link6,0.5);

	if(mousepos.x < 130)
	{
		slotnum = -1;
		scene.SetCursorType(6);
		return;
	}
	scene.SetCursorType(0);

	if(mousepos.y >= 0 && mousepos.y < 128)
	{
		sizetxt1+=speedscale; if (sizetxt1>1.3) sizetxt1=1.3;
		ReSizeTexts();
		SET_TRANP(p_link1,1);
		slotnum = 1;
	}
	else if(mousepos.y >= 128 && mousepos.y < 256)
	{
		sizetxt2+=speedscale; if (sizetxt2>1.3) sizetxt2=1.3;
		ReSizeTexts();
		SET_TRANP(p_link2,1);
		slotnum = 2;
	}
	else if(mousepos.y >= 256 && mousepos.y < 384)
	{
		sizetxt3+=speedscale; if (sizetxt3>1.3) sizetxt3=1.3;
		ReSizeTexts();
		SET_TRANP(p_link3,1);
		slotnum = 3;
	}
	else if(mousepos.y >= 384 && mousepos.y < 512)
	{
		sizetxt4+=speedscale; if (sizetxt4>1.3) sizetxt4=1.3;
		ReSizeTexts();
		SET_TRANP(p_link4,1);
		slotnum = 4;
	}
	else if(mousepos.y >= 512 && mousepos.y < 640)
	{
		sizetxt5+=speedscale; if (sizetxt5>1.3) sizetxt5=1.3;
		ReSizeTexts();
		SET_TRANP(p_link5,1);
		slotnum = 5;
	}
	else if(mousepos.y >= 640)
	{
		sizetxt6+=speedscale; if (sizetxt6>1.3) sizetxt6=1.3;
		ReSizeTexts();
		SET_TRANP(p_link6,1);
		slotnum = 6;
	}
}
