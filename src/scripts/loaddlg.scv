void ON_LBUTTONDOWN()
{
//	queststate.GetTime();

	bool b_load = false;
	if (slotnum == 1) b_load = queststate.LoadGame("slot1.sav");
	if (slotnum == 2) b_load = queststate.LoadGame("slot2.sav");
	if (slotnum == 3) b_load = queststate.LoadGame("slot3.sav");
	if (slotnum == 4) b_load = queststate.LoadGame("slot4.sav");
	if (slotnum == 5) b_load = queststate.LoadGame("slot5.sav");
	if (slotnum == 6) b_load = queststate.LoadGame("slot6.sav");


	if(slotnum == -1)
	{		
	
		DeleteAll();
	
	}	
	if (!b_load) return;

	DeleteAll();
	
	message m;
	m.p_target = scene.FindObjectByName("mainmenu");
	m.message_id = EM_NOTIFY;
	m.lparam = 0;
	scene.PostMessage(m);
	scene.Delete(7);
	
	m.p_target = scene.FindObjectByName("sound_back");
	if(m.p_target != NULL)
	{
		m.message_id = EM_NOTIFY;
		m.lparam = 0;
		scene.PostMessage(m);
	}


	doload = true;
	
	

}

