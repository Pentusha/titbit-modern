void strcpy(char * p_ch1, char * p_ch2)
{
        int f = 0;
        while(p_ch2[f]!=0)
        {
                p_ch1[f] = p_ch2[f];
                f++;
        }
        p_ch1[f] = 0;
}

void SET_TRANP(LINK * p_link, float tr)
{
        IFPlane * p_ipl = NULL;
        if( p_link != NULL )
        {
                p_ipl = (IFPlane *)p_link;
                p_ipl->transparency = tr;
        }
}



