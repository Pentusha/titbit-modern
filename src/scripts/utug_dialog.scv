#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_TIME;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
LINK * p_back = NULL;

STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;
bool wait = false;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)
	{	
		p_text->Delete();
		p_text = NULL;
	}
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;
	
	if(queststate.item_club_card == 0)
	{
		if(step == 1) {	p_text = TextWindowCreate("sumerkientrance_utug_11", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_utug_11.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("utug_rot.EZA", -1);	

}
		if(step == 2) {	step = -1;	}					
	}
	if(queststate.item_club_card == 1)
	{
		
		if(step == 1) {	p_text = TextWindowCreate("sumerkientrance_anton_21", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_anton_21.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 2) {	p_text = TextWindowCreate("sumerkientrance_utug_22", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_utug_22.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("utug_rot.EZA", -1);	

}
		if(step == 3) 
		{	
			step = -1; queststate.item_club_card = -1;	
			scene.DeleteObject(self); 
			//проходим в клуб
			scene.Delete(3);
			scene.Load("club_bar021.XML");
		
			return;
		}				
	}
	if(queststate.item_titbit == 0 && queststate.item_club_card == -1)
	{
		step = -1;			
	}
	
	if(queststate.item_titbit == 1)
	{								
		if(step == 1) {
		p_text = TextWindowCreate("sumerkientrance_anton_31", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_anton_31.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);	
		
		//показываем скетч
//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
	
		p_obj = CreateGameObject(1,"scetch_use_titbit.scv", position, size);	
			
		scene.Add(p_obj, 2);
	}
		if(step == 2) {	p_text = TextWindowCreate("sumerkientrance_utug_32", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_utug_32.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("utug_rot.EZA", -1);	

}
		if(step == 3) {	p_text = TextWindowCreate("sumerkientrance_anton_33", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_anton_33.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 4) {	p_text = TextWindowCreate("sumerkientrance_utug_34", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_utug_34.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("utug_rot.EZA", -1);	

}
		if(step == 5) {	p_text = TextWindowCreate("sumerkientrance_anton_35", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_anton_35.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 6) {	p_text = TextWindowCreate("sumerkientrance_utug_36", "font", position,size, 29, 2);	p_stream = CreateStream("sumerkientrance_utug_36.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		p_guba = p_pers->CreateSkeletonAnimation("utug_rot.EZA", -1);	

}
		if(step == 7) 
		{
	
		//step = -1;
		
		
		//охранник застреливается 
	
		message m;
		m.message_id = EM_NOTIFY;
		m.lparam = 999;
		m.p_target = p_pers;
		scene.PostMessage(m);
		
		self->CreateTimer(12000, 1);
		wait = true;

		position.Assign(-117.9248,-1.6917,-9.9143);
		size.Assign(-90.6116,0.1574,-0.0017);
		camera.PlaceCamera(38.97, position, size);

		p_back->Delete();

		}

		if(step == 8) 
		{
			queststate.item_titbit = -1;
			step = -1;
		}						
	}
	
	
	
	if(step == -1)
	{
			
		//фоновая музыка
		GAME_OBJECT * p_snd;
 
		p_snd = scene.FindObjectByName("sound_back");	

		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}

		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign(-117.9248,-1.6917,-9.9143);
		size.Assign(-90.6116,0.1574,-0.0017);
		camera.PlaceCamera(38.97, position, size);
		
		if(queststate.item_titbit != -1)
		{
			LINK * p_link = p_pers;
			ANILINK* p_ani = p_link->GetAniLink();
			if(p_ani != NULL)
				p_ani->Delete();
		
			p_pers->CreateSkeletonAnimation("utug_idle.EZA", -1);
		}
		
			
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("utug");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	

	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("utug_talk.EZA", -1);	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	p_back = p_obj;
		
	position.Assign(-115.0569,0.5539,-1.8276);
	size.Assign(-98.8678,2.1316,-0.3325);
	camera.PlaceCamera(4, position, size);
	
	StepDialog();	
	

	
}


void ON_LBUTTONDOWN()
{
	if(!wait)
		StepDialog();		
}

void ON_TIME(int timernum)
{
	StepDialog();	
}
