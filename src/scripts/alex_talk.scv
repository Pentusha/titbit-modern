#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_CREATE;



void ON_CREATE()
{
	if( queststate.item_reciver != -1 || queststate.item_compromat_fotos != -1 || queststate.item_titbit != -1 || queststate.item_marker == 0 || queststate.item_petrolium_can != 0)
	{
		scene.DeleteObject(self);	
	}
	
}


void ON_SETFOCUS()
{
	scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);	


}

void ON_LBUTTONDOWN()
{
	
	
	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 103;
	scene.PostMessage(m);


}

