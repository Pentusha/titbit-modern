void ON_SETFOCUS()
{
	vec3_t scale;
	scale.Assign(1.5,1.5,1.5);
	self->SetBoneScale(0, scale);

}

void ON_KILLFOCUS()
{
	vec3_t scale;
	scale.Assign(1,1,1);
	self->SetBoneScale(0, scale);
}
