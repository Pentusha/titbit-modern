#define MAX_ANISPEED 50

export ON_CREATE;
export ON_DESTROY;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_TIME;

SKEL_ANI * traxanimation = NULL;
SKEL_ANI * traxanimation2= NULL;
GAME_OBJECT * p_gameobject;

LINK * p_falos = NULL;
LINK * p_fillfalos = NULL;
LINK * p_falos1 = NULL;
LINK * p_falos2 = NULL;

LINK * p_sperma1 = NULL;
LINK * p_sperma2 = NULL;
LINK * p_sperma3 = NULL;
LINK * p_sperma4 = NULL;

LINK * p_arrow1a = NULL;
LINK * p_arrow1b = NULL;
LINK * p_arrow2a = NULL;
LINK * p_arrow2b = NULL;

LINK * p_orgazm1 = NULL;
LINK * p_orgazm2 = NULL;
LINK * p_orgazm3 = NULL;

STREAM * p_sound1 = NULL;
STREAM * p_sound2 = NULL;
STREAM * p_sound3 = NULL;
STREAM * p_sound4 = NULL;
STREAM * p_sound5 = NULL;
STREAM * p_sound6 = NULL;
STREAM * p_sound7 = NULL;
STREAM * p_sound8 = NULL;
STREAM * p_sound9 = NULL;

int numgame = 0;

IFPlane * p_ifp = NULL;

int timer1 = NULL;
int timer2 = NULL;
int timer3 = NULL;
int anispeed = MIN_ANISPEED; // 6-50 ;-)...
int nsset=0;

bool b_gamecomplete;

void SET_TRANP(LINK * p_link, float tr)
{
	IFPlane * p_ipl = NULL;
	if( p_link != NULL )
	{
		p_ipl = (IFPlane *)p_link;
		p_ipl->transparency = tr;
	}
}

void SET_YC(LINK * p_link, float tr)
{
	IFPlane * p_ipl = NULL;
	if( p_link != NULL )
	{
		p_ipl = (IFPlane *)p_link;
		p_ipl->origin.y = tr;
	}
}

void CREATE_ITEMS()
{
	vec3_t pos;
	vec3_t size;
	vec3_t uvpos;
	vec3_t uvsize;

/////////////////////////////

	size.Assign(200,200,0);
	pos.Assign(10,620,0);
	uvsize.Assign(0.25,-0.25,0);

	uvpos.Assign(0.5,0.75,0);
	p_sperma1 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_sperma1);
	
	uvpos.Assign(0.75,0.75,0);
	p_sperma2 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_sperma2);

	uvpos.Assign(0.5,1,0);
	p_sperma3 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_sperma3);

	uvpos.Assign(0.75,1,0);
	p_sperma4 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_sperma4);

/////////////////////////////

	size.Assign(200,500,0);
	pos.Assign(10,140,0);
	uvsize.Assign(0.25,-0.5,0);

	uvpos.Assign(0,0.5,0);
	p_falos = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_falos);

	uvpos.Assign(0,0.5,0);
	p_fillfalos = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_fillfalos);

	uvpos.Assign(0.25,0.5,0);
	p_falos1 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_falos1);

	uvpos.Assign(0.25,1,0);
	p_falos2 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_falos2);

/////////////////////////////

	size.Assign(100,100,0);
	uvsize.Assign(0.125,-0.125,0);

	pos.Assign(420,10,10);
	uvpos.Assign(0.75,0.125,0);
	p_arrow1a = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_arrow1a);

	pos.Assign(420,10,0);
	uvpos.Assign(0.875,0.125,0);
	p_arrow1b = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_arrow1b);


	pos.Assign(550,10,10);
	uvpos.Assign(0.625,0.125,0);
	p_arrow2a = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_arrow2a);

	pos.Assign(550,10,0);
	uvpos.Assign(0.5,0.125,0);
	p_arrow2b = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_arrow2b);
///////////
	size.Assign(256,64,0);
	uvsize.Assign(0.5,-0.125,0);
	pos.Assign(420,700,0);

	uvpos.Assign(0.5,0.25,0);
	p_orgazm1 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_orgazm1);

	uvpos.Assign(0.5,0.375,0);
	p_orgazm2 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_orgazm2);

	uvpos.Assign(0.5,0.5,0);
	p_orgazm3 = CreateIFPlane(pos,size,uvpos,uvsize, "traxni.tga");
	self->Attach(p_orgazm3);

/////////////////////////////

	p_ifp = (IFPlane *)p_fillfalos;
}

void SET_RAKETA(float fl)
{
	SET_YC(p_falos,140+fl);
	SET_YC(p_fillfalos,140+fl);

	SET_YC(p_sperma1,620+fl);
	SET_YC(p_sperma2,620+fl);
	SET_YC(p_sperma3,620+fl);
	SET_YC(p_sperma4,620+fl);

}

void START_GAME()
{	
	vec3_t position, size;
	ANILINK * p_al = NULL;
	nsset=0;
	
	b_gamecomplete = false;
	
	SET_TRANP(p_falos1,0);
	SET_TRANP(p_falos2,0);
		
	SET_TRANP(p_sperma1,0);
	SET_TRANP(p_sperma2,0);
	SET_TRANP(p_sperma3,0);
	SET_TRANP(p_sperma4,0);

	SET_RAKETA(0);
	anispeed = 10;

	p_gameobject = scene.FindObjectByName("anton");
	if (p_gameobject!=NULL) 
	{
		p_al = (ANILINK*)traxanimation;
		if (traxanimation!=NULL) p_al->Delete();
		if (numgame==0) traxanimation = p_gameobject->CreateSkeletonAnimation("anton_sex1.EZA", -1);
		else if (numgame==1) traxanimation = p_gameobject->CreateSkeletonAnimation("anton_sex2.EZA", -1);
		else traxanimation = p_gameobject->CreateSkeletonAnimation("anton_sex3.EZA", -1);
	}
	p_gameobject = scene.FindObjectByName("sestra");
	if (p_gameobject!=NULL) 
	{
		p_al = (ANILINK*)traxanimation2;
		if (traxanimation2!=NULL) p_al->Delete();
		if (numgame==0) traxanimation2 = p_gameobject->CreateSkeletonAnimation("sister_sex1.EZA", -1);
		else if (numgame==1) traxanimation2 = p_gameobject->CreateSkeletonAnimation("sister_sex2.EZA", -1);
		else traxanimation2 = p_gameobject->CreateSkeletonAnimation("sister_sex3.EZA", -1);
	}

	if(numgame==0)
	{
		position.Assign(0.4613,-0.462,-3.2106);
		size.Assign(70.5563,40.3178,167.1339);
		camera.PlaceCamera(36.4322, position, size);

		SET_TRANP(p_orgazm1,1);
		SET_TRANP(p_orgazm2,0);
		SET_TRANP(p_orgazm3,0);

	}
	if(numgame==1)
	{
		position.Assign(0.3382,-0.2384,-3.485);
		size.Assign(-44.9446,-50.3924,-37.6653);
		camera.PlaceCamera(36.4322, position, size);

		SET_TRANP(p_orgazm1,0);
		SET_TRANP(p_orgazm2,1);
		SET_TRANP(p_orgazm3,0);
	}
	if(numgame==2)
	{
		position.Assign(0.2793,-0.3642,-2.6276);
		size.Assign(49.7069,56.3106,144.7984);
		camera.PlaceCamera(36.4322, position, size);

		SET_TRANP(p_orgazm1,0);
		SET_TRANP(p_orgazm2,0);
		SET_TRANP(p_orgazm3,1);

	}
	numgame ++;
	if (numgame == 4)
	{
	// все, квест пройден, можно выходить.
		scene.DeleteObject(self);
		scene.Delete(3);
		scene.Load("psixpalata2.XML");
	}
}

void SET_ANISPEED(int spd)
{
	if (traxanimation!= NULL) 
		traxanimation->SetFrameRate(0.65*(float)spd);
	if (traxanimation2!= NULL) 
		traxanimation2->SetFrameRate(0.65*(float)spd);
}

void ON_CREATE()
{	
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 37;
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
	
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 16080;
		m.p_target = p_snd;
		scene.PostMessage(m);
		
	}


	p_sound1 = CreateStream("aaa1.ogg");
	p_sound2 = CreateStream("aaa2.ogg");
	p_sound3 = CreateStream("aaa3.ogg");
	p_sound4 = CreateStream("aaa4.ogg");
	p_sound5 = CreateStream("aaa5.ogg");
	p_sound6 = CreateStream("aaa6.ogg"); // проблема с этим ogg'om
	p_sound7 = CreateStream("aaa7.ogg");
	p_sound8 = CreateStream("aaa8.ogg");
	p_sound9 = CreateStream("aaa9.ogg");

	CREATE_ITEMS();
	START_GAME();

	SET_ANISPEED(anispeed);

	timer2 = self->CreateTimer(0, -1);
	timer1 = self->CreateTimer(100, -1);
	timer3 = self->CreateTimer(5, -1);

	SET_TRANP(p_falos1,0);
	SET_TRANP(p_falos2,0);

	SET_TRANP(p_orgazm1,1);
	SET_TRANP(p_orgazm2,0);
	SET_TRANP(p_orgazm3,0);
}

void ON_DESTROY()
{

	if (p_sound1) DeleteStream(p_sound1);
	if (p_sound1) DeleteStream(p_sound2);
	if (p_sound1) DeleteStream(p_sound3);
	if (p_sound1) DeleteStream(p_sound4);
	if (p_sound1) DeleteStream(p_sound5);
	if (p_sound1) DeleteStream(p_sound6);
	if (p_sound1) DeleteStream(p_sound7);
	if (p_sound1) DeleteStream(p_sound8);
	if (p_sound1) DeleteStream(p_sound9);

}

