void ON_TIME(int timernum)
{
// yo /////////////////////////////////////////
	static int numsperma=0;
	static float raketapos = 0;
	bool b_temp;
	
	if (b_gamecomplete)
	{


		if (timernum == timer1)
		{
			SET_TRANP(p_falos1,0);
			SET_TRANP(p_falos2,0);
			SET_TRANP(p_sperma2,0);
			SET_TRANP(p_sperma3,0);
			SET_TRANP(p_sperma4,0);
			SET_TRANP(p_sperma1,0);
			
			if ( (numsperma%4)==0 ) SET_TRANP(p_sperma1,1);
			if ( (numsperma%4)==1 ) SET_TRANP(p_sperma2,1);
			if ( (numsperma%4)==2 ) SET_TRANP(p_sperma3,1);
			if ( (numsperma%4)==3 ) SET_TRANP(p_sperma4,1);
			numsperma++;

		}
		else if (timernum == timer3)
		{
			SET_RAKETA(-raketapos);
			if (raketapos==0) raketapos = 1.1;
			else raketapos *= 1.06;
		}

		if (numsperma==40) START_GAME();
		else return;

	}
	else 
	{
		raketapos = 0;
	}
// end of yo //////////////////////////////////

	static bool b_left = false;
	static bool b_oldhalf;
	static bool b_half;
	static int b_keylold=false;
	static int b_keyrold=false;

	ANILINK * p_lnk;
	int oldanispeed = anispeed;
	
	b_half = GetHalf();

	static bool b_keyr = false;
	static bool b_keyl = false;

	if ( (keys[DIK_LEFT]) || (keys[DIK_RIGHT]) )
	{
		if ( keys[DIK_RIGHT] && (!keys[DIK_LEFT]) ) b_keyl = true;
		if ( keys[DIK_LEFT] && (!keys[DIK_RIGHT]) ) b_keyr = true;

//		if ( keys[DIK_LEFT] ) b_keyl = true; else b_keyl = false;
//		if ( keys[DIK_RIGHT] ) b_keyr = true; else b_keyr = false;

//		if ( !b_keylold && keys[DIK_LEFT] ) b_keyl = true;
//		if ( !b_keyrold && keys[DIK_RIGHT] ) b_keyr = true;

//		b_temp = GetHalf();
//		if ( b_temp&&(keys[DIK_LEFT])&&(rand()%3>0) ) b_keyr = false;	//////////////////////////////////////////////////////////////////////////////
//		if ( b_temp&&(keys[DIK_RIGHT]&&(rand()%3>0)) ) b_keyl = false;	//////////////////////////////////////////////////////////////////////////////


	}

///////////////////////////////////////
	if (b_half!=b_oldhalf)
	{
		SET_TRANP(p_arrow1b,0); 	//////////////////////////////////////////////////////////////////////////////
		SET_TRANP(p_arrow2b,0); 	//////////////////////////////////////////////////////////////////////////////

		if (!b_left)
		{	
			SET_TRANP(p_arrow1b,1); //////////////////////////////////////////////////////////////////////////////

			int aaa;
			
			if (anispeed<30)
			{
				aaa = 1 + rand()%6;

				if (aaa==1) p_sound1->Play(false);
				if (aaa==2) p_sound2->Play(false);
				if (aaa==3) p_sound3->Play(false);
				if (aaa==4) p_sound4->Play(false);
				if (aaa==5) p_sound5->Play(false);
//				if (aaa==6) p_sound6->Play(false);

			}

			else if (anispeed<45)
			{
				aaa = 6 + rand()%3;

//				if (aaa==6) p_sound6->Play(false);
				if (aaa==7) p_sound7->Play(false);
				if (aaa==8) p_sound8->Play(false);

			}
			

			if (b_keyl)
			{
				anispeed+=1;
			}
			else
			{
				anispeed-=2;
				if (anispeed<MIN_ANISPEED) anispeed=MIN_ANISPEED;
			}
		}
		else
		{
			SET_TRANP(p_arrow2b,1); //////////////////////////////////////////////////////////////////////////////

			if (b_keyr)
			{
				anispeed+=1;
			}
			else
			{
				anispeed-=2;
				if (anispeed<MIN_ANISPEED) anispeed=MIN_ANISPEED;
			}
		}
		if (b_left) b_left=false; else b_left=true;
		b_keyl = false;
		b_keyr = false;		
	}
///////////////////////////////////////


	if (oldanispeed != anispeed)
	{

		p_lnk = (ANILINK *)timer2;
		if (p_lnk!=NULL) 
		{
			p_lnk->Delete();
			timer2 = self->CreateTimer(anispeed, -1);
		}

		SET_ANISPEED(anispeed);
	}

	b_oldhalf = GetHalf();


	static int b_numfalos=false;
	float normspd = ((float)anispeed)/60;
	
	if (normspd>0.8) 
	{
	////////////////////////////////////
		if (nsset==0) p_sound9->Play(false);
		normspd=1;
		if (timernum == timer1)
		{	
			if (b_numfalos==0)
			{
				SET_TRANP(p_falos1,1);
				SET_TRANP(p_falos2,0);
				b_numfalos = 1;
			}
			else if (b_numfalos==1)
			{
				SET_TRANP(p_falos1,0);
				SET_TRANP(p_falos2,1);
				b_numfalos = 2;
			}
			else if (b_numfalos==2)
			{
				SET_TRANP(p_falos1,0);
				SET_TRANP(p_falos2,0);
				b_numfalos = 0;

			}
		}
		nsset++;


		if (nsset==80)
		{
			nsset=0;
			b_gamecomplete = true;
			numsperma=0;
		}

	////////////////////////////////////		
	}
	else
	{
//		p_sound9->Stop();		
		nsset=0;
		SET_TRANP(p_falos1,0);
		SET_TRANP(p_falos2,0);
		
		SET_TRANP(p_sperma1,0);
		SET_TRANP(p_sperma2,0);
		SET_TRANP(p_sperma3,0);
		SET_TRANP(p_sperma4,0);
	}

	p_ifp->uvsize.y = -normspd*0.5;
	p_ifp->uvorigin.y = 0.5-p_ifp->uvsize.y;
	p_ifp->size.y = normspd*500;
	p_ifp->origin.y = 640-p_ifp->size.y;
}


