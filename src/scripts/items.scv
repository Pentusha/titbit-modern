	{	
		strcpy(namepr, "item_nuclear_mushrooms");
		*typepr = 1;
		uvpos.Assign(postexx0,postexy0,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}

	if ( (queststate.item_disk_piece) >= 1 )
	{	
		int quant = 0;
		
		if(queststate.item_disk_piece & 1)
			quant = quant +1;
		if(queststate.item_disk_piece & 2)
			quant = quant +1;
		if(queststate.item_disk_piece & 4)
			quant = quant +1;
		if(queststate.item_disk_piece & 8)
			quant = quant +1;
			
		switch(quant)
		{
		case 1:		strcpy(namepr, "item_disk_piece1"); 
				uvpos.Assign(postexx1,postexy0,0);
				break;
		case 2:		strcpy(namepr, "item_disk_piece2"); 
				uvpos.Assign(postexx2,postexy0,0);
				break;
		case 3:		strcpy(namepr, "item_disk_piece3"); 
