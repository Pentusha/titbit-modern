		uvpos.Assign(postexx5,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_saw_circul) >= 1 )
	{	
		strcpy(namepr, "item_saw_circul");
		*typepr = 60;
		uvpos.Assign(postexx6,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_red_paint_ballon) >= 1 )
	{	
		strcpy(namepr, "item_red_paint_ballon");
		*typepr = 61;
		uvpos.Assign(postexx7,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_white_rose) >= 1 )
	{	
		strcpy(namepr, "item_white_rose");
		*typepr = 62;
		uvpos.Assign(postexx8,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_air_ball) >= 1 )
	{	
		strcpy(namepr, "item_air_ball");
		*typepr = 63;
		uvpos.Assign(postexx9,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_cutters) >= 1 )
	{	
		strcpy(namepr, "item_cutters");
		*typepr = 64;
		uvpos.Assign(postexx10,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_keydurka) >= 1 )
	{	
		strcpy(namepr, "item_keydurka");
		*typepr = 67;
		uvpos.Assign(postexx12,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}
	if ( (queststate.item_ruchka) >= 1 )
	{	
		strcpy(namepr, "item_ruchka");
		*typepr = 68;
		uvpos.Assign(postexx13,postexy4,0);
		if (itsset == itemnum) return uvpos;
		itsset++;
	}

	strcpy(namepr, "pusto");
	*typepr = 0;
	uvpos.Assign(0,0,0);

	return uvpos;

}

void CREATE_ITEMS()
{
	vec3_t pos;
	vec3_t size;
	vec3_t uvpos;
	vec3_t uvsize;
	
	pos.Assign(0,0,0);
	size.Assign(64,64,0);
	uvpos.Assign(0,0.25,0);
	uvsize.Assign(0.0625,-0.0625,0);

	if (p_pup!=NULL) {p_pup->Delete(); p_pup=NULL;}
	if (p_pdn!=NULL) {p_pdn->Delete(); p_pdn=NULL;}
 	if (p_p1!=NULL)  {p_p1->Delete(); p_p1=NULL;}
	if (p_p2!=NULL)  {p_p2->Delete(); p_p2=NULL;}
	if (p_p3!=NULL)  {p_p3->Delete(); p_p3=NULL;}
	if (p_p4!=NULL)  {p_p4->Delete(); p_p4=NULL;}
	if (p_p5!=NULL)  {p_p5->Delete(); p_p5=NULL;}
	if (p_p6!=NULL)  {p_p6->Delete(); p_p6=NULL;}
	if (p_p7!=NULL)  {p_p7->Delete(); p_p7=NULL;}
	if (p_p8!=NULL)  {p_p8->Delete(); p_p8=NULL;}

	if (p_dance != NULL){p_dance->Delete(); p_dance=NULL;}

	//создаем пачку кнопок

	uvpos1 = CalcItem(7+itemoffset, namepr1, &typepr1);
	if (typepr8==0) itemoffset=0;




	uvpos1 = CalcItem(0+itemoffset, namepr1, &typepr1);
	if (typepr1!=0)
	{
		p_p1 = CreateIFPlane(pos,size,uvpos1,uvsize, "items.tga"); 
		self->Attach(p_p1);
		pos.y += 70;
	}

	uvpos2 = CalcItem(1+itemoffset, namepr2, &typepr2);	
	if (typepr2!=0)
	{
		p_p2 = CreateIFPlane(pos,size,uvpos2,uvsize, "items.tga"); 
		self->Attach(p_p2);
		pos.y += 70;
	}

	uvpos3 = CalcItem(2+itemoffset, namepr3, &typepr3);	
	if (typepr3!=0)
	{
		p_p3 = CreateIFPlane(pos,size,uvpos3,uvsize, "items.tga");
		self->Attach(p_p3);
		pos.y += 70;
	}

	uvpos4 = CalcItem(3+itemoffset, namepr4, &typepr4);	
	if (typepr4!=0)
	{
		p_p4 = CreateIFPlane(pos,size,uvpos4,uvsize, "items.tga"); 
		self->Attach(p_p4);
		pos.y += 70;
	}

	uvpos5 = CalcItem(4+itemoffset, namepr5, &typepr5);	
	if (typepr5!=0)
	{
		p_p5 = CreateIFPlane(pos,size,uvpos5,uvsize, "items.tga"); 
		self->Attach(p_p5);
		pos.y += 70;
	}

	uvpos6 = CalcItem(5+itemoffset, namepr6, &typepr6);	
	if (typepr6!=0)
	{
		p_p6 = CreateIFPlane(pos,size,uvpos6,uvsize, "items.tga"); 
		self->Attach(p_p6);
		pos.y += 70;
	}

	uvpos7 = CalcItem(6+itemoffset, namepr7, &typepr7);	
	if (typepr7!=0)
	{
		p_p7 = CreateIFPlane(pos,size,uvpos7,uvsize, "items.tga"); 
		self->Attach(p_p7);
		pos.y += 70;
	}

	uvpos8 = CalcItem(7+itemoffset, namepr8, &typepr8);	
	if (typepr8!=0)
	{
		p_p8 = CreateIFPlane(pos,size,uvpos8,uvsize, "items.tga"); 
		self->Attach(p_p8);
		pos.y += 70;
	}
	

	size.Assign(64,32,0);
	uvsize.Assign(0.0625,-0.03125,0);

	int typeprtmp2;	
	if (itemoffset>0) CalcItem(itemoffset-1, nametmp, &typeprtmp2);

//	uvpostmp = CalcItem(8+itemoffset, nametmp, &typeprtmp);
	CalcItem(8+itemoffset, nametmp, &typeprtmp);

	if ( (typeprtmp!=0)||(typeprtmp2!=0) )
	{
		uvpos.Assign(postexx15,postexy15,0);	
		p_pup = CreateIFPlane(pos,size,uvpos,uvsize, "items.tga");
		self->Attach(p_pup);

		pos.y += 35;

		uvpos.Assign(postexx15,postexy15-0.03125,0);	
		p_pdn = CreateIFPlane(pos,size,uvpos,uvsize, "items.tga");
		self->Attach(p_pdn);

	}
	

	if(queststate.item_dance_video == -1)
	{
		size.Assign(64,64,0);
		uvsize.Assign(0.0625,-0.0625,0);
		pos.Assign(0, 645, 0);
		uvpos.Assign(postexx5,postexy15,0);	
		p_dance = CreateIFPlane(pos,size,uvpos,uvsize, "items.tga");
		self->Attach(p_dance);
	}

}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	position.Assign(0,-70,-1);
	size.Assign(64,830,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);


	itemoffset = 0;
	queststate.typepr = 0;
	CREATE_ITEMS();

	//создаем вечный таймер с периодом активации 0 мсек
	self->CreateTimer(0, -1);
}

void ON_DESTROY()
{

}

void ON_TIME(int timernum)
{
	vec3_t localpos;
	
	self->GetBonePosition(0,localpos);

	localpos.x-=8;

	if (localpos.x<-64) localpos.x = -64;
	self->SetBonePosition(0, localpos);
		
}

void ON_MOUSEOVER(vec3_t mousepos)
{
	WriteLog("Mouse Over");

	IFPlane * p_oldipl = p_ipl;
	
	vec3_t localpos;
	
	if(p_ipl != NULL)
	{
//		p_ipl->uvorigin.y = 0.118;	
	}

	self->GetBonePosition(0,localpos);
	if (localpos.x<-60) { /*itemoffset=0;*/ CREATE_ITEMS(); }
	localpos.x+=16;
	if (localpos.x>0) localpos.x = 0;
	self->SetBonePosition(0, localpos);

	
	localpos.x = mousepos.x - localpos.x;
	localpos.y = mousepos.y - localpos.y;
	
	if(localpos.y > 0 && localpos.y < 64)
	{
	   p_ipl = p_p1;
	}
	else if(localpos.y > 70 && localpos.y < 134)
	{
	   p_ipl = p_p2;
	}
	else if(localpos.y > 140 && localpos.y < 204)
	{
	   p_ipl = p_p3;
	}
	else if(localpos.y > 210 && localpos.y < 274)
	{
	   p_ipl = p_p4;
 	}
	else if(localpos.y > 280 && localpos.y < 344)
	{
	   p_ipl = p_p5;
	}
	else if(localpos.y > 350 && localpos.y < 414)
	{
	   p_ipl = p_p6;
	}
	else if(localpos.y > 420 && localpos.y < 484)
	{
	   p_ipl = p_p7;
	}
	else if(localpos.y > 490 && localpos.y < 554)
	{
	   p_ipl = p_p8;
	}
	else if(localpos.y > 560 && localpos.y < 592)
	{
	   p_ipl = p_pup;
	}
	else if(localpos.y > 598 && localpos.y < 634)
	{
	   p_ipl = p_pdn;
	}
	else if(localpos.y > 648 && localpos.y < 712)
	{
	   p_ipl = p_dance;
	}
	else
	{
	   p_ipl = NULL;
	}

	if( p_oldipl != p_ipl )
	{	
   	    if(p_tooltip != NULL)
	    {
		  scene.DeleteObject(p_tooltip);
	    	  p_tooltip = NULL;
	    }
	    if(p_ipl != NULL)
	    {
		  if(p_ipl == p_p1)
		  {
			p_tooltip = scene.CreateTextWindow(self, namepr1, 70, 0, 510, 60, 30, 0, "");
		  }
		  if(p_ipl == p_p2)
		  {
  			p_tooltip = scene.CreateTextWindow(self, namepr2, 70, 70, 510, 60, 30, 0, "");
		  }
		  if(p_ipl == p_p3)
		  {
  			p_tooltip = scene.CreateTextWindow(self, namepr3, 70, 140, 510, 60, 30, 0, "");
		  }
		  if(p_ipl == p_p4)
		  {
   			p_tooltip = scene.CreateTextWindow(self, namepr4, 70, 210, 510, 60, 30, 0, "");
		  }			
 		  if(p_ipl == p_p5)
		  {
   			p_tooltip = scene.CreateTextWindow(self, namepr5, 70, 280, 510, 60, 30, 0, "");
		  }
		  if(p_ipl == p_p6)
		  {
  			p_tooltip = scene.CreateTextWindow(self, namepr6, 70, 350, 510, 60, 30, 0, "");
		  }
		  if(p_ipl == p_p7)
		  {
   			p_tooltip = scene.CreateTextWindow(self, namepr7, 70, 420, 510, 60, 30, 0, "");
		  }			
 		  if(p_ipl == p_p8)
		  {
   			p_tooltip = scene.CreateTextWindow(self, namepr8, 70, 490, 510, 60, 30, 0, "");
		  }
   		  if(p_ipl == p_dance)
		  {
   			p_tooltip = scene.CreateTextWindow(self, "dance", 70, 670, 510, 60, 30, 0, "");
		  }

	    }	     
	}


	p_ipl2 = p_pup;
	if (p_ipl2!=NULL) p_ipl2->transparency = 0.6;
	p_ipl2 = p_pdn;
	if (p_ipl2!=NULL) p_ipl2->transparency = 0.6;

	if(p_ipl != NULL)
	{
		CalcItem(8+itemoffset, nametmp, &typeprtmp);
		if (itemoffset>0) if(p_ipl == p_pup) p_ipl->transparency = 1.0;
		if (typeprtmp!=0) if(p_ipl == p_pdn) p_ipl->transparency = 1.0;
	}

}

void ON_LBUTTONDOWN()
{
	GAME_OBJECT * p_obj;
	int newtypepr = -1;
	float newuvx, newuvy; 
	vec3_t position, size, uvposition, uvsize;	

	if (p_ipl!=NULL)
	{
		if( p_ipl == p_p1 ) { newtypepr = typepr1; newuvx = uvpos1.x; newuvy = uvpos1.y; }
		if( p_ipl == p_p2 ) { newtypepr = typepr2; newuvx = uvpos2.x; newuvy = uvpos2.y; }
		if( p_ipl == p_p3 ) { newtypepr = typepr3; newuvx = uvpos3.x; newuvy = uvpos3.y; }
		if( p_ipl == p_p4 ) { newtypepr = typepr4; newuvx = uvpos4.x; newuvy = uvpos4.y; }
		if( p_ipl == p_p5 ) { newtypepr = typepr5; newuvx = uvpos5.x; newuvy = uvpos5.y; }
		if( p_ipl == p_p6 ) { newtypepr = typepr6; newuvx = uvpos6.x; newuvy = uvpos6.y; }
		if( p_ipl == p_p7 ) { newtypepr = typepr7; newuvx = uvpos7.x; newuvy = uvpos7.y; }
		if( p_ipl == p_p8 ) { newtypepr = typepr8; newuvx = uvpos8.x; newuvy = uvpos8.y; }
		if( p_ipl == p_dance ) {
//			queststate.typepr = 0; scene.SetCursorType(5); return;}
		newtypepr = 100;
		newuvx = postexx5;
		newuvy = postexy15;		
		}
		//отслеживаем комбинирование предметов
		if(newtypepr != -1)
		{
			bool refresh = false;

			switch(newtypepr)
			{
			//игра веселый шива
			case 25:
				scene.Load("shiva.XML");
				refresh = true;
				break;

			// в пустую кружку 
			case 19:
				//наливаем водку 
				if(queststate.typepr == 18)
				{
					queststate.item_kruzhka = queststate.item_kruzhka | 2;
					queststate.item_bottle_of_vodka = -1;
					refresh = true;
					
					//комментарий кота
					if(p_stream != NULL)
					{
						p_stream->Stop(); 	
						DeleteStream(p_stream);
						p_stream = NULL;
					}
					p_stream = CreateStream("comment_cat_11.ogg");
					p_stream->Play(false);
				}
				break;
			//складываем в кружку 
			case 66:
				//добавляем крысиный хвостик 
				if(queststate.typepr == 3)
				{
					queststate.item_kruzhka = queststate.item_kruzhka | 4;
					queststate.item_rat_tail = -1;	
					refresh = true;
				}
				//добавляем галстук испачканный в сперме 
				if(queststate.typepr == 7 && queststate.item_pioners_tie == 2)
				{

					queststate.item_kruzhka = queststate.item_kruzhka | 8;
					queststate.item_pioners_tie = -1;
					refresh = true;
				}
				//добавляем радиоактивные грибы 
				if(queststate.typepr == 1)
				{

					queststate.item_kruzhka = queststate.item_kruzhka | 16;
					queststate.item_nuclear_mushrooms = -1;
					refresh = true;
				}	
				if(queststate.item_kruzhka == 31)
				{
					//комментарий кота
					if(p_stream != NULL)
					{
						p_stream->Stop(); 	
						DeleteStream(p_stream);
						p_stream = NULL;
					}
					p_stream = CreateStream("comment_cat_12.ogg");
					p_stream->Play(false);
				}
								
				break;
			//на пластинку 
			case 2:
				//клеим ее
				if(queststate.typepr == 4 && queststate.item_disk_piece == 15)
				{
					queststate.item_disk_piece = -1;	
					queststate.item_full_disk = 1;	
					queststate.item_clue = -1;	
					refresh = true;
				}					
				break;
			//на пистолет 
			case 28:
				//обойму
				if(queststate.typepr == 33)
				{
					queststate.item_gun = 2;
					queststate.item_bullets = -1;	
					refresh = true;
					
					//щелчок затвора
					if(p_stream != NULL)
					{
						p_stream->Stop(); 	
						DeleteStream(p_stream);
						p_stream = NULL;
					}
					p_stream = CreateStream("gun_zatvor.ogg");
					p_stream->Play(false);


				}					
				break;
			case 53:
				//делаем компрометирующую запись
				if(queststate.item_listenning_device == -1 && queststate.item_reciver == 1 && queststate.activelocation != 22 && queststate.activelocation != 23)
				{
					//показываем скетч
					queststate.typepr = 0;
					position.Assign(0, 0, -80);	
					size.Assign(1024,768,0);
		
					p_obj = CreateGameObject(1,"scetch_compr_tape.scv", position, size);	
					scene.Add(p_obj, 2);
				
					queststate.item_reciver = 2;
					return;
				}
			case 29: 
				//мочим туалетную бумагу в бензине
				if(queststate.typepr == 45)
				{
					queststate.item_tualet_paper = 2;
					queststate.item_petrolium_can = -1;
					refresh = true;
				}				
				break;
			case 30:
				//читаем записку 
				if(queststate.quest_aes_password == 0)
					queststate.quest_aes_password = 1;
				position.Assign(0, 0, -80);
				size.Assign(1024,768,0);		
				uvposition.Assign(0,1,0);
				uvsize.Assign(1,-1,0);

				scene.CreateIFWindow(NULL, position, size, uvposition, uvsize, "note.jpg", "close.scv"); 
				refresh = true;

				break;
			case 6:
				//пишем на постере LSD
				if(queststate.typepr == 37 && queststate.quest_spoil_city == 2)
				{
					queststate.item_indian_poster = 2;
					queststate.item_marker = -1;
					refresh = true;
				}
				break;
			case 56:
				//приклеиваем постер к канистре
				if(queststate.typepr == 6 && queststate.item_indian_poster == 2)
				{
						queststate.item_titbit_can = 2;
						queststate.item_indian_poster = -1;
						refresh = true;		
				}

				break;
			
			}

			if(refresh)
			{
				queststate.typepr = 0;	
				itemoffset = 0;			
				CREATE_ITEMS();
			}
			else
			{
				queststate.typepr = newtypepr;
				queststate.uvposx = newuvx;
				queststate.uvposy = newuvy;
				
			}
		}

		if( p_ipl == p_pup )
		{
			if ( itemoffset<=0 ) itemoffset=0;
			if ( itemoffset>=1 ) itemoffset--;
			CREATE_ITEMS();
		}
		else if( p_ipl == p_pdn )
		{
			if ( typeprtmp>0 ) itemoffset++;
			CREATE_ITEMS();
		}
		scene.SetCursorType(0);
	}
}

void ON_SETFOCUS()
{
	CREATE_ITEMS();

}

void ON_KILLFOCUS()
{
	p_ipl2 = p_pup;
	if (p_ipl2!=NULL) p_ipl2->transparency = 0.6;
	p_ipl2 = p_pdn;
	if (p_ipl2!=NULL) p_ipl2->transparency = 0.6;


	if(p_tooltip != NULL)
	{
//		p_tooltip->Delete();
		scene.DeleteObject(p_tooltip);
	    	p_tooltip = NULL;
	}
}
