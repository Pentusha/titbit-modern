				break;
		case 4:		strcpy(namepr, "item_disk_piece4"); 
				uvpos.Assign(postexx4,postexy0,0);
				break;
		}
		
		*typepr = 2;

		if (itsset == itemnum) return uvpos;
		itsset++;
	}

