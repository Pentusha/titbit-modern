void strcpy(char * p_ch1, char * p_ch2)
{
	int f = 0;
	while(p_ch2[f]!=0)
	{
		p_ch1[f] = p_ch2[f];
		f++;
	}
	p_ch1[f] = 0;
}

vec3_t CalcItem(int itemnum, char * namepr, int * typepr)
