#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_CREATE()
{
		scene.DeleteObject(self);
		scene.SetCursorType(0);

}

void ON_SETFOCUS()
{
	scene.SetCursorType(6);
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}

void ON_LBUTTONDOWN()
{
	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 101;
	scene.PostMessage(m);
}
