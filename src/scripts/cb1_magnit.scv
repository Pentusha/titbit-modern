#include scener

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;


void ON_SETFOCUS()
{
	scene.SetCursorType(4);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}



void ON_LBUTTONDOWN()
{

	GAME_OBJECT * p_anton;
	p_anton = scene.FindObjectByName("anton");
	message m;
	m.p_target = p_anton;
	m.message_id = EM_NOTIFY;
	m.lparam = 102;
	scene.PostMessage(m);

}
