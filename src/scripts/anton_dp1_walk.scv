#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int nextanimation;
int lastanimation;

bool	talkutug = false;

void ON_DESTROY()
{
	GAME_OBJECT * p_tape;
	p_tape = scene.FindObjectByName("flash");
	if(p_tape != NULL)
	{ 
		scene.DeleteObject(p_tape);
	}
}

void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 5100;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 24;
	
	if(queststate.lastlocation == 19 )
	{	
		lastanimation = self->CreateSkeletonAnimation("dp1_a_exit_idle.EZA", 1);
		nextanimation = 1;
	}
	if(queststate.lastlocation == 35 )
	{	
		lastanimation = self->CreateSkeletonAnimation("dp1_a_dj_idle.EZA", 1);
		nextanimation = 3;
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{

		if (nextanimation < 0) return;

		if(param == 101) // если нажали на выход
		{
			if(nextanimation == 1) nextanimation = -1;	//выход
			if(nextanimation == 3) nextanimation = 4;	//dj

		}
		if(param == 102) // если нажали на DJ
		{
			if(nextanimation == 1) nextanimation = 2;	//выход
			if(nextanimation == 3) nextanimation = -3;	//dj
		}
	
	}
	else
	{
		
		//		WriteLog("animation finished");
		
		
		if(nextanimation == -1)
		{	//выходим в бар
			nextanimation = 1;
			scene.Delete(3);
			scene.Load("club_bar01.XML");
		}
		if(nextanimation == -3)
		{	//идем к dj
//			nextanimation = 3;
			
			scene.Delete(3);
			scene.Load("club_disko02.XML");


		
		}
				
		
		if(nextanimation ==1)
		{
			lastanimation = self->CreateSkeletonAnimation("dp1_a_exit_idle.EZA", 1);
		}
		if(nextanimation ==2)
		{
			lastanimation = self->CreateSkeletonAnimation("dp1_a_exit_dj.EZA", 1);
			nextanimation =-3;
		}
		if(nextanimation ==3)
		{
			lastanimation = self->CreateSkeletonAnimation("dp1_a_dj_idle.EZA", 1);
		}
		
		if(nextanimation == 4)
		{
			lastanimation = self->CreateSkeletonAnimation("dp1_a_dj_exit.EZA", 1);
			nextanimation = -1;
		}
		
		
		
		



	}	
}
