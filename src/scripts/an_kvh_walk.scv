#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;

int nextanimation;
int lastanimation;

void ON_CREATE()
{ 
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 9080;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}
	
	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 12;
	
	nextanimation = 13;


	if(queststate.lastlocation == 7) // если пришли из подъезда, создаем анимацию колбашения у входной двери
	{
		lastanimation = self->CreateSkeletonAnimation("kvh_an_door_idle.EZA", 2);
		nextanimation = 13;
	}
	if(queststate.lastlocation == 15) // если пришли от Михалыча, создаем анимацию колбашения у двери Михалыча
	{
		lastanimation = self->CreateSkeletonAnimation("kvh_an_mikh_idle.EZA", 2);
		nextanimation = 15;
	}
	if(queststate.lastlocation == 14) // если пришли от сатанистов, создаем анимацию колбашения у двери сатанистов
	{
		lastanimation = self->CreateSkeletonAnimation("kvh_an_sat_idle.EZA", 2);
		nextanimation = 16;
	}
	if(queststate.lastlocation == 13) // если пришли от туалета, создаем анимацию колбашения у двери туалета
	{
		lastanimation = self->CreateSkeletonAnimation("kvh_an_tual_idle.EZA", 2);
		nextanimation = 14;
	}
 
	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation)
	{

		if (nextanimation < 0) return;

		WriteLog("Notify");

		if(param == 113) // если нажали идти к двери
		{
			if(nextanimation == 13) nextanimation = -13;

			if(nextanimation == 14) nextanimation = 1413;
			if(nextanimation == 15) nextanimation = 1513;
			if(nextanimation == 16) nextanimation = 1613;

		}	

		if(param == 114) // если нажали идти к туалету
		{
			if(nextanimation == 14) nextanimation = -14;

			if(nextanimation == 13) nextanimation = 1314;
			if(nextanimation == 15) nextanimation = 1514;
			if(nextanimation == 16) nextanimation = 1614;
		}	

		if(param == 115) // если нажали идти к Михалычу
		{
			if(nextanimation == 15) nextanimation = -15;

			if(nextanimation == 13) nextanimation = 1315;
			if(nextanimation == 14) nextanimation = 1415;
			if(nextanimation == 16) nextanimation = 1615;
		}

		if(param == 116) // если нажали идти к Сатанистам
		{
			if(nextanimation == 16) nextanimation = -16;

			if(nextanimation == 13) nextanimation = 1316;
			if(nextanimation == 14) nextanimation = 1416;
			if(nextanimation == 15) nextanimation = 1516;
		}
		
	}
	else
	{
		
		WriteLog("animation finished");


		if(nextanimation == -13)
		{
			scene.Delete(3);
			scene.Load("podjezd_door13_n.XML");
		}
		if(nextanimation == -14)
		{
			scene.Delete(3);
			scene.Load("kv13_tualet_n.XML");
		}
		if(nextanimation == -15)
		{
			scene.Delete(3);
			if(queststate.quest_broke_window)
			{
				scene.Load("kv13_mikh_2_n.XML");
			}
			else
			{
				scene.Load("kv13_mikh.XML");				
			}
		}
		if(nextanimation == -16)
		{
			scene.Delete(3);
			scene.Load("kv13_satan_n.XML");
		}

		if(nextanimation == 13) lastanimation = self->CreateSkeletonAnimation("kvh_an_door_idle.EZA", 1);
		if(nextanimation == 14) lastanimation = self->CreateSkeletonAnimation("kvh_an_tual_idle.EZA", 1);
		if(nextanimation == 15) lastanimation = self->CreateSkeletonAnimation("kvh_an_mikh_idle.EZA", 1);
		if(nextanimation == 16) lastanimation = self->CreateSkeletonAnimation("kvh_an_sat_idle.EZA", 1);

		if(nextanimation == 1315)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_door_mikh.EZA", 1);
			nextanimation = -15;
		}
		if(nextanimation == 1316)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_door_sat.EZA", 1);
			nextanimation = -16;
		}
		if(nextanimation == 1314)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_door_tual.EZA", 1);
			nextanimation = -14;
		}






		if(nextanimation == 1415)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_tual_mikh.EZA", 1);
			nextanimation = -15;
		}
		if(nextanimation == 1416)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_tual_sat.EZA", 1);
			nextanimation = -16;
		}
		if(nextanimation == 1413)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_tual_door.EZA", 1);
			nextanimation = -13;
		}




		if(nextanimation == 1513)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_mikh_door.EZA", 1);
			nextanimation = -13;
		}
		if(nextanimation == 1514)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_mikh_tual.EZA", 1);
			nextanimation = -14;
		}
		if(nextanimation == 1516)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_mikh_sat.EZA", 1);
			nextanimation = -16;
		}



		if(nextanimation == 1613)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_sat_door.EZA", 1);
			nextanimation = -13;
		}
		if(nextanimation == 1614)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_sat_tual.EZA", 1);
			nextanimation = -14;
		}
		if(nextanimation == 1615)
		{
			lastanimation = self->CreateSkeletonAnimation("kvh_an_sat_mikh.EZA", 1);
			nextanimation = -15;
		}








	}	
}
