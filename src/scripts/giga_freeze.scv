#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_SETFOCUS;
export ON_KILLFOCUS;


int nextanimation;
int lastanimation;


void ON_SETFOCUS()
{
	scene.SetCursorType(4);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}


void ON_CREATE()
{ 

	if(queststate.quest_freeze_giga == -1)
	{
		lastanimation = self->CreateSkeletonAnimation("gigahertz_freeze.EZA", 1);
		nextanimation = 2;
	}
	else
	{
		lastanimation = self->CreateSkeletonAnimation("gigahertz_out.EZA", 1);
		nextanimation = 1;
	}

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{
	if(param != lastanimation && param != 200)	//обозначает окончание диалога
	{
		if (nextanimation < 0) return;

		if(param == 101) // если нажали идти к выходу
		{
			if(nextanimation == 1)
			{
				//WriteLog("set power");
				nextanimation = 2;
			}
			else
			{
				//WriteLog("set idle");
				nextanimation = 1;
			}

		}
	}
	else
	{
		if(nextanimation == 2)
		{
			//WriteLog("play power");
			lastanimation = self->CreateSkeletonAnimation("gigahertz_freeze.EZA", 1);
		}
		if(nextanimation == 1)
		{
			//WriteLog("play idle");
			lastanimation = self->CreateSkeletonAnimation("gigahertz_out.EZA", 1);
		}
	}
}
