#include scener
#include queststate


export ON_CREATE; 
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_NOTIFY;
export ON_TIME;
export ON_DESTROY; 


int stepnum = 0;

STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}




void ON_TIME(int timernum)
{

	stepnum ++;
	
	if(stepnum == 1)
	{
		p_stream = CreateStream("vistrel.ogg");
		p_stream->Play(false);
		self->CreateTimer(1000, 1);
	}
	if(stepnum == 2)
	{
		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);
	
		p_obj = CreateGameObject(1,"scetch_take_gun.scv", position, size);	
			
		scene.Add(p_obj, 2);

		//антон подбирает пистолет
		queststate.item_gun = 1;
		scene.DeleteObject(self);
	}
}


void ON_NOTIFY(int param)
{
	if(param != 999)
		return;

	self->CreateSkeletonAnimation("utug_suicide.EZA", 1);		
	self->CreateTimer(10300, 1);
}
void ON_CREATE()
{
	if(queststate.item_titbit == -1)
		scene.DeleteObject(self);

}


void ON_SETFOCUS()
{

	if(queststate.item_club_card != -1 || queststate.item_titbit == 1)
		scene.SetCursorType(4);	
		
}

void ON_KILLFOCUS()
{

	if(queststate.item_club_card != -1 || queststate.item_titbit == 1)
		scene.SetCursorType(0);	
	

}

void ON_LBUTTONDOWN()
{

	if(queststate.item_club_card != -1 || queststate.item_titbit == 1)
	{
	
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 106;
		scene.PostMessage(m);
	}

}

