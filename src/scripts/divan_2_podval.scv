#include scener
#include queststate


export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

void ON_SETFOCUS()
{
	scene.SetCursorType(6);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}


void ON_LBUTTONDOWN()
{

	scene.Delete(3);//удаляем все не интерфейсные объекты
	scene.Load("sex_podval.XML");

}

void ON_CREATE()
{
//фоновая музыка
	GAME_OBJECT * p_snd;
	 
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 6100;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}

	scene.SetCursorType(0);

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 11;

}


