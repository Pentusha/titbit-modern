#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY; 



int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_lilit = NULL;
GAME_OBJECT * p_vera = NULL;


GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_guba_v = NULL;
ANILINK * p_guba_l = NULL;

ANILINK * p_antguba = NULL;

IFPlane * p_ipl;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}



void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)
	{	
		p_text->Delete();
		p_text = NULL;
	}	
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_guba_l != NULL)
	{
		p_guba_l->Delete();
		p_guba_l = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_lilit->SetBoneRotation(7, rot);
		
	}
	if( p_guba_v != NULL)
	{
		p_guba_v->Delete();
		p_guba_v = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_vera->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	step = step + 1;
	
	if(queststate.quest_pull_rope1 != 3)
	{
		if(step == 1) {	p_text = TextWindowCreate("heaven_anton_11", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_anton_11.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		}
		if(step == 2) {	p_text = TextWindowCreate("heaven_god_12", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_god_12.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		position.Assign(0.1591,-0.6762,-9.1904);
		size.Assign(-80.8124,-8.1436,-1.3125);
		camera.PlaceCamera(4, position, size);
		p_guba = p_pers->CreateSkeletonAnimation("god_rot.EZA", -1);	
		
		}
		if(step == 3) {	p_text = TextWindowCreate("heaven_vera_13", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_vera_13.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		position.Assign(2.4596,-1.0834,-5.3314);
		size.Assign(-96.6453,-15.3986,1.772);
		camera.PlaceCamera(8, position, size);
		p_guba_v = p_vera->CreateSkeletonAnimation("vera_rot.EZA", -1);	
		
		}
		if(step == 4) {	p_text = TextWindowCreate("heaven_lilit_14", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_lilit_14.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		
		position.Assign(-1.9512,-0.3649,-5.3356);
		size.Assign(-79.0891,13.7585,2.625);
		camera.PlaceCamera(8, position, size);
		p_guba_l = p_lilit->CreateSkeletonAnimation("vera_rot.EZA", -1);	
		
		}
		if(step == 5) {	p_text = TextWindowCreate("heaven_anton_15", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_anton_15.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);	
		position.Assign(0.409,-1.0452,-8.4551);
		size.Assign(-82.6475,-2.7255,-0.3515);
		camera.PlaceCamera(34.53, position, size);
		
		}
		if(step == 6) {	p_text = TextWindowCreate("heaven_god_16", "font", position,size, 29, 2);	p_stream = CreateStream("heaven_god_16.ogg");	p_stream->Play(false);	p_stream->SetSync(0, self);	self->Attach(p_text);		

		p_guba = p_pers->CreateSkeletonAnimation("god_rot.EZA", -1);	
	
		position.Assign(0.1591,-0.6762,-9.1904);
		size.Assign(-80.8124,-8.1436,-1.3125);
		camera.PlaceCamera(4, position, size);
		
		}
		if(step == 7) {	step = -1;	}					
		
	}
	else
	{
	if(step == 1) 
	{
		p_stream = CreateStream("comment_cat_10.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);	
		p_ipl->transparency = 0;

	}
	if(step == 2) 
	{	
		p_text = TextWindowCreate("heaven_god_21", "font", position,size, 29, 2);	
		p_stream = CreateStream("heaven_god_21.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);	
		self->Attach(p_text);	
		position.Assign(0.1591,-0.6762,-9.1904);
		size.Assign(-80.8124,-8.1436,-1.3125);
		camera.PlaceCamera(4, position, size);

		p_guba = p_pers->CreateSkeletonAnimation("god_rot.EZA", -1);					p_ipl->transparency = 1;


	}
		if(step == 3) {	step = -1;	

		//убираем все оставшиеся предметы из инвентаря
		queststate.item_red_paint_ballon = -1;
		queststate.item_white_rose = -1;
		queststate.item_air_ball = -1;

		scene.Delete(3);
		scene.Load("lab01.XML");	
	}					
		
		
	}
	
	if(step == -1)
	{
		scene.DeleteObject(self); 
		
		//фоновая музыка
		GAME_OBJECT * p_snd;
		
		p_snd = scene.FindObjectByName("sound_back");	
		
		if(p_snd != NULL)
		{
			message m;	
			m.message_id = EM_NOTIFY;
			m.lparam = 100;
			m.p_target = p_snd;
			scene.PostMessage(m);
		}
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		position.Assign(0.409,-1.0452,-8.4551);
		size.Assign(-82.6475,-2.7255,-0.3515);
		camera.PlaceCamera(34.53, position, size);
		
		
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	//фоновая музыка
	GAME_OBJECT * p_snd;
	
	p_snd = scene.FindObjectByName("sound_back");	
	
	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 25;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}
	
	
	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	p_ipl = p_obj;
	
	p_obj = scene.FindObjectByName("god");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	p_vera = scene.FindObjectByName("vera");

	
	p_lilit = scene.FindObjectByName("lilit");

	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	

	
	StepDialog();	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}


