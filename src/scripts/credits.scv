#include scener

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
 

IFPlane * p_pl;

void ON_CREATE()
{


	LINK * lnk;
	lnk = self;
	p_pl = lnk->GetChild();
	p_pl->transparency = 0;

}



void ON_SETFOCUS()
{
	
	p_pl->transparency = 1;
}

void ON_KILLFOCUS()
{
	p_pl->transparency = 0;

}


void ON_LBUTTONDOWN()
{
	vec3_t position, size, uvposition, uvsize;
	GAME_OBJECT * p_obj;

	position.Assign(0,0,-304);
	size.Assign(1024,768,0);
	uvposition.Assign(0.613,0.85,0);
	uvsize.Assign(0.382,-0.354,0);
	p_obj = CreateGameObject(1, "titry.scv", position, size);
	scene.Add(p_obj, 2);

}

