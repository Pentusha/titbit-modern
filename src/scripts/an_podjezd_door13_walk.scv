#include scener
#include queststate

export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY; 


int nextanimation;
int lastanimation;


STREAM * p_stream = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void ON_CREATE()
{ 

	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 9040;
		m.p_target = p_snd;
		scene.PostMessage(m);
	}


	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 7;

	if(queststate.quest_get_wear)
		self->CreateSkeletonAnimation("p_kv13_a_idle.EZA", -1);	
	else
		self->CreateSkeletonAnimation("p_kv13_an_idle.EZA", -1);

	scene.SetCursorType(0);
}

void ON_NOTIFY(int param)
{

	GAME_OBJECT * p_item = NULL;


	//отрезаем у крысы хвост
	if(queststate.typepr == 16 && param == 102)
	{
		//отрезаем у крысы хвост
		queststate.item_rat_tail = 1;
		
		p_item = scene.FindObjectByName("podezd_krisa");	
		scene.DeleteObject(p_item);
	
		//показываем скетч
	
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_rats_tail.scv", position, size);	
		scene.Add(p_obj, 2);

		//грибы уже взяты
		if(queststate.item_nuclear_mushrooms != 0)
			queststate.item_serp = -1;

		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
			p_stream = CreateStream("comment_cat_3.ogg");
			p_stream->Play(false);

		scene.SetCursorType(0);
		queststate.typepr = 0;

		return;
	}	

	//попытались использовать предмет 	
	if(queststate.typepr != 0)
	{
		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
		p_stream = CreateStream("comment_anton_2.ogg");
		p_stream->Play(false);
		return;
	}

	switch(param)
	{
	case 101:
		//нажали на постер
	
		if(queststate.quest_get_wear)
		{
			//берем постер
			queststate.item_indian_poster = 1;
			p_item = scene.FindObjectByName("podezd_poster");	
			scene.DeleteObject(p_item);
		
			p_stream = CreateStream("comment_cat_4.ogg");
			p_stream->Play(false);	
			//показываем скетч

			vec3_t position, size;	
			GAME_OBJECT * p_obj;
	
			queststate.typepr = 0;
			position.Assign(0, 0, -80);	
			size.Assign(1024,768,0);

			p_obj = CreateGameObject(1,"scetch_poster.scv", position, size);	
			scene.Add(p_obj, 2);

		}
		else
		{
			if(p_stream != NULL)
			{
				p_stream->Stop(); 	
				DeleteStream(p_stream);
				p_stream = NULL;
			}
			p_stream = CreateStream("comment_anton_2.ogg");
			p_stream->Play(false);	
		}
		
		break;
	case 102:
		//крыса
		if(p_stream != NULL)
		{
			p_stream->Stop(); 	
			DeleteStream(p_stream);
			p_stream = NULL;
		}
		p_stream = CreateStream("comment_anton_12.ogg");
		p_stream->Play(false);
		break;
		
	case 103:
		//в подъезд 

		scene.Delete(3);//удаляем все не интерфейсные объекты
		if(queststate.quest_get_wear)
			scene.Load("podjezd.XML");
		else
			scene.Load("podjezd_n.XML");
		break;
	case 104:
		//в квартиру

		scene.Delete(3);//удаляем все не интерфейсные объекты
		if(queststate.quest_get_wear)
			scene.Load("kv13_vhod.XML");
		else
			scene.Load("kv13_vhod_n.XML");
		
		break;
			
	}

}
