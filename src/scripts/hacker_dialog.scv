#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;

int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;

void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
		p_text->Delete();
	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;
		vec3_t rot;
		rot.Assign(-90,-90,-1);
		p_pers->SetBoneRotation(7, rot);
		
	}
	if( p_antguba != NULL)
	{
		p_antguba->Delete();
		p_antguba = NULL;
		
	}
	
	
	step = step + 1;

	if(queststate.quest_talk_magic == 10 )
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("icafe_hacker_61", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_hacker_61.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("hacker_rot.EZA", -1);	
		}
		if(step == 2) 
		{
			step = -1; 
			queststate.quest_talk_magic = 1;
		}					

	} 
	else if(queststate.quest_bring_erotic_fotos != 2)//не знакомы
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("icafe_hacker_31", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_hacker_31.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
			p_guba = p_pers->CreateSkeletonAnimation("hacker_rot.EZA", -1);

		}
		if(step == 2) {	step = -1;	}					
		
	}
	else if(queststate.quest_bring_erotic_fotos == 2 && queststate.item_porno_disk == 0)//принесли эротические фото админу и он познакомил с хакером
	{
		if(step == 1) 
		{
			p_text = TextWindowCreate("icafe_hacker_41", "font", position,size, 29, 2);
			p_stream = CreateStream("icafe_hacker_41.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("hacker_rot.EZA", -1);

		}
		if(step == 2) 
		{
			p_text = TextWindowCreate("icafe_anton_42", "font", position,size, 29, 2);
			p_stream = CreateStream("icafe_anton_42.ogg");
			p_stream->Play(false);	
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
		}
		if(step == 3) 
		{
			p_text = TextWindowCreate("icafe_hacker_43", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_hacker_43.ogg");	p_stream->Play(false);	
			p_stream->SetSync(0, self);	self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("hacker_rot.EZA", -1);

		}
		if(step == 4)
		{
			p_text = TextWindowCreate("icafe_anton_44", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_anton_44.ogg");
			p_stream->Play(false);
			p_stream->SetSync(0, self);
			self->Attach(p_text);	
		}
		if(step == 5) 
		{
			p_text = TextWindowCreate("icafe_hacker_45", "font", position,size, 29, 2);
			p_stream = CreateStream("icafe_hacker_45.ogg");	
			p_stream->Play(false);	
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
			p_guba = p_pers->CreateSkeletonAnimation("hacker_rot.EZA", -1);

		}
		if(step == 6) {	step = -1; queststate.item_porno_disk = 1;}					
		
	}
	else if(queststate.item_porno_disk == -1 && queststate.item_compromat_fotos == 0)	//отдали диск с порнографией янусу
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("icafe_hacker_51", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_hacker_51.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);		}
		if(step == 2) 
		{
			p_text = TextWindowCreate("icafe_anton_52", "font", position,size, 29, 2);
			p_stream = CreateStream("icafe_anton_52.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);
		}
		if(step == 3) 
		{
			step = -1; queststate.item_compromat_fotos = 1;	
		}							
	}
	else
	{
		if(step == 1) 
		{	
			p_text = TextWindowCreate("icafe_hacker_51", "font", position,size, 29, 2);	
			p_stream = CreateStream("icafe_hacker_51.ogg");	
			p_stream->Play(false);
			p_stream->SetSync(0, self);	
			self->Attach(p_text);	
		}
		if(step == 2)
		{
			step = -1;
		}
	}
	
	
	if(step == -1)
	{
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 60;
		m.p_target = p_snd;
		scene.PostMessage(m);
	
	}
		scene.DeleteObject(self); 
		
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 200;
		scene.PostMessage(m);
		
		
		position.Assign(5.2054,-0.8018,-3.6637);
		size.Assign(-66.9944,-31.6875,-12.573);
		camera.PlaceCamera(34.1, position, size);
		
		
		LINK * p_link = p_pers;
		ANILINK* p_ani = p_link->GetAniLink();
		if(p_ani != NULL)
			p_ani->Delete();
		p_pers->CreateSkeletonAnimation("hacker_idle.EZA", -1);
		
	}					
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	//фоновая музыка
	GAME_OBJECT * p_snd;
 
	p_snd = scene.FindObjectByName("sound_back");	

	if(p_snd != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 15;
		m.p_target = p_snd;
		scene.PostMessage(m);
	
	}


	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("hacker");
	p_pers = p_obj;
	ANILINK* p_ani = p_obj->GetAniLink();
	
	
	if(p_ani != NULL)
		p_ani->Delete();
	p_pers->CreateSkeletonAnimation("hacker_talk.EZA", -1);	
	
	
	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);
	
	
	
	position.Assign(5.2054,-0.8018,-3.6637);
	size.Assign(-66.9944,-31.6875,-12.573);
	camera.PlaceCamera(21.6, position, size);
		
	StepDialog();	

	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

