#include scener
#include queststate

export ON_LBUTTONDOWN;
export ON_CREATE;
export ON_NOTIFY;
export ON_DESTROY;


int step = 0;
LINK * p_text = NULL;
STREAM * p_stream = NULL;
GAME_OBJECT * p_pers = NULL;
GAME_OBJECT * p_anton = NULL;
ANILINK * p_guba = NULL;
ANILINK * p_antguba = NULL;


void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}

void StepDialog()
{
	vec3_t position, size;
	
	if(step == -1)
		return;
	
	position.Assign(0, 0, 90);
	size.Assign(1024, 120, 0);
	
	
	if(p_text != NULL)	
	{
		p_text->Delete();
		p_text = NULL;

	}	
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}
	
	if( p_guba != NULL)
	{
		p_guba->Delete();
		p_guba = NULL;

		vec3_t rot;
		rot.Assign(-4,-90,-85.7);
		p_pers->SetBoneRotation(7, rot);
		
	}

	step = step + 1;


	if(step == 1) 
	{


		p_text = TextWindowCreate("flat13satan_anton_31", "font", position,size, 29, 2);	
		p_stream = CreateStream("flat13satan_anton_31.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);	
		self->Attach(p_text);	


		position.Assign(1.942817,-1.16859,-1.796198);
		size.Assign(-90.2229,3.1581,-0.0124);
		camera.PlaceCamera(41.2, position, size);	
	}						
	if(step == 2) 
	{	

		
		p_text = TextWindowCreate("flat13satan_dostoevski_32", "font", position,size, 29, 2);	
		p_stream = CreateStream("flat13satan_dostoevski_32.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);		
		self->Attach(p_text);	

		position.Assign(2.34,-1.1706,0.6632);
		size.Assign(-94.0596,11.8791,-0.8371);
		camera.PlaceCamera(41.2, position, size);	
	}
	if(step == 3) 
	{
		p_stream = CreateStream("flat13satan_dostoevski_hahaha.ogg");	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);	

//		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_get_topor.scv", position, size);	
		scene.Add(p_obj, 2);

	
	}
	if(step == 4) {	step = -1;	}					
	
	if(step == -1)
	{
		scene.DeleteObject(self); 
		scene.Delete(3);
		scene.Load("kv13_vhod.XML");
		//нету сони :(
		queststate.quest_talk_dost_axe = 2;
		//есть топор
		queststate.item_axe = 1;

			
	}					
	
	
	
	
}

void ON_NOTIFY(int param)
{
	StepDialog();
}

void ON_CREATE()
{
	vec3_t position, size, uvposition, uvsize;	
	LINK * p_obj;				
	
	position.Assign(0,0,-1);
	size.Assign(1024,168,0);
	uvposition.Assign(0.52,0.24,0);
	uvsize.Assign(0.0375,-0.05,0);
	
	
	p_obj = scene.FindObjectByName("dostoevsky");
	p_pers = p_obj;
//	ANILINK* p_ani = p_obj->GetAniLink();
//	if(p_ani != NULL)
//		p_ani->Delete();
	

	p_obj = scene.FindObjectByName("anton");
	p_anton = p_obj;
	
	p_obj = CreateIFPlane(position, size, uvposition, uvsize, "items.tga", 1);
	self->Attach(p_obj);

	
	StepDialog();	
	
		
	
	
	
}


void ON_LBUTTONDOWN()
{
	StepDialog();		
}

