void ON_TIME(int timernum)
{	
	vec3_t position, size;
	scene.DeleteObject(self);

	message m;
	m.p_target = scene.FindObjectByName("danya_dialog");
	m.message_id = EM_NOTIFY;
	m.lparam = 0;
	scene.PostMessage(m);


}