#include scener
#include queststate

export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_DESTROY;
export ON_CREATE;
export ON_TIME;

STREAM * p_stream = NULL;
void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}
void ON_SETFOCUS()
{
	scene.SetCursorType(2);
}

void ON_KILLFOCUS()
{
	scene.SetCursorType(0);
}

void ON_CREATE()
{

		GAME_OBJECT * p_obj;
		LINK * p_avi;
			
		vec3_t position, size, uvpos, uvsize;	
		
	
		p_obj = scene.FindObjectByName("PlaneVideo");
		position.Assign(-2.6, 2.6, 0);
		size.Assign(4.40, -3.30, 0);
		uvpos.Assign(0, 1, 0);
		uvsize.Assign(1, -1, 0);
	
		p_avi = CreateAVIPlane(position, size, uvpos, uvsize, true, "acid.avi");
		p_obj->Attach(p_avi);
	
	self->CreateTimer(24880, -1);

	
}

