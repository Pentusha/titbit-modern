#include scener
#include queststate


export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;
export ON_DESTROY;



STREAM * p_stream = NULL;

void ON_CREATE()
{
		scene.SetCursorType(0);
		queststate.typepr = 0;

	if(queststate.quest_escape_from_durdom != 0)
		scene.DeleteObject(self);
	
}



void ON_DESTROY()
{
	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}

}


void ON_SETFOCUS()
{
	scene.SetCursorType(1);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{
	//если в руке ведро и был разговор с михалычем о бачке - выливаем ведро на инопланетянина
	if(queststate.typepr == 22 && queststate.quest_wake_alien == 1)
	{

	
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_alien_wc.scv", position, size);
		
		scene.Add(p_obj, 2);

	
	}
	else	
	{
		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;
		m.lparam = 1;
		scene.PostMessage(m); 

	}

	
	
}
