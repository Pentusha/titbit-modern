#include scener
#include queststate


export ON_CREATE;
export ON_DESTROY;
export ON_TIME;
export ON_NOTIFY;
export ON_LBUTTONDOWN;


LINK * p_avi;


STREAM * p_stream = NULL;
int step;


void ON_NOTIFY(int param)
{
	if(param == 101)
	{
		vec3_t uvpos, uvsize, position, size;
	
		position.Assign(0, 0, 200);
		size.Assign(1024, 768, 0);
		uvpos.Assign(0, 1, 0);
		uvsize.Assign(1, -1, 0);
	
		p_avi = CreateAVIPlane(position, size, uvpos, uvsize, false, "intro2.avi");
		self->Attach(p_avi);	
	
		p_stream->Play(false);	
		p_stream->SetSync(0, self);
	}
	else
	{
		scene.DeleteObject(self);
	}	

}

void ON_TIME(int timernum)
{

	GAME_OBJECT * p_obj;
 
	scene.DeleteObject(self);
}



void ON_DESTROY()
{

	if(p_stream != NULL)
	{
		p_stream->Stop(); 	
		DeleteStream(p_stream);
		p_stream = NULL;
	}


	WriteLog("Destroyed");
//	UnFreezeSounds();
	
	queststate.activelocation = 9;	
	scene.Load("sumerki_entrance.XML");
	
}

void ON_CREATE()
{
	

//	FreezeSounds();
	GameSpeed(1);


	queststate.activelocation = 0;	
	message m;	
	m.message_id = EM_NOTIFY;
	m.lparam = 101;
	m.p_target = self;
	scene.PostMessage(m);
	p_stream = CreateStream("intro2.ogg");	





}
void ON_LBUTTONDOWN()
{
	scene.DeleteObject(self);

}


