#include scener
#include queststate

export ON_CREATE;
export ON_SETFOCUS;
export ON_KILLFOCUS;
export ON_LBUTTONDOWN;

STREAM * p_stream = NULL;
int mush = 1;

void ON_CREATE()
{

	if(queststate.item_rag_and_gutaline != 0)
		scene.DeleteObject(self);
	
}


void ON_SETFOCUS()
{
	scene.SetCursorType(3);
	
}

void ON_KILLFOCUS()
{

	scene.SetCursorType(0);

}

void ON_LBUTTONDOWN()
{

	if(queststate.quest_get_wear)
	{
		//берем тр€пку и гуталин
		queststate.item_rag_and_gutaline = 1;	
		scene.DeleteObject(self);
	
		//показываем скетч
		vec3_t position, size;	
		GAME_OBJECT * p_obj;
	
		queststate.typepr = 0;
		position.Assign(0, 0, -80);	
		size.Assign(1024,768,0);

		p_obj = CreateGameObject(1,"scetch_gutalin.scv", position, size);	
		scene.Add(p_obj, 2);

		scene.SetCursorType(0);
		queststate.typepr = 0;
	}
	else
	{

		GAME_OBJECT * p_anton;
		p_anton = scene.FindObjectByName("anton");
		message m;
		m.p_target = p_anton;
		m.message_id = EM_NOTIFY;	
		m.lparam = 4;
		scene.PostMessage(m); 



	}
}
