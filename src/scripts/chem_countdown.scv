void TimeToWater(int time)
{
	vec3_t pos, pos2;

	pos.Assign(430.9846, -7.8575, 100.2190);
	pos2.Assign(430.9846, 100, 100.2190);

	if(time == 2)
		p_h2o2->SetBonePosition(0, pos);
	else
		p_h2o2->SetBonePosition(0, pos2);	
	
	if(time == 3)
	p_h2o3->SetBonePosition(0, pos);
	else
	p_h2o3->SetBonePosition(0, pos2);	

	if(time == 4)
	p_h2o4->SetBonePosition(0, pos);
	else
	p_h2o4->SetBonePosition(0, pos2);	

	if(time == 5)
	p_h2o5->SetBonePosition(0, pos);
	else
	p_h2o5->SetBonePosition(0, pos2);	

	if(time == 5)
	p_h2o5->SetBonePosition(0, pos);
	else
	p_h2o5->SetBonePosition(0, pos2);	

	if(time == 6)
	p_h2o6->SetBonePosition(0, pos);
	else
	p_h2o6->SetBonePosition(0, pos2);	

	if(time == 7)
	p_h2o7->SetBonePosition(0, pos);
	else
	p_h2o7->SetBonePosition(0, pos2);	

	if(time == 8)
	p_h2o8->SetBonePosition(0, pos);
	else
	p_h2o8->SetBonePosition(0, pos2);	

	if(time == 9)
	p_h2o9->SetBonePosition(0, pos);
	else
	p_h2o9->SetBonePosition(0, pos2);	

	if(time == 10)
	p_h2o10->SetBonePosition(0, pos);
	else
	p_h2o10->SetBonePosition(0, pos2);	

	if(time == 11)
	p_h2o11->SetBonePosition(0, pos);
	else
	p_h2o11->SetBonePosition(0, pos2);	

}


void TimeToPlanes(int time)
{
	int digit;
 
	digit = time%10;
	time = time /10;
	p_pl4->uvorigin.Assign(0.0093 + 0.0234375*digit, 0.992, 0);

	digit = time%10;
	time = time /10;
	p_pl3->uvorigin.Assign(0.0093 + 0.0234375*digit, 0.992, 0);

	digit = time%10;
	time = time /10;
	p_pl2->uvorigin.Assign(0.0093 + 0.0234375*digit, 0.992, 0);

	digit = time%10;
	p_pl1->uvorigin.Assign(0.0093 + 0.0234375*digit, 0.992, 0);

}

void ON_CREATE()
{

	//фоновая музыка
	GAME_OBJECT * p_obj;
 
	p_obj = scene.FindObjectByName("sound_back");	

	if(p_obj != NULL)
	{
		message m;	
		m.message_id = EM_NOTIFY;
		m.lparam = 18060;
		m.p_target = p_obj;
		scene.PostMessage(m);
	}


	vec3_t position, size, uvposition, uvsize;	
	LINK * p_link;				

	queststate.lastlocation = queststate.activelocation;
	queststate.activelocation = 43;


	queststate.typepr = 59;

	position.Assign(-12, -1, 100);
	size.Assign(18, -27, 0);
	uvposition.Assign(0.0093, 0.992, 0);
	uvsize.Assign(0.016,-0.027,0);

//создаем 4 плашки с цифрами

	p_obj = scene.FindObjectByName("chemodan_time_01");

	
	p_link = CreateIFPlane(position, size, uvposition, uvsize, "chemodan_cc.tga");
	p_obj->Attach(p_link);
	p_pl1 = p_link;

	position.Assign(12, -1, 100);
	
	p_link = CreateIFPlane(position, size, uvposition, uvsize, "chemodan_cc.tga");
	p_obj->Attach(p_link);
	p_pl2 = p_link;

	position.Assign(34, -1, 100);

	p_link = CreateIFPlane(position, size, uvposition, uvsize, "chemodan_cc.tga");
	p_obj->Attach(p_link);
	p_pl3 = p_link;

	position.Assign(56, -1, 100);

	p_link = CreateIFPlane(position, size, uvposition, uvsize, "chemodan_cc.tga");
	p_obj->Attach(p_link);
	p_pl4 = p_link;

//	TimeToPlanes(999);

	self->CreateTimer(100,-1);

	p_h2o2 = scene.FindObjectByName("chemodan_H2O_02");
	p_h2o3 = scene.FindObjectByName("chemodan_H2O_03");
	p_h2o4 = scene.FindObjectByName("chemodan_H2O_04");
	p_h2o5 = scene.FindObjectByName("chemodan_H2O_05");
	p_h2o6 = scene.FindObjectByName("chemodan_H2O_06");
	p_h2o7 = scene.FindObjectByName("chemodan_H2O_07");
	p_h2o8 = scene.FindObjectByName("chemodan_H2O_08");
	p_h2o9 = scene.FindObjectByName("chemodan_H2O_09");
	p_h2o10 = scene.FindObjectByName("chemodan_H2O_10");
	p_h2o11 = scene.FindObjectByName("chemodan_H2O_11");



	queststate.item_dance_video = -2;

}



void ON_NOTIFY(int param)
{

}

void ON_TIME(int timernum)
{

	int wn;
	ftime -=7;	
	wn = 11 - ftime / 382;

	TimeToPlanes(ftime);
	TimeToWater(wn);

	if(ftime < 0)
	{

		queststate.typepr = 0;
		scene.SetCursorType(0);
		scene.Delete(3);
		scene.Load("gameboom.xml");
	}

}


